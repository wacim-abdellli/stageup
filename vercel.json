{
  "version": 2,
  "env": {
    "VERCEL": "1",
    "RAILS_ENV": "production",
    "RAILS_LOG_TO_STDOUT": "1"
  },
  "builds": [
    {
      "src": "config.ru",
      "use": "@vercel/ruby"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/favicon\\.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/icon\\.png",
      "dest": "/public/icon.png"
    },
    {
      "src": "/(.*)",
      "dest": "config.ru"
    }
  ]
}
