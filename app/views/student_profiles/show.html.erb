<% content_for :title, "#{@student_profile.first_name} #{@student_profile.last_name} #{t('student_profiles.show.title_suffix', default: '– Candidate Profile')}" %>

<div class="dashboard-container profile-page-container">

  <%# ─── Top Navigation Bar ───────────────────────────────────────── %>
  <div class="flex-between flex-wrap gap-12 mb-20">
    <%= link_to dashboard_path, class: "btn-back-settings" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <%= t('common.back_to', page: t('dashboard.title', default: 'Dashboard'), default: 'Back to Dashboard') %>
    <% end %>
    <% if current_user.profileable == @student_profile %>
      <%= link_to edit_user_registration_path, class: "btn btn-secondary btn-compact" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        <%= t('dashboard.profile.edit', default: 'Edit Settings') %>
      <% end %>
    <% end %>
  </div>

  <%# ─── Hero Candidate Header Card (Clean & Minimalist) ──────────── %>
  <div class="profile-hero-card mb-24 p-24">
    <div class="flex-between flex-wrap gap-20">
      <div class="flex-align-center gap-20 flex-wrap">
        <div class="hero-avatar-circle flex-shrink-0">
          <span><%= @student_profile.first_name.first.upcase rescue 'S' %></span>
        </div>

        <div>
          <div class="flex-align-center gap-10 flex-wrap mb-6">
            <h1 class="hero-candidate-name margin-0"><%= @student_profile.first_name %> <%= @student_profile.last_name %></h1>
            <span class="badge badge-success fs-11 flex-align-center gap-4">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              <span>Verified Candidate</span>
            </span>
          </div>

          <div class="hero-clean-meta flex-align-center gap-8 flex-wrap fs-13 text-secondary">
            <% if @student_profile.university %>
              <span class="color-primary fw-600"><%= @student_profile.university.name %></span>
              <span>&middot;</span>
            <% end %>

            <span><%= @student_profile.major.presence || t('student_profiles.show.major_fallback', default: 'Engineering Candidate') %></span>

            <% if @student_profile.graduation_year %>
              <span>&middot;</span>
              <span><%= t('student_profiles.show.class_of', year: @student_profile.graduation_year, default: "Class of #{@student_profile.graduation_year}") %></span>
            <% end %>

            <% if @student_profile.phone.present? %>
              <span>&middot;</span>
              <span><%= @student_profile.phone %></span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex-align-center gap-12">
        <% if @student_profile.cv.attached? %>
          <%= link_to rails_blob_path(@student_profile.cv, disposition: "inline"), target: "_blank", class: "btn btn-primary btn-compact" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span><%= t('dashboard.profile_bento.view_cv', default: 'View Resume (PDF)') %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="dashboard-grid">

    <%# ─── Left Main Column ───────────────────────────────────────── %>
    <div class="left-col">

      <%# About & Bio Section %>
      <div class="profile-card mb-20">
        <div class="profile-card-header flex-between mb-12">
          <h3 class="section-heading margin-0 flex-align-center gap-8">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span><%= t('dashboard.profile_bento.bio', default: 'About Candidate') %></span>
          </h3>
        </div>
        <div class="candidate-bio-box">
          <p class="color-secondary fs-14 line-height-16 margin-0">
            <%= @student_profile.bio.presence || t('dashboard.profile_bento.bio_empty', default: 'No bio summary provided yet.') %>
          </p>
        </div>
      </div>

      <%# Skills & Technical Stack %>
      <div class="profile-card mb-20">
        <div class="profile-card-header flex-between mb-14">
          <h3 class="section-heading margin-0 flex-align-center gap-8">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span><%= t('dashboard.profile_bento.skills', default: 'Verified Skills & Technical Stack') %></span>
          </h3>
          <% if @student_profile.skills.any? %>
            <span class="badge badge-info fs-11"><%= @student_profile.skills.count %> Technologies</span>
          <% end %>
        </div>
        <% if @student_profile.skills.any? %>
          <div class="skills-flex-wrap">
            <% @student_profile.skills.each do |skill| %>
              <div class="public-skill-badge">
                <span class="skill-dot"></span>
                <span><%= skill.name %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.profile_bento.skills_none', default: 'No technical skills listed yet.') %></p>
        <% end %>
      </div>

      <%# Completed Missions & Work Experience %>
      <div class="profile-card">
        <div class="profile-card-header flex-between mb-14">
          <h3 class="section-heading margin-0 flex-align-center gap-8">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span><%= t('dashboard.active_internships.title', default: 'Completed Missions & Work Experience') %></span>
          </h3>
          <% if @completed_submissions.any? %>
            <span class="badge badge-success fs-11"><%= @completed_submissions.count %> Verified</span>
          <% end %>
        </div>
        <% if @completed_submissions.any? %>
          <div class="inline-list">
            <% @completed_submissions.each do |sub| %>
              <div class="internship-item flex-between flex-wrap gap-12">
                <div class="flex-align-center gap-12">
                  <div class="company-avatar-box">
                    <span><%= sub.offer.company_profile.name.first.upcase rescue 'C' %></span>
                  </div>
                  <div>
                    <strong class="internship-item-title block color-primary fs-14"><%= sub.offer.title %></strong>
                    <div class="fs-12 text-muted mt-2 flex-align-center gap-6">
                      <span><%= sub.offer.company_profile.name %></span>
                      <span>&middot;</span>
                      <span><%= t('student_profiles.show.completed_prefix', default: 'Completed') %> <%= sub.updated_at.strftime("%b %Y") %></span>
                    </div>
                  </div>
                </div>
                <span class="badge badge-success fs-11 flex-align-center gap-4">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <%= sub.status.humanize %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.active_internships.no_active_title', default: 'No completed proof-of-work missions recorded yet.') %></p>
        <% end %>
      </div>

    </div>

    <%# ─── Right Column: Reputation Score & Ledger ───────────────── %>
    <div class="right-col">

      <%# Verified Reputation Score Card (Clean Minimal Gauge) %>
      <div class="profile-card rep-metrics-card mb-20 p-20">
        <div class="rep-metrics-header flex-between mb-14">
          <h3 class="rep-metrics-title margin-0 fs-15"><%= t('dashboard.reputation.title', default: 'Commitment Score') %></h3>
          <span class="badge badge-success fs-11">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <%= t('student_profiles.show.verified_ledger_badge', default: 'Verified Ledger') %>
          </span>
        </div>

        <div class="rep-score-row mb-12 flex-align-center gap-12">
          <% score = @student_profile.commitment_score.round(0) rescue 100 %>
          <div class="rep-score-number <%= score >= 90 ? 'score-color-high' : (score >= 70 ? 'score-color-mid' : 'score-color-low') %> fs-36 fw-900">
            <%= score %>
          </div>
          <div>
            <span class="fs-12 text-muted block">/ 100 points</span>
            <span class="fs-12 text-secondary fw-600"><%= t('dashboard.reputation.score_label', default: 'Public Rating') %></span>
          </div>
        </div>

        <div class="rep-score-bar-bg mb-14">
          <div class="rep-score-bar-fill <%= score >= 90 ? 'fill-emerald' : (score >= 70 ? 'fill-amber' : 'fill-rose') %>" style="width: <%= score %>%;"></div>
        </div>

        <div class="rep-divider mb-12"></div>

        <div class="rep-rating-row flex-between fs-13">
          <span class="text-secondary"><%= t('dashboard.reputation.avg_rating', default: 'Employer Rating') %></span>
          <strong class="color-primary">
            <%= @avg_rating ? "#{@avg_rating} / 5.0 ⭐" : t('common.unrated', default: 'Unrated (5.0 default)') %>
          </strong>
        </div>
      </div>

      <%# Verified Reputation Ledger Events %>
      <div class="profile-card p-20">
        <div class="flex-between flex-wrap gap-12 mb-16 pb-10 border-bottom-subtle">
          <h3 class="fs-14 fw-700 color-primary margin-0 flex-align-center gap-8">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span><%= t('student_profiles.show.reputation_history_title', default: 'Reputation Event History') %></span>
          </h3>
          <% if @commitment_events.any? %>
            <span class="badge badge-info fs-11"><%= @commitment_events.count %> Events</span>
          <% end %>
        </div>

        <% if @commitment_events.any? %>
          <div class="ledger-timeline">
            <% @commitment_events.each do |event| %>
              <div class="ledger-event">
                <div class="ledger-event-line"></div>
                <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                <div class="ledger-event-body">
                  <div class="ledger-event-header flex-between flex-wrap gap-8 mb-2">
                    <strong class="fs-13 fw-600 color-primary"><%= event.event_type.to_s.humanize.titleize %></strong>
                    <span class="ledger-event-delta <%= event.score_delta > 0 ? 'delta-positive' : 'delta-negative' %> fs-12">
                      <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %> <%= t('home.pts', default: 'pts') %>
                    </span>
                  </div>
                  <p class="ledger-event-desc fs-12 text-secondary margin-0 mb-4"><%= event.description %></p>
                  <span class="ledger-event-time flex-align-center gap-4 text-muted fs-11">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <%= time_ago_in_words(event.created_at) %> <%= t('common.ago', default: 'ago') %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-12 italic margin-0"><%= t('student_profiles.show.no_ledger_history', default: 'No recorded reputation events yet.') %></p>
        <% end %>
      </div>

    </div>

  </div>

</div>
