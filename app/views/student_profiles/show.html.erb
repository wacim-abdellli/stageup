<% content_for :title, "#{@student_profile.first_name} #{@student_profile.last_name} – Candidate Profile" %>

<div class="dashboard-container p-vertical-30">

  <%# ─── Hero Profile Header Card ───────────────────────────────────── %>
  <div class="profile-card mb-24">
    <div class="flex-between flex-wrap gap-16">
      <div class="flex-align-center gap-16">
        <div class="hero-avatar-circle">
          <%= @student_profile.first_name.first.upcase rescue 'S' %>
        </div>
        <div>
          <div class="flex-align-center gap-8 mb-4">
            <h1 class="fs-22 fw-700 margin-0"><%= @student_profile.first_name %> <%= @student_profile.last_name %></h1>
            <% if @student_profile.university %>
              <span class="badge badge-info"><%= @student_profile.university.name %></span>
            <% end %>
          </div>
          <p class="color-secondary fs-13 margin-0">
            <%= @student_profile.major.presence || t('dashboard.profile_bento.major_not_specified', default: 'Software Engineering') %>
            <% if @student_profile.graduation_year %>
              &middot; Class of <%= @student_profile.graduation_year %>
            <% end %>
            <% if @student_profile.phone.present? %>
              &middot; <span class="text-muted"><%= @student_profile.phone %></span>
            <% end %>
          </p>
        </div>
      </div>

      <div class="flex-align-center gap-12">
        <% if @student_profile.cv.attached? %>
          <%= link_to rails_blob_path(@student_profile.cv, disposition: "inline"), target: "_blank", class: "btn btn-secondary" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
            <%= t('dashboard.profile_bento.view_cv', default: 'View Resume (PDF)') %>
          <% end %>
        <% end %>
        <% if current_user.profileable == @student_profile %>
          <%= link_to edit_user_registration_path, class: "btn btn-primary" do %>
            <%= t('dashboard.profile.edit', default: 'Edit My Profile') %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="dashboard-grid">

    <%# ─── Left Main Column ───────────────────────────────────────── %>
    <div class="left-col">

      <%# About & Bio Section %>
      <div class="profile-card mb-24">
        <h3 class="section-heading mb-12">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <%= t('dashboard.profile_bento.bio', default: 'About Candidate') %>
        </h3>
        <p class="color-secondary fs-14 line-height-16 margin-0">
          <%= @student_profile.bio.presence || t('dashboard.profile_bento.bio_empty', default: 'No bio summary provided yet.') %>
        </p>
      </div>

      <%# Skills & Competencies %>
      <div class="profile-card mb-24">
        <h3 class="section-heading mb-12">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-6"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <%= t('dashboard.profile_bento.skills', default: 'Verified Skills & Competencies') %>
        </h3>
        <% if @student_profile.skills.any? %>
          <div class="flex-wrap gap-8">
            <% @student_profile.skills.each do |skill| %>
              <span class="bento-skill-pill"><%= skill.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.profile_bento.skills_none', default: 'No skills listed.') %></p>
        <% end %>
      </div>

      <%# Completed Internships & Achievements %>
      <div class="profile-card">
        <h3 class="section-heading mb-16">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-6"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <%= t('dashboard.active_internships.title', default: 'Completed Missions & Experience') %>
        </h3>
        <% if @completed_submissions.any? %>
          <div class="inline-list">
            <% @completed_submissions.each do |sub| %>
              <div class="internship-item">
                <div>
                  <strong class="internship-item-title"><%= sub.offer.title %></strong>
                  <div class="fs-12 text-muted mt-2">
                    <%= sub.offer.company_profile.name %> &middot; Completed <%= sub.updated_at.strftime("%b %Y") %>
                  </div>
                </div>
                <span class="badge badge-success"><%= sub.status.humanize %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.active_internships.no_active_title', default: 'No completed proof missions recorded yet.') %></p>
        <% end %>
      </div>

    </div>

    <%# ─── Right Column: Reputation Score & Reviews ───────────────── %>
    <div class="right-col">

      <%# Verified Reputation Score Card %>
      <div class="profile-card rep-metrics-card mb-24">
        <div class="rep-metrics-header">
          <h3 class="rep-metrics-title"><%= t('dashboard.reputation.title', default: 'Commitment Score') %></h3>
          <span class="badge badge-success fs-11">Verified Ledger</span>
        </div>

        <div class="rep-score-row">
          <div class="rep-score-main">
            <% score = @student_profile.commitment_score.round(0) rescue 100 %>
            <span class="rep-score-number <%= score >= 90 ? 'score-color-high' : (score >= 70 ? 'score-color-mid' : 'score-color-low') %>">
              <%= score %>
            </span>
            <span class="rep-score-label">/ 100</span>
          </div>
          <span class="rep-score-desc"><%= t('dashboard.reputation.score_label', default: 'Public Trust Score') %></span>
        </div>

        <div class="rep-divider"></div>

        <div class="rep-rating-row">
          <div class="rep-rating-left">
            <svg class="icon-14 icon-amber-fill" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span class="rep-rating-label"><%= t('dashboard.reputation.avg_rating', default: 'Employer Rating') %></span>
          </div>
          <span class="rep-rating-value">
            <%= @avg_rating ? "#{@avg_rating} / 5" : t('common.unrated', default: 'Unrated') %>
          </span>
        </div>
      </div>

      <%# Verified Reputation Ledger Events %>
      <div class="profile-card p-20 mb-24">
        <h3 class="ledger-card-title mb-12">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2" class="mr-4"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          Reputation Event History
        </h3>
        <% if @commitment_events.any? %>
          <div class="ledger-timeline">
            <% @commitment_events.each do |event| %>
              <div class="ledger-event-item">
                <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                <div class="ledger-event-body">
                  <div class="ledger-event-header">
                    <span class="ledger-event-title"><%= event.event_type.to_s.humanize %></span>
                    <span class="ledger-event-delta <%= event.score_delta > 0 ? 'delta-positive' : 'delta-negative' %>">
                      <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %>
                    </span>
                  </div>
                  <p class="ledger-event-desc"><%= event.description %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-12 italic margin-0">No ledger history recorded.</p>
        <% end %>
      </div>

    </div>

  </div>

</div>
