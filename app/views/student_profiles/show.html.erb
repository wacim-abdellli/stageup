<% content_for :title, "#{@student_profile.first_name} #{@student_profile.last_name} #{t('student_profiles.show.title_suffix', default: '– Candidate Portfolio')}" %>

<div class="dashboard-container candidate-hub-container">

  <%# ─── Top Navigation Bar ───────────────────────────────────────── %>
  <div class="flex-between flex-align-center mb-24">
    <%= link_to dashboard_path, class: "btn-back-settings" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <%= t('common.back_to', page: t('dashboard.title', default: 'Dashboard'), default: 'Back to Dashboard') %>
    <% end %>

    <% if current_user.profileable == @student_profile %>
      <%= link_to edit_user_registration_path, class: "btn btn-secondary btn-compact" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        <%= t('dashboard.profile.edit', default: 'Edit Settings') %>
      <% end %>
    <% end %>
  </div>

  <%# ─── GitHub/Linear Style Candidate Cover Header ───────────────── %>
  <div class="candidate-cover-card mb-32">
    <div class="candidate-cover-banner"></div>

    <div class="candidate-cover-body">
      <div class="flex-between flex-wrap gap-20 align-items-end">
        
        <div class="flex-align-center gap-20 flex-wrap">
          <div class="candidate-avatar-wrapper">
            <div class="candidate-avatar-circle">
              <span><%= @student_profile.first_name.first.upcase rescue 'S' %></span>
            </div>
            <span class="candidate-avatar-status" title="Active Verified Candidate"></span>
          </div>

          <div class="candidate-title-block">
            <div class="flex-align-center gap-10 flex-wrap mb-4">
              <h1 class="candidate-name margin-0"><%= @student_profile.first_name %> <%= @student_profile.last_name %></h1>
              <span class="badge-verified-candidate">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" class="mr-4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                Verified Candidate
              </span>
            </div>

            <p class="candidate-headline text-secondary margin-0 fs-14">
              <%= @student_profile.major.presence || t('student_profiles.show.major_fallback', default: 'Software & AI Engineering') %>
              <% if @student_profile.university %>
                &middot; <span class="color-primary fw-600"><%= @student_profile.university.name %></span>
              <% end %>
            </p>
          </div>
        </div>

        <div class="flex-align-center gap-12 flex-wrap">
          <% if @student_profile.cv.attached? %>
            <%= link_to rails_blob_path(@student_profile.cv, disposition: "inline"), target: "_blank", class: "btn btn-primary btn-cv-download" do %>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span><%= t('dashboard.profile_bento.view_cv', default: 'View Resume (PDF)') %></span>
            <% end %>
          <% end %>
        </div>

      </div>

      <%# Integrated Key Metrics Bar %>
      <div class="candidate-metrics-bar mt-24">
        <% score = @student_profile.commitment_score.round(0) rescue 100 %>
        <div class="candidate-metric-item">
          <span class="metric-label">Commitment Score</span>
          <div class="metric-val flex-align-center gap-6">
            <span class="metric-num <%= score >= 90 ? 'score-high' : (score >= 70 ? 'score-mid' : 'score-low') %>"><%= score %></span>
            <span class="metric-total">/ 100</span>
          </div>
        </div>

        <div class="metric-divider"></div>

        <div class="candidate-metric-item">
          <span class="metric-label">Employer Rating</span>
          <div class="metric-val flex-align-center gap-6">
            <span class="metric-num color-primary"><%= @avg_rating ? "#{@avg_rating}" : "5.0" %></span>
            <span class="fs-14 color-amber">★</span>
          </div>
        </div>

        <div class="metric-divider"></div>

        <div class="candidate-metric-item">
          <span class="metric-label">Verified Missions</span>
          <div class="metric-val flex-align-center gap-6">
            <span class="metric-num color-primary"><%= @completed_submissions.count %></span>
            <span class="fs-12 text-muted">Completed</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ─── Main Content Grid ───────────────────────────────────────── %>
  <div class="candidate-grid">

    <%# Left Main Section (70%) %>
    <div class="candidate-main-col">

      <%# Executive Bio Section %>
      <div class="candidate-section-card mb-24">
        <h3 class="candidate-section-title mb-16">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span><%= t('dashboard.profile_bento.bio', default: 'About Candidate') %></span>
        </h3>
        
        <div class="candidate-bio-text">
          <%= @student_profile.bio.presence || t('dashboard.profile_bento.bio_empty', default: 'No bio summary provided yet.') %>
        </div>
      </div>

      <%# Technical Stack & Skills Section %>
      <div class="candidate-section-card mb-24">
        <div class="flex-between flex-align-center mb-16">
          <h3 class="candidate-section-title margin-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span><%= t('dashboard.profile_bento.skills', default: 'Technical Stack & Skills') %></span>
          </h3>
          <% if @student_profile.skills.any? %>
            <span class="fs-12 text-muted fw-600"><%= @student_profile.skills.count %> Skills Verified</span>
          <% end %>
        </div>

        <% if @student_profile.skills.any? %>
          <div class="candidate-skills-wrap">
            <% @student_profile.skills.each do |skill| %>
              <div class="candidate-skill-pill">
                <span class="pill-dot"></span>
                <span><%= skill.name %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.profile_bento.skills_none', default: 'No technical skills listed yet.') %></p>
        <% end %>
      </div>

      <%# Work Experience & Completed Internships %>
      <div class="candidate-section-card">
        <h3 class="candidate-section-title mb-16">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-8"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span><%= t('dashboard.active_internships.title', default: 'Work Experience & Proof Missions') %></span>
        </h3>

        <% if @completed_submissions.any? %>
          <div class="candidate-experience-list">
            <% @completed_submissions.each do |sub| %>
              <div class="candidate-exp-item flex-between flex-wrap gap-12">
                <div class="flex-align-center gap-14">
                  <div class="exp-company-avatar">
                    <span><%= sub.offer.company_profile.name.first.upcase rescue 'C' %></span>
                  </div>
                  <div>
                    <strong class="exp-title block color-primary fs-15"><%= sub.offer.title %></strong>
                    <span class="exp-meta text-muted fs-13 block mt-2">
                      <%= sub.offer.company_profile.name %> &middot; Completed <%= sub.updated_at.strftime("%b %Y") %>
                    </span>
                  </div>
                </div>
                <span class="badge-status-verified">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" class="mr-4"><polyline points="20 6 9 17 4 12"/></svg>
                  Verified Completion
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.active_internships.no_active_title', default: 'No completed proof-of-work missions recorded yet.') %></p>
        <% end %>
      </div>

    </div>

    <%# Right Sidebar Section (30%) %>
    <div class="candidate-sidebar-col">

      <%# Academic Info Card %>
      <div class="candidate-sidebar-card mb-24">
        <h4 class="candidate-sidebar-title mb-16">Academic Details</h4>
        <div class="info-list">
          <div class="info-row flex-between py-8 border-bottom-subtle">
            <span class="info-label text-muted fs-13">University</span>
            <strong class="info-val fs-13 color-primary"><%= @student_profile.university&.name || 'Autonomous Student' %></strong>
          </div>
          <div class="info-row flex-between py-8 border-bottom-subtle">
            <span class="info-label text-muted fs-13">Major</span>
            <strong class="info-val fs-13 color-primary"><%= @student_profile.major.presence || 'Computer Science' %></strong>
          </div>
          <% if @student_profile.graduation_year %>
            <div class="info-row flex-between py-8 border-bottom-subtle">
              <span class="info-label text-muted fs-13">Class Of</span>
              <strong class="info-val fs-13 color-primary"><%= @student_profile.graduation_year %></strong>
            </div>
          <% end %>
          <% if @student_profile.phone.present? %>
            <div class="info-row flex-between py-8">
              <span class="info-label text-muted fs-13">Contact Phone</span>
              <strong class="info-val fs-13 color-primary"><%= @student_profile.phone %></strong>
            </div>
          <% end %>
        </div>
      </div>

      <%# Reputation Activity Ledger %>
      <div class="candidate-sidebar-card">
        <h4 class="candidate-sidebar-title mb-16 flex-between">
          <span>Reputation Ledger</span>
          <span class="badge badge-success fs-10">Verified</span>
        </h4>

        <% if @commitment_events.any? %>
          <div class="sidebar-ledger-list">
            <% @commitment_events.each do |event| %>
              <div class="sidebar-ledger-item pb-12 mb-12 border-bottom-subtle">
                <div class="flex-between flex-align-center mb-4">
                  <strong class="fs-13 color-primary"><%= event.event_type.to_s.humanize.titleize %></strong>
                  <span class="fs-12 fw-700 <%= event.score_delta > 0 ? 'color-emerald' : 'color-rose' %>">
                    <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %> pts
                  </span>
                </div>
                <p class="fs-12 text-muted margin-0 mb-4 line-height-14"><%= event.description %></p>
                <span class="fs-11 text-muted"><%= time_ago_in_words(event.created_at) %> ago</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-12 italic margin-0"><%= t('student_profiles.show.no_ledger_history', default: 'No reputation events recorded yet.') %></p>
        <% end %>
      </div>

    </div>

  </div>

</div>
