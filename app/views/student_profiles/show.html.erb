<% content_for :title, "#{@student_profile.first_name} #{@student_profile.last_name} – Candidate Profile" %>

<div class="dashboard-container p-vertical-30">

  <%# ─── Back Link ─────────────────────────────────────────────────── %>
  <div class="mb-16">
    <%= link_to dashboard_path, class: "btn btn-secondary btn-compact" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <%= t('common.back', default: 'Back to Dashboard') %>
    <% end %>
  </div>

  <%# ─── Hero Candidate Header Card ───────────────────────────────── %>
  <div class="profile-hero-card mb-24">
    <div class="profile-hero-inner flex-between flex-wrap gap-20">
      <div class="flex-align-center gap-20">
        <div class="hero-avatar-circle">
          <span><%= @student_profile.first_name.first.upcase rescue 'S' %></span>
        </div>

        <div>
          <div class="flex-align-center gap-10 flex-wrap mb-6">
            <h1 class="hero-candidate-name margin-0"><%= @student_profile.first_name %> <%= @student_profile.last_name %></h1>
            <% if @student_profile.university %>
              <span class="badge badge-info fs-12">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                <%= @student_profile.university.name %>
              </span>
            <% else %>
              <span class="badge badge-info fs-12">Student Candidate</span>
            <% end %>
          </div>

          <div class="hero-candidate-pills flex-align-center gap-12 flex-wrap">
            <span class="hero-meta-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <%= @student_profile.major.presence || "Software Engineering" %>
            </span>

            <% if @student_profile.graduation_year %>
              <span class="hero-meta-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                Class of <%= @student_profile.graduation_year %>
              </span>
            <% end %>

            <% if @student_profile.phone.present? %>
              <span class="hero-meta-pill">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <%= @student_profile.phone %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="flex-align-center gap-12">
        <% if @student_profile.cv.attached? %>
          <%= link_to rails_blob_path(@student_profile.cv, disposition: "inline"), target: "_blank", class: "btn btn-primary btn-resume-glow" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
            <%= t('dashboard.profile_bento.view_cv', default: 'View Resume (PDF)') %>
          <% end %>
        <% end %>
        <% if current_user.profileable == @student_profile %>
          <%= link_to edit_user_registration_path, class: "btn btn-secondary" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <%= t('dashboard.profile.edit', default: 'Edit Profile') %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="dashboard-grid">

    <%# ─── Left Main Column ───────────────────────────────────────── %>
    <div class="left-col">

      <%# About & Bio Section %>
      <div class="profile-card mb-24">
        <h3 class="section-heading mb-12">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-6"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <%= t('dashboard.profile_bento.bio', default: 'About Candidate') %>
        </h3>
        <div class="candidate-bio-box">
          <p class="color-secondary fs-14 line-height-16 margin-0">
            <%= @student_profile.bio.presence || t('dashboard.profile_bento.bio_empty', default: 'No bio summary provided yet.') %>
          </p>
        </div>
      </div>

      <%# Skills & Competencies %>
      <div class="profile-card mb-24">
        <h3 class="section-heading mb-14">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-6"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <%= t('dashboard.profile_bento.skills', default: 'Verified Skills & Technical Stack') %>
        </h3>
        <% if @student_profile.skills.any? %>
          <div class="skills-flex-wrap">
            <% @student_profile.skills.each do |skill| %>
              <div class="public-skill-badge">
                <span class="skill-dot"></span>
                <span><%= skill.name %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.profile_bento.skills_none', default: 'No skills listed.') %></p>
        <% end %>
      </div>

      <%# Completed Internships & Achievements %>
      <div class="profile-card">
        <h3 class="section-heading mb-16">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" class="mr-6"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <%= t('dashboard.active_internships.title', default: 'Completed Missions & Work Experience') %>
        </h3>
        <% if @completed_submissions.any? %>
          <div class="inline-list">
            <% @completed_submissions.each do |sub| %>
              <div class="internship-item flex-between">
                <div>
                  <strong class="internship-item-title"><%= sub.offer.title %></strong>
                  <div class="fs-12 text-muted mt-2">
                    <%= sub.offer.company_profile.name %> &middot; Completed <%= sub.updated_at.strftime("%b %Y") %>
                  </div>
                </div>
                <span class="badge badge-success"><%= sub.status.humanize %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="empty-state-card p-20 text-center">
            <p class="text-muted fs-13 italic margin-0"><%= t('dashboard.active_internships.no_active_title', default: 'No completed proof missions recorded yet.') %></p>
          </div>
        <% end %>
      </div>

    </div>

    <%# ─── Right Column: Reputation Score & Reviews ───────────────── %>
    <div class="right-col">

      <%# Verified Reputation Score Card %>
      <div class="profile-card rep-metrics-card mb-24">
        <div class="rep-metrics-header flex-between mb-16">
          <h3 class="rep-metrics-title margin-0"><%= t('dashboard.reputation.title', default: 'Commitment Score') %></h3>
          <span class="badge badge-success fs-11">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            VERIFIED LEDGER
          </span>
        </div>

        <div class="rep-score-row mb-16">
          <div class="rep-score-main">
            <% score = @student_profile.commitment_score.round(0) rescue 100 %>
            <span class="rep-score-number <%= score >= 90 ? 'score-color-high' : (score >= 70 ? 'score-color-mid' : 'score-color-low') %>">
              <%= score %>
            </span>
            <span class="rep-score-label">/ 100</span>
          </div>
          <span class="rep-score-desc"><%= t('dashboard.reputation.score_label', default: 'Public Commitment Rating') %></span>
        </div>

        <div class="rep-divider mb-16"></div>

        <div class="rep-rating-row flex-between">
          <div class="rep-rating-left flex-align-center gap-6">
            <svg class="icon-14 icon-amber-fill" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span class="rep-rating-label fs-13 text-secondary"><%= t('dashboard.reputation.avg_rating', default: 'Employer Rating') %></span>
          </div>
          <span class="rep-rating-value fs-13 fw-600 color-primary">
            <%= @avg_rating ? "#{@avg_rating} / 5 ⭐" : t('common.unrated', default: 'Unrated') %>
          </span>
        </div>
      </div>

      <%# Verified Reputation Ledger Events %>
      <div class="profile-card p-20">
        <h3 class="ledger-card-title mb-14 flex-align-center gap-6">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          Reputation Event History
        </h3>
        <% if @commitment_events.any? %>
          <div class="ledger-timeline">
            <% @commitment_events.each do |event| %>
              <div class="ledger-event-item">
                <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                <div class="ledger-event-body">
                  <div class="ledger-event-header flex-between mb-4">
                    <span class="ledger-event-title fs-12 fw-700 color-primary"><%= event.event_type.to_s.humanize.upcase %></span>
                    <span class="ledger-event-delta fs-12 fw-700 <%= event.score_delta > 0 ? 'delta-positive' : 'delta-negative' %>">
                      <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %>
                    </span>
                  </div>
                  <p class="ledger-event-desc fs-11 text-muted margin-0"><%= event.description %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted fs-12 italic margin-0">No ledger history recorded yet.</p>
        <% end %>
      </div>

    </div>

  </div>

</div>
