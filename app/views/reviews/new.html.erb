<% content_for :title, "Leave a Review – StageUp" %>
<div class="auth-container">
  <div class="auth-card auth-card-md auth-card-padded-lg">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Share Your Experience</h2>
      <p class="auth-subtitle">Leave a review for your recent internship</p>
    </div>

    <div class="info-card">
      <span class="info-label">Internship:</span>
      <strong class="info-value"><%= @submission.offer.title %></strong>
      <span class="info-label mt-10">With:</span>
      <strong class="info-value-accent">
        <%= current_user == @submission.student_profile.user ? @submission.offer.company_profile.name : "#{@submission.student_profile.first_name} #{@submission.student_profile.last_name}" %>
      </strong>
    </div>

    <%= form_with model: [@submission, @review], local: true do |f| %>
      
      <% if @review.errors.any? %>
        <div class="flash-message flash-alert flash-alert-col">
          <div class="error-header-row">
            <i data-lucide="alert-circle" class="icon-16 stroke-danger flex-shrink-0"></i>
            <strong>Please resolve the following errors:</strong>
          </div>
          <ul class="error-list">
            <% @review.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <label class="form-label">Rating</label>
        <div id="star-picker" style="display:flex;gap:4px;margin-bottom:6px;">
          <% (1..5).each do |i| %>
            <button type="button" data-v="<%= i %>" onclick="pickStar(<%= i %>)"
              style="background:none;border:none;font-size:32px;cursor:pointer;color:var(--text-muted);padding:0 2px;transition:color 0.1s;line-height:1;">★</button>
          <% end %>
        </div>
        <%= f.hidden_field :rating, id: "rv" %>
        <span id="sh" class="form-hint">Click a star to rate</span>
      </div>
      <%= javascript_tag nonce: true do %>
        var labels = ['Poor','Below Average','Average','Good','Excellent'];
        function pickStar(v) {
          document.getElementById('rv').value = v;
          document.getElementById('sh').textContent = labels[v-1] + ' (' + v + '/5)';
          document.querySelectorAll('#star-picker button').forEach(function(b,i) {
            b.style.color = i < v ? '#F59E0B' : 'var(--text-muted)';
          });
        }
        document.querySelectorAll('#star-picker button').forEach(function(b,i,a) {
          b.addEventListener('mouseenter', function() {
            a.forEach(function(x,j) { x.style.color = j <= i ? '#F59E0B' : 'var(--text-muted)'; });
          });
          b.addEventListener('mouseleave', function() {
            var v = parseInt(document.getElementById('rv').value)||0;
            a.forEach(function(x,j) { x.style.color = j < v ? '#F59E0B' : 'var(--text-muted)'; });
          });
        });
      <% end %>

      <div class="form-group">
        <label class="form-label" for="comment">Detailed Feedback & Review</label>
        <%= f.text_area :comment, id: "comment", class: "form-control", rows: 5, placeholder: "Describe the collaboration, skills learned, professionalism, and any constructive comments...", required: true, oninput: "updateCC(this)" %>
        <div style="display:flex;justify-content:space-between;margin-top:4px;">
          <small class="form-hint">Reviews cannot be edited once submitted.</small>
          <span id="cc" style="font-size:11px;color:var(--text-muted);">0 / min 10</span>
        </div>
      </div>
      <%= javascript_tag nonce: true do %>
        function updateCC(el) { var n=el.value.length; var c=document.getElementById('cc');
          c.textContent=n+' / min 10'; c.style.color=n>=10?'#10B981':'var(--text-muted)'; }
      <% end %>

      <div class="form-actions-row">
        <%= link_to "Cancel", dashboard_path, class: "btn btn-secondary btn-flex-1" %>
        <%= f.submit "Submit Review", class: "btn btn-primary btn-flex-2", data: { turbo_confirm: "Reviews cannot be edited after submission. Continue?" } %>
      </div>
    <% end %>
  </div>
</div>
