<% content_for :title, "#{t("dashboard.reviews.write_review")} – StageUp" %>
<div class="form-page form-page-narrow">

  <div class="form-page-header">
    <h1 class="form-page-title"><%= t("dashboard.reviews.write_review") %></h1>
    <p class="form-page-subtitle">
      <%= t("dashboard.reviews.subtitle_html", name: current_user == @submission.student_profile.user ? @submission.offer.company_profile.name : "#{@submission.student_profile.first_name} #{@submission.student_profile.last_name}") %>
    </p>
  </div>

  <div class="form-page-body">

    <div class="review-context-card">
      <div class="review-context-row">
        <i data-lucide="briefcase"></i>
        <div>
          <span class="review-context-label"><%= t("dashboard.reviews.internship") %></span>
          <strong class="review-context-value"><%= @submission.offer.title %></strong>
        </div>
      </div>
    </div>

    <% if @review.errors.any? %>
      <div class="flash-message flash-alert mb-20">
        <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
        <span><%= @review.errors.full_messages.first %></span>
      </div>
    <% end %>

    <%= form_with model: [@submission, @review], local: true do |f| %>

      <div class="form-group">
        <label class="form-label"><%= t("dashboard.reviews.rating_label") %></label>
        <div class="star-picker" id="star-picker">
          <% (1..5).each do |i| %>
            <button type="button" class="star-btn" data-v="<%= i %>" onclick="pickStar(<%= i %>)">
              <i data-lucide="star" class="star-icon"></i>
            </button>
          <% end %>
        </div>
        <%= f.hidden_field :rating, id: "rv" %>
        <span id="sh" class="form-hint"><%= t("dashboard.reviews.click_to_rate") %></span>
      </div>

      <div class="form-group">
        <label class="form-label" for="comment"><%= t("dashboard.reviews.feedback") %></label>
        <%= f.text_area :comment, id: "comment", class: "form-control", rows: 5,
            placeholder: t("dashboard.reviews.comment_placeholder"),
            required: true, oninput: "updateCC(this)" %>
        <div class="form-hint-row">
          <small class="form-hint"><%= t("dashboard.reviews.hint") %></small>
          <span id="cc" class="char-count" data-suffix="<%= t('dashboard.reviews.char_count_suffix', min: 10) %>"><%= t("dashboard.reviews.char_count", count: 0, min: 10) %></span>
        </div>
      </div>

      <div class="form-footer">
        <%= link_to t("common.cancel"), dashboard_path, class: "btn btn-secondary btn-cancel" %>
        <%= f.submit t("dashboard.reviews.submit"), class: "btn btn-primary btn-submit",
            data: { turbo_confirm: t("dashboard.reviews.turbo_confirm"), turbo_submits_with: t("dashboard.reviews.submitting") } %>
      </div>

    <% end %>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  var labels = JSON.parse('<%= raw t("dashboard.reviews.rating.labels").to_json %>');
  function pickStar(v) {
    document.getElementById('rv').value = v;
    document.getElementById('sh').textContent = labels[v-1] + ' (' + v + '/5)';
    document.querySelectorAll('#star-picker .star-btn').forEach(function(b,i) {
      b.classList.toggle('active', i < v);
    });
  }
  document.querySelectorAll('#star-picker .star-btn').forEach(function(b,i,a) {
    b.addEventListener('mouseenter', function() {
      a.forEach(function(x,j) { x.classList.toggle('hover', j <= i); });
    });
    b.addEventListener('mouseleave', function() {
      var v = parseInt(document.getElementById('rv').value)||0;
      a.forEach(function(x,j) { x.classList.remove('hover'); x.classList.toggle('active', j < v); });
    });
  });
  function updateCC(el) {
    var n = el.value.length;
    var c = document.getElementById('cc');
    c.textContent = n + c.dataset.suffix;
    c.classList.toggle('char-count-ok', n >= 10);
  }
<% end %>

