<% content_for :title, "Leave a Review – StageUp" %>
<div class="auth-container">
  <div class="auth-card auth-card-md auth-card-padded-lg">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Share Your Experience</h2>
      <p class="auth-subtitle">Leave a review for your recent internship</p>
    </div>

    <div class="info-card">
      <span class="info-label">Internship:</span>
      <strong class="info-value"><%= @submission.offer.title %></strong>
      <span class="info-label mt-10">With:</span>
      <strong class="info-value-accent">
        <%= current_user == @submission.student_profile.user ? @submission.offer.company_profile.name : "#{@submission.student_profile.first_name} #{@submission.student_profile.last_name}" %>
      </strong>
    </div>

    <%= form_with model: [@submission, @review], local: true do |f| %>
      
      <% if @review.errors.any? %>
        <div class="flash-message flash-alert flash-alert-col">
          <div class="error-header-row">
            <i data-lucide="alert-circle" class="icon-16 stroke-danger flex-shrink-0"></i>
            <strong>Please resolve the following errors:</strong>
          </div>
          <ul class="error-list">
            <% @review.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <label class="form-label" for="rating">Rating (1 to 5 Stars)</label>
        <%= f.select :rating, [["⭐️⭐️⭐️⭐️⭐️ (5) - Excellent", 5], ["⭐️⭐️⭐️⭐️ (4) - Good", 4], ["⭐️⭐️⭐️ (3) - Average", 3], ["⭐️⭐️ (2) - Below Average", 2], ["⭐️ (1) - Poor", 1]], { prompt: "Select Rating" }, { id: "rating", class: "form-control", required: true } %>
      </div>

      <div class="form-group">
        <label class="form-label" for="comment">Detailed Feedback & Review</label>
        <%= f.text_area :comment, id: "comment", class: "form-control", rows: 5, placeholder: "Describe the collaboration, skills learned, professionalism, and any constructive comments...", required: true %>
        <small class="form-hint">
          ⚠️ Reviews must be at least 10 characters long and cannot be edited once submitted.
        </small>
      </div>

      <div class="form-actions-row">
        <%= link_to "Cancel", dashboard_path, class: "btn btn-secondary btn-flex-1" %>
        <%= f.submit "Submit Review", class: "btn btn-primary btn-flex-2" %>
      </div>
    <% end %>
  </div>
</div>
