<% content_for :title, t('home.title', default: "StageUp – Verified Internships in Tunisia") %>
<div class="landing-wrapper">
  <div class="cinema-glow-bg"></div>

  <div class="landing-inner">
    
    <%# ─── Hero Grid: Asymmetric 2-Column Layout ─────────────────── %>
    <div class="landing-hero-grid">
      
      <%# Left Column: Branding, Announcement, and CTAs %>
      <div class="hero-left-col text-left">
        
        <div class="landing-badge-container animate-in visible stagger-1">
          <div class="landing-announcement-badge">
            <span class="badge-new-tag"><%= t('home.badge_new') %></span>
            <span class="badge-text"><%= t('home.announcement_badge') %></span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </div>


        <h1 class="landing-hero-title animate-in visible stagger-2">
          <%= t('home.hero_title_html') %>
        </h1>

        <p class="landing-subhead animate-in visible stagger-3">
          <%= t('home.hero_subtitle') %>
        </p>

        <div class="landing-cta-row animate-in visible stagger-4">
          <%= link_to t('home.browse_btn'), offers_path, class: "btn btn-accent landing-cta-btn" %>
          <% if user_signed_in? %>
            <%= link_to t('home.dashboard_btn'), dashboard_path, class: "btn btn-primary landing-cta-btn" %>
          <% else %>
            <%= link_to t('home.get_started_btn'), select_role_path, class: "btn btn-secondary landing-cta-btn" %>
          <% end %>
        </div>
      </div>

      <%# Right Column: Interactive Product Mockup %>
      <div class="hero-right-col animate-in visible stagger-3">
        <div class="glass-card hero-mockup-card motion-float-gentle">
          <div class="mockup-header">
            <div class="mockup-header-left">
              <div class="window-controls">
                <span class="win-dot dot-close"></span>
                <span class="win-dot dot-minimize"></span>
                <span class="win-dot dot-expand"></span>
              </div>
              <span class="mockup-pulse-dot"></span>
              <span class="mockup-header-title"><%= t('home.mockup_header') %></span>
            </div>
            <span class="mockup-header-badge"><%= t('home.mockup_header_badge') %></span>
          </div>

          <div class="mockup-body">
            <% events = @recent_events.to_a rescue [] %>
            <% 3.times do |i| %>
              <% event = events[i] %>
              <div class="mockup-row animate-in visible stagger-<%= i + 4 %>">
                <div class="mockup-row-left">
                  <% if event && event.profileable %>
                    <% name = case event.profileable
                           when StudentProfile then "#{event.profileable.first_name} #{event.profileable.last_name}"
                           when CompanyProfile then event.profileable.name
                           when UniversityProfile then event.profileable.admin_name
                           else t('home.unknown_user', default: 'Unknown User')
                           end %>
                    <div class="mockup-avatar avatar-<%= i == 0 ? 'purple' : (i == 1 ? 'blue' : 'green') %>">
                      <%= name[0]&.upcase || "?" %>
                    </div>
                    <div class="mockup-row-info">
                      <span class="mockup-user-name"><%= name %></span>
                      <span class="mockup-action-text"><%= t("commitment_events.descriptions.#{event.event_type}", default: event.description.presence || event.event_type.humanize) %></span>
                    </div>
                  <% else %>
                    <div class="mockup-avatar avatar-muted" style="background: rgba(255,255,255,0.05); color: var(--text-muted);">?</div>
                    <div class="mockup-row-info">
                      <span class="mockup-user-name text-muted"><%= t('home.unknown_user', default: 'Unknown User') %></span>
                      <span class="mockup-action-text text-muted"><%= t('home.no_recent_activity', default: 'No live activity recorded yet') %></span>
                    </div>
                  <% end %>
                </div>
                <% if event %>
                  <% score = event.score_delta.to_i %>
                  <span class="mockup-score <%= score >= 0 ? 'score-plus' : 'score-minus' %>">
                    <%= score >= 0 ? "+#{score}" : "#{score}" %> <%= t('home.pts', default: 'pts') %>
                  </span>
                <% else %>
                  <span class="mockup-score score-neutral" style="color: var(--text-muted); background: rgba(255,255,255,0.03);">0 <%= t('home.pts', default: 'pts') %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

    </div>

    <%# ─── Platform Impact Bar ──────────────────────────────────── %>
    <div class="landing-stats-bar animate-in visible stagger-4">
      <div class="landing-stat-item">
        <span class="stat-number">100%</span>
        <span class="stat-label"><%= t('home.stat_verification') %></span>
      </div>
      <div class="landing-stat-divider"></div>
      <div class="landing-stat-item">
        <span class="stat-number">0</span>
        <span class="stat-label"><%= t('home.stat_ghosting') %></span>
      </div>
      <div class="landing-stat-divider"></div>
      <div class="landing-stat-item">
        <span class="stat-number">5.0</span>
        <span class="stat-label"><%= t('home.stat_reputation') %></span>
      </div>
    </div>

    <%# ─── How It Works Section ─────────────────────────────────── %>
    <div class="landing-section-header animate-in visible stagger-5">
      <div class="landing-section-eyebrow">
        <svg class="icon-indigo" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        <span><%= t('home.how_it_works') %></span>
      </div>
      <h2 class="landing-section-title"><%= t('home.how_it_works_title') %></h2>
      <p class="landing-section-sub"><%= t('home.how_it_works_sub') %></p>
    </div>

    <%# ─── Bento Grid Section ───────────────────────────────────── %>
    <div class="bento-grid">
      <div class="bento-card glass-card animate-in visible stagger-1">
        <div class="bento-icon">
          <svg class="icon-indigo" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><line x1="12" x2="12" y1="12" y2="18"/></svg>
        </div>
        <h3 class="bento-card-title"><%= t('home.bento_mission_title') %></h3>
        <p class="bento-card-text">
          <%= t('home.bento_mission_text') %>
        </p>
      </div>

      <div class="bento-card glass-card animate-in visible stagger-2">
        <div class="bento-icon">
          <svg class="icon-success" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <h3 class="bento-card-title"><%= t('home.bento_reputation_title') %></h3>
        <p class="bento-card-text">
          <%= t('home.bento_reputation_text') %>
        </p>
      </div>

      <div class="bento-card glass-card animate-in visible stagger-3">
        <div class="bento-icon">
          <svg class="icon-amber" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <h3 class="bento-card-title"><%= t('home.bento_academic_title') %></h3>
        <p class="bento-card-text">
          <%= t('home.bento_academic_text') %>
        </p>
      </div>
    </div>

    <%# ─── Featured Opportunities Section (Protected for Non-Signed-In) ─── %>
    <% if @active_offers.any? %>
      <div class="featured-section animate-in visible stagger-5">
        <div class="featured-header-row">
          <div>
            <h2 class="featured-heading">
              <svg class="icon-indigo" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
              <span><%= t('home.featured_heading') %></span>
            </h2>
            <p class="featured-sub">
              <% if user_signed_in? %>
                <%= t('home.featured_sub_signed_in') %>
              <% else %>
                <%= t('home.featured_sub_signed_out') %>
              <% end %>
            </p>
          </div>
          <%= link_to t('home.featured_view_all'), offers_path, class: "featured-view-all" %>
        </div>

        <div class="featured-grid">
          <% @active_offers.each_with_index do |offer, idx| %>
            <div class="glass-card featured-offer-card animate-in visible stagger-<%= [idx + 1, 6].min %>">
              <div>
                <div class="featured-offer-top">
                  <span class="featured-stage-badge"><%= offer.stage_type %></span>
                  <% if offer.mission.present? %>
                    <span class="featured-mission-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><line x1="12" x2="12" y1="12" y2="18"/></svg>
                      <span><%= t('home.mission_attached') %></span>
                    </span>
                  <% else %>
                    <span class="featured-cv-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                      <span><%= t('home.cv_only') %></span>
                    </span>
                  <% end %>
                </div>

                <h3 class="featured-offer-title">
                  <% if user_signed_in? %>
                    <%= link_to offer.title, offer %>
                  <% else %>
                    <%= link_to offer.title, new_user_session_path, title: t('nav.unlock') %>
                  <% end %>
                </h3>
                <span class="featured-offer-company"><%= offer.company_profile&.name || t('home.unknown_company') %></span>
              </div>

              <div class="featured-offer-footer">
                <span class="featured-offer-location">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>
                    <% if offer.location.downcase == "remote" %>
                      <%= t('common.work_modes.remote') %>
                    <% else %>
                      <%= offer.location %> (<%= offer.work_mode.capitalize %>)
                    <% end %>
                  </span>
                </span>

                <% if user_signed_in? %>
                  <%= link_to offer, class: "featured-offer-link" do %>
                    <span><%= t('nav.view_offer') %></span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  <% end %>
                <% else %>
                  <%= link_to new_user_session_path, class: "featured-offer-link link-locked" do %>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span><%= t('nav.unlock') %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ─── CTA Hero Footer Section ──────────────────────────────── %>
    <% unless user_signed_in? %>
      <div class="landing-cta-section animate-in visible stagger-6">
        <div class="landing-cta-inner">
          <div class="landing-cta-text">
            <h2 class="landing-cta-title"><%= t('home.cta_title') %></h2>
            <p class="landing-cta-desc"><%= t('home.cta_desc') %></p>
          </div>
          <div class="landing-cta-actions">
            <%= link_to t('home.cta_account'), select_role_path, class: "btn btn-primary" %>
            <%= link_to t('home.cta_signin'), new_user_session_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    <% end %>

  </div>
</div>
