<% content_for :title, "StageUp – Verified Internships in Tunisia" %>
<div class="landing-wrapper">
  <div class="cinema-glow-bg"></div>

  <div class="landing-inner">
    
    <!-- Hero Grid: Asymmetric 2-Column Layout -->
    <div class="landing-hero-grid">
      
      <!-- Left Column: Branding, Announcement, and CTAs -->
      <div class="hero-left-col text-left">
        
        <!-- Vercel Announcement Badge -->
        <div class="landing-badge-container animate-in visible stagger-1">
          <div class="landing-announcement-badge">
            <span class="badge-new-tag">New</span>
            <span class="badge-text">Tunisia's First Proof-of-Work Registry</span>
            <i data-lucide="arrow-right" class="badge-arrow"></i>
          </div>
        </div>

        <% unless current_user %>
          <div class="landing-logo-row animate-in visible stagger-1">
            <%= render "layouts/navbar_brand" %>
          </div>
        <% end %>

        <h1 class="landing-hero-title animate-in visible stagger-2">
          Nobody pays a price for ghosting.<br>
          <span class="landing-hero-gradient">We changed that.</span>
        </h1>

        <p class="landing-subhead animate-in visible stagger-3">
          Every offer, mission, and no-show becomes a permanent public record. Tunisia's first internship market where reputation is earned, not claimed.
        </p>

        <div class="landing-cta-row animate-in visible stagger-4">
          <%= link_to "Browse Internships", offers_path, class: "btn btn-accent landing-cta-btn" %>
          <%= link_to "Get Started", select_role_path, class: "btn btn-secondary landing-cta-btn" %>
        </div>
      </div>

      <!-- Right Column: Interactive Product Mockup -->
      <div class="hero-right-col animate-in visible stagger-3">
        <div class="glass-card hero-mockup-card">
          <div class="mockup-header">
            <div class="mockup-header-left">
              <div class="window-controls">
                <span class="win-dot dot-close"></span>
                <span class="win-dot dot-minimize"></span>
                <span class="win-dot dot-expand"></span>
              </div>
              <span class="mockup-pulse-dot"></span>
              <span class="mockup-header-title">Live Reputation Ledger</span>
            </div>
            <span class="mockup-header-badge">Mainnet</span>
          </div>

          <div class="mockup-body">
            <div class="mockup-row animate-in visible stagger-4">
              <div class="mockup-row-left">
                <div class="mockup-avatar avatar-purple">C</div>
                <div class="mockup-row-info">
                  <span class="mockup-user-name">Cyrine (Student)</span>
                  <span class="mockup-action-text">Submitted code solution to ISET</span>
                </div>
              </div>
              <span class="mockup-score score-plus">+10 pts</span>
            </div>

            <div class="mockup-row animate-in visible stagger-5">
              <div class="mockup-row-left">
                <div class="mockup-avatar avatar-blue">V</div>
                <div class="mockup-row-info">
                  <span class="mockup-user-name">Vortech Startups</span>
                  <span class="mockup-action-text">Missed review deadline (Grace ended)</span>
                </div>
              </div>
              <span class="mockup-score score-minus">-15 pts</span>
            </div>

            <div class="mockup-row animate-in visible stagger-6">
              <div class="mockup-row-left">
                <div class="mockup-avatar avatar-green">M</div>
                <div class="mockup-row-info">
                  <span class="mockup-user-name">Mohamed (Student)</span>
                  <span class="mockup-action-text">Completed verified PFE agreement</span>
                </div>
              </div>
              <span class="mockup-score score-plus">+30 pts</span>
            </div>

            <div class="mockup-row animate-in visible stagger-6">
              <div class="mockup-row-left">
                <div class="mockup-avatar avatar-red">S</div>
                <div class="mockup-row-info">
                  <span class="mockup-user-name">SmartCorp-Sfax</span>
                  <span class="mockup-action-text">Unverified coordinator attempt flagged</span>
                </div>
              </div>
              <span class="mockup-score score-alert">Flagged</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Ticker Section -->
    <div data-controller="ticker" class="landing-ticker animate-in stagger-4">
      <div class="ticker-fade-left"></div>
      <div class="ticker-fade-right"></div>
      <div data-ticker-target="container"></div>
    </div>

    <!-- Core Benefits Section Header -->
    <div class="landing-section-header animate-in stagger-5">
      <div class="landing-section-eyebrow">
        <i data-lucide="layers"></i>
        How It Works
      </div>
      <h2 class="landing-section-title">A Better Internship Loop</h2>
      <p class="landing-section-sub">Verifiable trust replacing static, unverified resumes</p>
    </div>

    <!-- Bento Grid Section -->
    <div class="bento-grid">
      <div class="bento-card bento-card-1 glass-card animate-in stagger-1">
        <div class="bento-icon"><i data-lucide="git-commit"></i></div>
        <h3 class="bento-card-title">Proof-of-Work Missions</h3>
        <p class="bento-card-text">
          Skip the endless CV filtering. Recruiters attach hands-on 48-hour coding challenges. Students submit clean code solutions directly to unlock interviews.
        </p>
      </div>

      <div class="bento-card bento-card-2 glass-card animate-in stagger-2">
        <div class="bento-icon"><i data-lucide="shield-check"></i></div>
        <h3 class="bento-card-title">Reputation Ledger</h3>
        <p class="bento-card-text">
          Verify reliability upfront. Our immutable scoring system penalizes ghosting or missed deadlines, and rewards verified completions on both sides.
        </p>
      </div>

      <div class="bento-card bento-card-3 glass-card animate-in stagger-3">
        <div class="bento-icon"><i data-lucide="check-circle"></i></div>
        <h3 class="bento-card-title">Academic Verification</h3>
        <p class="bento-card-text">
          Official email domain tracking (e.g. <code>@isetsf.rnu.tn</code> or <code>@enis.tn</code>) instantly verifies student credentials and connects them to registered coordinators.
        </p>
      </div>
    </div>

    <!-- Featured Opportunities Section -->
    <% if @active_offers.any? %>
      <div class="featured-section animate-in stagger-5">
        <div class="featured-header-row">
          <div>
            <h2 class="featured-heading">
              <i data-lucide="compass" class="featured-heading-icon"></i>
              Featured Opportunities
            </h2>
            <p class="featured-sub">Browse active internship listings and take on their proof missions</p>
          </div>
          <%= link_to "View All Offers →", offers_path, class: "featured-view-all" %>
        </div>

        <div class="featured-grid">
          <% @active_offers.each_with_index do |offer, idx| %>
            <div class="glass-card featured-offer-card animate-in stagger-<%= [idx + 1, 6].min %>">
              <div>
                <div class="featured-offer-top">
                  <span class="featured-stage-badge"><%= offer.stage_type %></span>
                  <% if offer.mission.present? %>
                    <span class="featured-mission-badge">
                      <i data-lucide="git-commit" class="featured-badge-icon"></i>
                      Mission Attached
                    </span>
                  <% else %>
                    <span class="featured-cv-badge">
                      <i data-lucide="check-circle" class="featured-badge-icon stroke-secondary"></i>
                      CV Only
                    </span>
                  <% end %>
                </div>
                <h3 class="featured-offer-title"><%= link_to offer.title, offer %></h3>
                <span class="featured-offer-company"><%= offer.company_profile.name %></span>
              </div>
              <div class="featured-offer-footer">
                <span class="featured-offer-location">
                  <i data-lucide="map-pin" class="featured-location-icon"></i>
                  <% if offer.location.downcase == "remote" %>
                    Remote
                  <% else %>
                    <%= offer.location %> (<%= offer.work_mode.capitalize %>)
                  <% end %>
                </span>
                <%= link_to "View details", offer, class: "featured-offer-link" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% unless current_user %>
      <div class="landing-cta-section animate-in stagger-6">
        <div class="landing-cta-inner">
          <div class="landing-cta-text">
            <h2 class="landing-cta-title">Ready to build your reputation?</h2>
            <p class="landing-cta-desc">Join Tunisia's first verified internship platform. Your track record starts here.</p>
          </div>
          <div class="landing-cta-actions">
            <%= link_to "Create an Account", select_role_path, class: "btn btn-primary" %>
            <%= link_to "Browse Offers", offers_path, class: "btn btn-secondary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= javascript_tag nonce: true, type: "module" do %>
  import { Application } from "https://unpkg.com/@hotwired/stimulus/dist/stimulus.js"
  import TickerController from "<%= asset_path('controllers/ticker_controller.js') %>"
  
  if (!window.Stimulus) {
    window.Stimulus = Application.start()
  }
  window.Stimulus.register("ticker", TickerController)

  (function() {
    var els = document.querySelectorAll('.animate-in:not(.visible)');
    if (els.length) {
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) { 
            e.target.classList.add('visible'); 
            obs.unobserve(e.target); 
          }
        });
      }, { threshold: 0.15 });
      els.forEach(function(el) { obs.observe(el); });
    }
  })();
<% end %>
