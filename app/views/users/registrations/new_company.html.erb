<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title"><%= t('registrations.new_company.title') %></h2>
      <p class="auth-subtitle"><%= t('registrations.new_company.subtitle') %></p>
    </div>

    <%= form_with scope: :company_profile, url: company_registration_path, local: true do |f| %>
      
      <!-- Display Validation Errors -->
      <% errors = (@company_profile.errors.full_messages + @user.errors.full_messages).uniq %>
      <% if errors.any? %>
        <div class="flash-message flash-alert flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
            <strong><%= t('registrations.new_company.errors_title') %></strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <label class="form-label" for="company_name"><%= t('registrations.new_company.form.name') %></label>
        <%= f.text_field :name, value: @company_profile.name, id: "company_name", class: "form-control", placeholder: t('registrations.new_company.form.name_placeholder'), required: true %>
      </div>

      <div class="form-group">
        <label class="form-label" for="website"><%= t('registrations.new_company.form.website') %></label>
        <%= f.url_field :website, value: @company_profile.website, id: "website", class: "form-control", placeholder: t('registrations.new_company.form.website_placeholder') %>
      </div>

      <div class="form-group">
        <label class="form-label" for="description"><%= t('registrations.new_company.form.description') %></label>
        <%= f.text_area :description, value: @company_profile.description, id: "description", class: "form-control", rows: 4, placeholder: t('registrations.new_company.form.description_placeholder') %>
      </div>

      <!-- Nested User Fields -->
      <%= fields_for :user, @user do |u| %>
        <div class="form-group">
          <label class="form-label" for="user_email"><%= t('registrations.new_company.form.email') %></label>
          <%= u.email_field :email, id: "user_email", class: "form-control", placeholder: t('registrations.new_company.form.email_placeholder'), required: true %>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="user_password"><%= t('registrations.new_company.form.password') %></label>
            <div class="pw-wrap">
              <%= u.password_field :password, id: "user_password", class: "form-control", placeholder: "••••••••", required: true %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="user_password_confirmation"><%= t('registrations.new_company.form.password_confirmation') %></label>
            <div class="pw-wrap">
              <%= u.password_field :password_confirmation, id: "user_password_confirmation", class: "form-control", placeholder: "••••••••", required: true %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <button type="submit" class="btn btn-primary btn-mt" data-turbo-submits-with="<%= t('registrations.new_company.form.submitting') %>">
        <%= t('registrations.new_company.form.submit') %>
      </button>
    <% end %>

    <div class="auth-footer mt-25">
      <%= t('registrations.new_company.not_company') %> <%= link_to t('registrations.new_company.back'), select_role_path %>
    </div>
  </div>
</div>
