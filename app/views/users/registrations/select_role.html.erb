<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Create your account</h2>
      <p class="auth-subtitle">Select your profile type to get started</p>
    </div>

    <div class="role-grid">
      <%= link_to new_student_registration_path, class: "role-card" do %>
        <div class="role-icon">
          <i data-lucide="graduation-cap"></i>
        </div>
        <div>
          <h3 class="role-title">I am a Student</h3>
          <p class="role-desc">Browse internships, prove your skills with missions, and build a verified career profile.</p>
        </div>
      <% end %>

      <%= link_to new_company_registration_path, class: "role-card" do %>
        <div class="role-icon">
          <i data-lucide="briefcase"></i>
        </div>
        <div>
          <h3 class="role-title">I am a Company / Startup</h3>
          <p class="role-desc">Post internship offers, attach proof-of-work missions, and hire reliable talent.</p>
        </div>
      <% end %>

      <%= link_to new_university_registration_path, class: "role-card" do %>
        <div class="role-icon">
          <i data-lucide="landmark"></i>
        </div>
        <div>
          <h3 class="role-title">I am a University Coordinator</h3>
          <p class="role-desc">Verify student profiles, endorse trusted companies, and simplify internship agreements.</p>
        </div>
      <% end %>
    </div>

    <div class="auth-footer">
      Already have an account? <%= link_to "Sign In", new_user_session_path, class: "fw-500" %>
    </div>
  </div>
</div>
