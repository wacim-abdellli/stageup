<% content_for :title, "#{t('registrations.select_role.title')} – StageUp" %>
<% content_for :head do %>
<style nonce="<%= content_security_policy_nonce %>">
  .role-card {
    box-sizing: border-box;
    height: 86px;
    min-height: unset;
    overflow: hidden;
    padding: 0 48px 0 20px;
    position: relative;
  }
  .role-info {
    min-width: 0;
    overflow: hidden;
  }
  .role-desc {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .role-arrow {
    position: absolute !important;
    right: 20px;
    left: auto;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
  }
  .role-card:hover .role-arrow {
    transform: translateY(-50%) translateX(4px);
  }
  html[dir="rtl"] .role-card {
    padding: 0 20px 0 48px;
  }
  html[dir="rtl"] .role-icon {
    margin-right: 0;
    margin-left: 14px;
  }
  html[dir="rtl"] .role-info {
    margin-right: 0;
    margin-left: 0;
    text-align: right;
  }
  html[dir="rtl"] .role-arrow {
    right: auto;
    left: 20px;
    transform: translateY(-50%) scaleX(-1);
  }
  html[dir="rtl"] .role-card:hover .role-arrow {
    transform: translateY(-50%) translateX(-4px) scaleX(-1);
  }
</style>
<% end %>
<div class="auth-container">
  <div class="auth-card auth-card-md">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title"><%= t('registrations.select_role.title') %></h2>
      <p class="auth-subtitle"><%= t('registrations.select_role.subtitle') %></p>
    </div>

    <div class="role-grid">
      <%= link_to new_student_registration_path, class: "role-card role-card-student" do %>
        <div class="role-icon icon-indigo">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <div class="role-info">
          <h3 class="role-title"><%= t('registrations.select_role.student.title') %></h3>
          <p class="role-desc"><%= t('registrations.select_role.student.desc') %></p>
        </div>
        <svg class="role-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <% end %>

      <%= link_to new_company_registration_path, class: "role-card role-card-company" do %>
        <div class="role-icon icon-emerald">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <div class="role-info">
          <h3 class="role-title"><%= t('registrations.select_role.company.title') %></h3>
          <p class="role-desc"><%= t('registrations.select_role.company.desc') %></p>
        </div>
        <svg class="role-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <% end %>

      <%= link_to new_university_registration_path, class: "role-card role-card-university" do %>
        <div class="role-icon icon-amber">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
        </div>
        <div class="role-info">
          <h3 class="role-title"><%= t('registrations.select_role.university.title') %></h3>
          <p class="role-desc"><%= t('registrations.select_role.university.desc') %></p>
        </div>
        <svg class="role-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      <% end %>
    </div>

    <div class="auth-footer">
      <%= t('registrations.select_role.already_account_html', link: link_to(t('registrations.select_role.sign_in'), new_user_session_path, class: "auth-signin-link")) %>
    </div>
  </div>
</div>
