<% content_for :title, "Account Settings – StageUp" %>

<div class="dashboard-container settings-page-container">
  <div class="settings-card-wrapper max-width-800">
    
    <%# ─── Settings Header ────────────────────────────────────────────── %>
    <div class="settings-card-header text-left mb-28">
      <div class="flex-between mb-12">
        <%= link_to dashboard_path, class: "btn btn-secondary btn-compact" do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          <%= t('common.back', default: 'Back to Dashboard') %>
        <% end %>
        <span class="badge badge-info fs-12"><%= current_user.profileable_type.underscore.humanize %></span>
      </div>
      <h1 class="settings-title margin-0 mb-6"><%= t('users.edit.title', default: 'Account & Profile Settings') %></h1>
      <p class="settings-subtitle margin-0"><%= t('users.edit.subtitle', default: 'Update your personal profile information and manage account security credentials.') %></p>
    </div>

    <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put, html: { multipart: true, class: "auth-form" } do |f| %>
      <% errors = ((@profile&.errors&.full_messages || []) + (resource&.errors&.full_messages || [])).uniq %>
      <% if errors.any? %>
        <div class="flash-message flash-alert flash-col mb-24">
          <div class="flash-col-header">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <strong><%= t('common.errors_title', default: 'Please fix the errors below:') %></strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# ─── SECTION 1: PERSONAL & PROFESSIONAL PROFILE ────────────────── %>
      <div class="settings-section mb-36">
        <div class="settings-section-title-row mb-20">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <h3 class="fs-17 fw-700 color-primary margin-0"><%= t('users.edit.profile_section', default: 'Personal & Professional Details') %></h3>
        </div>

        <% if current_user.profileable_type == "StudentProfile" %>
          <%= fields_for :student_profile, @profile do |sp| %>
            <div class="form-row-2">
              <div class="form-group">
                <%= sp.label :first_name, t('users.new_student.first_name', default: 'First Name'), class: "form-label" %>
                <%= sp.text_field :first_name, class: "form-control", required: true %>
              </div>
              <div class="form-group">
                <%= sp.label :last_name, t('users.new_student.last_name', default: 'Last Name'), class: "form-label" %>
                <%= sp.text_field :last_name, class: "form-control", required: true %>
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <%= sp.label :phone, t('users.new_student.phone', default: 'Phone Number'), class: "form-label" %>
                <%= sp.telephone_field :phone, class: "form-control", placeholder: "+216 XX XXX XXX" %>
              </div>
              <div class="form-group">
                <%= sp.label :graduation_year, t('users.new_student.graduation_year', default: 'Graduation Year'), class: "form-label" %>
                <%= sp.number_field :graduation_year, class: "form-control", min: 2020, max: 2035 %>
              </div>
            </div>

            <div class="form-group">
              <%= sp.label :major, t('users.new_student.major', default: 'Field of Study / Major'), class: "form-label" %>
              <%= sp.text_field :major, class: "form-control", placeholder: "e.g. Software Engineering, Data Science" %>
            </div>

            <div class="form-group">
              <%= sp.label :bio, t('users.new_student.bio', default: 'Bio & Career Summary'), class: "form-label" %>
              <%= sp.text_area :bio, rows: 3, class: "form-control", placeholder: "Brief summary of your skills, passion, and target internship." %>
            </div>

            <%# ─── Categorized Skills Taxonomy Selector ───────────────────── %>
            <div class="form-group mb-28">
              <div class="flex-between flex-wrap gap-12 mb-12">
                <label class="form-label margin-0 fs-14 fw-600 color-primary flex-align-center gap-6">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                  <%= t('dashboard.profile_bento.skills', default: 'Skills & Technical Taxonomy') %>
                </label>
                <span class="badge badge-success fs-11" id="skills-selected-counter">
                  <%= @profile.skill_ids.count %> Selected
                </span>
              </div>

              <%# Search & Filter Controls %>
              <div class="skills-filter-toolbar mb-16">
                <div class="skill-search-box mb-12">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" class="skill-search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <input type="text" id="skill-search-input" class="form-control skill-search-input" placeholder="Search 98+ skills (e.g. Rails, Python, React, Docker, SQL)...">
                </div>

                <div class="category-tabs-row flex-wrap gap-6" id="category-tabs">
                  <button type="button" class="cat-tab-btn active" data-category="all">All Skills</button>
                  <% (@skills_by_category || {}).keys.each do |cat| %>
                    <button type="button" class="cat-tab-btn" data-category="<%= cat.parameterize %>">
                      <%= cat %> (<%= @skills_by_category[cat].count %>)
                    </button>
                  <% end %>
                </div>
              </div>

              <%# Categorized Skill Groups Container %>
              <div class="skills-category-container" id="skills-category-container">
                <% (@skills_by_category || {}).each do |category, skills_list| %>
                  <div class="skill-category-group mb-20" data-cat-id="<%= category.parameterize %>">
                    <div class="skill-category-header flex-align-center gap-8 mb-10">
                      <span class="category-dot"></span>
                      <h4 class="fs-13 fw-700 color-primary margin-0 text-uppercase tracking-wider"><%= category %></h4>
                      <span class="fs-11 text-muted">(<%= skills_list.count %>)</span>
                    </div>

                    <div class="skills-checkbox-grid">
                      <% skills_list.each do |skill| %>
                        <% is_checked = @profile.skill_ids.include?(skill.id) %>
                        <label class="skill-checkbox-pill <%= 'pill-selected' if is_checked %>" data-skill-name="<%= skill.name.downcase %>">
                          <%= check_box_tag "student_profile[skill_ids][]", skill.id, is_checked, class: "skill-checkbox-input" %>
                          <span><%= skill.name %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <%# Resume / CV Upload %>
            <div class="form-group">
              <label class="form-label"><%= t('dashboard.profile_bento.cv_document', default: 'Resume / CV Document (PDF)') %></label>
              <% if @profile.cv.attached? %>
                <div class="cv-attached-box mb-10">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span class="fs-13 font-mono text-truncate"><%= @profile.cv.filename %> (<%= number_to_human_size(@profile.cv.byte_size) %>)</span>
                </div>
              <% end %>
              <%= sp.file_field :cv, accept: "application/pdf", class: "form-control-file" %>
              <span class="form-help-text mt-4"><%= t('dashboard.profile_bento.cv_help', default: 'Upload a PDF document up to 5MB.') %></span>
            </div>
          <% end %>

        <% elsif current_user.profileable_type == "CompanyProfile" %>
          <%= fields_for :company_profile, @profile do |cp| %>
            <div class="form-group">
              <%= cp.label :name, t('users.new_company.name', default: 'Company Name'), class: "form-label" %>
              <%= cp.text_field :name, class: "form-control", required: true %>
            </div>

            <div class="form-group">
              <%= cp.label :website, t('users.new_company.website', default: 'Company Website'), class: "form-label" %>
              <%= cp.url_field :website, class: "form-control", placeholder: "https://example.tn" %>
            </div>

            <div class="form-group">
              <%= cp.label :description, t('users.new_company.description', default: 'Company Description & Overview'), class: "form-label" %>
              <%= cp.text_area :description, rows: 4, class: "form-control", placeholder: "Describe your company, tech stack, and what you offer to interns." %>
            </div>
          <% end %>

        <% elsif current_user.profileable_type == "UniversityProfile" %>
          <%= fields_for :university_profile, @profile do |up| %>
            <div class="form-group">
              <%= up.label :admin_name, t('users.new_university.admin_name', default: 'Coordinator Full Name'), class: "form-label" %>
              <%= up.text_field :admin_name, class: "form-control", required: true %>
            </div>

            <div class="form-group">
              <%= up.label :department, t('users.new_university.department', default: 'University Department'), class: "form-label" %>
              <%= up.text_field :department, class: "form-control", placeholder: "e.g. IT Department, Computer Science" %>
            </div>
          <% end %>
        <% end %>
      </div>

      <%# ─── SECTION 2: SECURITY & AUTHENTICATION ──────────────────────── %>
      <div class="settings-section border-top p-top-28 mb-36">
        <div class="settings-section-title-row mb-20">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <h3 class="fs-17 fw-700 color-primary margin-0"><%= t('users.edit.security_section', default: 'Account Security & Login Credentials') %></h3>
        </div>

        <div class="form-group">
          <%= f.label :email, t('users.edit.email', default: 'Account Email Address'), class: "form-label" %>
          <%= f.email_field :email, class: "form-control", autocomplete: "email", required: true %>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <%= f.label :password, t('users.edit.new_password', default: 'New Password (optional)'), class: "form-label" %>
            <%= f.password_field :password, class: "form-control", autocomplete: "new-password", placeholder: t('users.edit.leave_blank_placeholder', default: 'Leave blank to keep unchanged') %>
          </div>
          <div class="form-group">
            <%= f.label :password_confirmation, t('users.edit.confirm_password', default: 'Confirm New Password'), class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
          </div>
        </div>

        <div class="security-notice-box mb-16">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2" class="flex-shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span class="fs-12 text-secondary"><%= t('users.edit.current_password_help', default: 'Enter your current password ONLY if changing your email or password for security confirmation.') %></span>
        </div>

        <div class="form-group">
          <%= f.label :current_password, t('users.edit.current_password', default: 'Current Password (if changing email/password)'), class: "form-label" %>
          <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password" %>
        </div>
      </div>

      <%# ─── FOOTER ACTIONS ─────────────────────────────────────────────── %>
      <div class="form-footer-row flex-between">
        <%= link_to t('common.cancel', default: 'Cancel'), dashboard_path, class: "btn btn-secondary" %>
        <%= f.submit t('users.edit.save_changes', default: 'Save Changes'), class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    function initSkillsFilter() {
      var searchInput = document.getElementById('skill-search-input');
      var categoryTabs = document.querySelectorAll('.cat-tab-btn');
      var categoryGroups = document.querySelectorAll('.skill-category-group');
      var skillPills = document.querySelectorAll('.skill-checkbox-pill');
      var counterBadge = document.getElementById('skills-selected-counter');
      var activeCategory = 'all';

      // Update selected skills counter
      function updateSelectedCounter() {
        var count = document.querySelectorAll('.skill-checkbox-input:checked').length;
        if (counterBadge) {
          counterBadge.textContent = count + ' Selected';
        }
      }

      // Checkbox change event
      document.querySelectorAll('.skill-checkbox-input').forEach(function(chk) {
        chk.addEventListener('change', function() {
          var pill = chk.closest('.skill-checkbox-pill');
          if (pill) {
            if (chk.checked) {
              pill.classList.add('pill-selected');
            } else {
              pill.classList.remove('pill-selected');
            }
          }
          updateSelectedCounter();
        });
      });

      // Filter function
      function filterSkills() {
        var query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        categoryGroups.forEach(function(group) {
          var groupCatId = group.dataset.catId;
          var categoryMatch = (activeCategory === 'all' || activeCategory === groupCatId);
          var hasMatchingSkills = false;

          var groupPills = group.querySelectorAll('.skill-checkbox-pill');
          groupPills.forEach(function(pill) {
            var skillName = pill.dataset.skillName || '';
            var searchMatch = !query || skillName.includes(query);

            if (categoryMatch && searchMatch) {
              pill.style.display = 'inline-flex';
              hasMatchingSkills = true;
            } else {
              pill.style.display = 'none';
            }
          });

          if (hasMatchingSkills) {
            group.style.display = 'block';
          } else {
            group.style.display = 'none';
          }
        });
      }

      // Search input listener
      if (searchInput) {
        searchInput.addEventListener('input', filterSkills);
      }

      // Category tabs listener
      categoryTabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          categoryTabs.forEach(function(t) { t.classList.remove('active'); });
          tab.classList.add('active');
          activeCategory = tab.dataset.category;
          filterSkills();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSkillsFilter);
    } else {
      initSkillsFilter();
    }
  })();
</script>
