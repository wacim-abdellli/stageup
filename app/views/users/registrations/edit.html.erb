    "Mobile & Cross-Platform Development" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
    "Cybersecurity & Network Engineering" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    "Design, Creative & User Experience" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2Z"/></svg>',
    "Mechanical & Industrial Engineering" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>',
    "Electrical, Electronics & Embedded Systems" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
    "Civil Engineering & Architecture" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M16 14h.01"/></svg>',
    "Biotechnology, Chemistry & Healthcare" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v7.31M14 2v7.31M8.5 2h7M14 9.3a6.5 6.5 0 1 1-4 0"/></svg>',
    "Business, Management & Strategy" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>',
    "Finance, Banking & Accounting" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
    "Human Resources & Legal" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
    "Languages & Professional Leadership" => '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>'
  }
  default_cat_icon = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="12 8 8 12 12 16 16 12 12 8"/></svg>'
%>

<div class="dashboard-container settings-hub-container">
  
  <%# ─── Settings Header Bar ────────────────────────────────────────── %>
  <div class="settings-hub-header mb-20">
    <div class="flex-between flex-align-center flex-wrap gap-12 mb-8">
      <div class="flex-align-center gap-10">
        <%= link_to dashboard_path, class: "btn-back-settings" do %>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="mr-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          <span><%= t('dashboard.title', default: 'Dashboard') %></span>
        <% end %>
        <span class="settings-role-badge">
          <span class="role-status-dot"></span>
          <span><%= t("roles.#{current_user.profileable_type.underscore}", default: current_user.profileable_type.underscore.humanize.upcase) %></span>
        </span>
      </div>
    </div>
    <h1 class="settings-hub-title margin-0"><%= t('users.edit.title', default: 'Account & Profile Settings') %></h1>
    <p class="settings-hub-subtitle margin-0 mt-4"><%= t('users.edit.subtitle', default: 'Manage your public portfolio, technical skills taxonomy, and security preferences.') %></p>
  </div>

  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put, html: { multipart: true, id: "settings-main-form" } do |f| %>
    <% errors = ((@profile&.errors&.full_messages || []) + (resource&.errors&.full_messages || [])).uniq %>
    <% if errors.any? %>
      <div class="flash-message flash-alert flash-col mb-24">
        <div class="flash-col-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <strong><%= t('common.errors_title', default: 'Please fix the errors below:') %></strong>
        </div>
        <ul class="error-list">
          <% errors.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# ─── 2-Column Hub Layout ───────────────────────────────────────── %>
    <div class="settings-hub-grid">

      <%# Left Sidebar Navigation & Mini Profile Preview Card %>
      <div class="settings-sidebar">
        <div class="settings-nav-card mb-20">
          <nav class="settings-nav-list" role="tablist">
            <button type="button" class="settings-nav-item active" data-pane="pane-personal">
              <span class="flex-align-center gap-12">
                <span class="settings-nav-icon-badge">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <span><%= t('users.edit.tab_personal', default: 'Personal Profile') %></span>
              </span>
              <span class="tab-status-dot dot-active"></span>
            </button>

            <% if current_user.profileable_type == "StudentProfile" %>
              <button type="button" class="settings-nav-item" data-pane="pane-skills">
                <span class="flex-align-center gap-12">
                  <span class="settings-nav-icon-badge">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
                  </span>
                  <span><%= t('users.edit.tab_skills', default: 'Skills & Stack') %></span>
                </span>
                <span class="sidebar-count-badge" id="nav-skills-badge"><%= @profile.skill_ids.count %></span>
              </button>

              <button type="button" class="settings-nav-item" data-pane="pane-cv">
                <span class="flex-align-center gap-12">
                  <span class="settings-nav-icon-badge">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                  </span>
                  <span><%= t('users.edit.tab_resume', default: 'Resume & CV') %></span>
                </span>
                <% if @profile.cv.attached? %>
                  <span class="fs-10 text-emerald fw-700">PDF</span>
                <% end %>
              </button>
            <% end %>

            <button type="button" class="settings-nav-item" data-pane="pane-security">
              <span class="flex-align-center gap-12">
                <span class="settings-nav-icon-badge">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span><%= t('users.edit.tab_security', default: 'Account & Security') %></span>
              </span>
            </button>
          </nav>
        </div>

        <%# Live Mini Profile Card Preview (Ultra-Clean & Tactile Card) %>
        <div class="sidebar-profile-preview-card mt-20">
          <div class="preview-card-header">
            <div class="preview-avatar-circle">
              <span id="preview-avatar-text"><%= (current_user.email.first rescue 'U').upcase %></span>
            </div>
            <div class="preview-card-info">
              <strong class="sidebar-preview-name block color-primary text-truncate fs-14 margin-0 fw-700" id="preview-name-text">
                <% if current_user.profileable_type == "StudentProfile" %>
                  <%= @profile.first_name.presence || "Candidate" %> <%= @profile.last_name %>
                <% elsif current_user.profileable_type == "CompanyProfile" %>
                  <%= @profile.name.presence || "Employer" %>
                <% else %>
                  <%= current_user.email.split('@').first %>
                <% end %>
              </strong>
              <span class="fs-12 text-muted block text-truncate mt-2" id="preview-sub-text">
                <% if current_user.profileable_type == "StudentProfile" %>
                  <%= @profile.university&.name || @profile.major.presence || t('users.edit.preview_student_label', default: 'Student Candidate') %>
                <% elsif current_user.profileable_type == "CompanyProfile" %>
                  <%= t('users.edit.preview_company_label', default: 'Company Profile') %>
                <% else %>
                  <%= t('users.edit.preview_university_label', default: 'University Account') %>
                <% end %>
              </span>
            </div>
          </div>

          <% if current_user.profileable_type == "StudentProfile" %>
            <div class="preview-stats-row mb-12">
              <div class="score-pill">
                <span class="dot dot-success"></span>
                <strong><%= (@profile.commitment_score rescue 100).to_i %>%</strong>
                <span class="score-label"><%= t('dashboard.commitment_score', default: 'Commitment') %></span>
              </div>
            </div>

            <%= link_to student_profile_path(@profile), class: "btn btn-secondary btn-compact w-100 fs-12 justify-center flex-align-center gap-6" do %>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span><%= t('users.edit.view_public_profile', default: 'View Public Profile') %></span>
            <% end %>
          <% elsif current_user.profileable_type == "CompanyProfile" %>
            <%= link_to company_profile_path(@profile), class: "btn btn-secondary btn-compact w-100 fs-12 justify-center flex-align-center gap-6" do %>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              <span><%= t('users.edit.view_public_profile', default: 'View Public Profile') %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# Right Main Pane Content Container %>
      <div class="settings-content-area">

        <%# ─── TAB PANE 1: PERSONAL / PROFILE ────────────────────────── %>
        <div class="settings-pane active" id="pane-personal">
          <div class="settings-card mb-24">
            <div class="settings-card-header mb-24 flex-between flex-wrap gap-12">
              <div class="flex-align-center gap-12">
                <div class="settings-icon-badge">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div>
                  <h3 class="fs-17 fw-700 color-primary margin-0"><%= t('users.edit.personal_heading', default: 'Personal Profile Details') %></h3>
                  <p class="fs-12 text-muted margin-0"><%= t('users.edit.personal_subtext', default: 'Public portfolio information visible to employers and companies') %></p>
                </div>
              </div>
            </div>

            <% if current_user.profileable_type == "StudentProfile" %>
              <%= fields_for :student_profile, @profile do |sp| %>
                <div class="field-group-section">
                  <div class="field-group-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-group-title-icon"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span><%= t('users.edit.section_identity', default: 'Identity Details') %></span>
                  </div>
                  <div class="form-row-2">
                    <div class="form-group">
                      <%= sp.label :first_name, t('users.new_student.first_name', default: 'First Name'), class: "form-label" %>
                      <%= sp.text_field :first_name, class: "form-control", id: "input-first-name", required: true %>
                    </div>
                    <div class="form-group">
                      <%= sp.label :last_name, t('users.new_student.last_name', default: 'Last Name'), class: "form-label" %>
                      <%= sp.text_field :last_name, class: "form-control", id: "input-last-name", required: true %>
                    </div>
                  </div>
                </div>

                <div class="field-group-section">
                  <div class="field-group-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-group-title-icon"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                    <span><%= t('users.edit.section_academic', default: 'Academic & Contact Information') %></span>
                  </div>
                  <div class="form-row-2">
                    <div class="form-group">
                      <%= sp.label :phone, t('users.new_student.phone', default: 'Phone Number'), class: "form-label" %>
                      <%= sp.telephone_field :phone, class: "form-control", placeholder: t('users.edit.phone_placeholder', default: '+216 XX XXX XXX') %>
                      <span class="form-help-text"><%= t('users.edit.phone_hint', default: 'Visible only to accepted employers') %></span>
                    </div>
                    <div class="form-group">
                      <%= sp.label :graduation_year, t('users.new_student.graduation_year', default: 'Graduation Year'), class: "form-label" %>
                      <%= sp.number_field :graduation_year, class: "form-control", min: 2020, max: 2035 %>
                    </div>
                  </div>

                  <div class="form-group margin-0">
                    <%= sp.label :major, t('users.new_student.major', default: 'Field of Study / Major'), class: "form-label" %>
                    <%= sp.text_field :major, class: "form-control", placeholder: t('users.edit.major_placeholder', default: 'e.g. Software Engineering, Data Science & AI') %>
                  </div>
                </div>

                <div class="field-group-section">
                  <div class="field-group-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="field-group-title-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span><%= t('users.edit.section_portfolio', default: 'Portfolio & Bio Summary') %></span>
                  </div>
                  <div class="form-group margin-0">
                    <div class="flex-between mb-6">
                      <%= sp.label :bio, t('users.new_student.bio', default: 'Bio & Summary'), class: "form-label margin-0" %>
                      <span class="fs-11 text-muted" id="bio-char-counter" data-suffix="<%= j(strip_tags(t('users.edit.bio_char_suffix', max: 300, default: ' / 300'))) %>">0 <%= strip_tags(t('users.edit.bio_char_suffix', max: 300, default: ' / 300')) %></span>
                    </div>
                    <%= sp.text_area :bio, rows: 4, class: "form-control", id: "input-bio", maxlength: 300, placeholder: t('users.edit.bio_placeholder', default: 'Describe your technical interests and career goals...') %>
                  </div>
                </div>
              <% end %>

            <% elsif current_user.profileable_type == "CompanyProfile" %>
              <%= fields_for :company_profile, @profile do |cp| %>
                <div class="form-group">
                  <%= cp.label :name, t('users.new_company.name', default: 'Company Name'), class: "form-label" %>
                  <%= cp.text_field :name, class: "form-control", id: "input-company-name", required: true %>
                </div>

                <div class="form-group">
                  <%= cp.label :website, t('users.new_company.website', default: 'Company Website'), class: "form-label" %>
                  <%= cp.url_field :website, class: "form-control", placeholder: t('users.edit.website_placeholder', default: 'https://example.tn') %>
                </div>

                <div class="form-group margin-0">
                  <%= cp.label :description, t('users.new_company.description', default: 'Company Overview'), class: "form-label" %>
                  <%= cp.text_area :description, rows: 5, class: "form-control", placeholder: t('users.edit.description_placeholder', default: 'Describe your company culture, technology stack, and mission opportunities.') %>
                </div>
              <% end %>

            <% elsif current_user.profileable_type == "UniversityProfile" %>
              <%= fields_for :university_profile, @profile do |up| %>
                <div class="form-group">
                  <%= up.label :admin_name, t('users.new_university.admin_name', default: 'Coordinator Full Name'), class: "form-label" %>
                  <%= up.text_field :admin_name, class: "form-control", required: true %>
                </div>

                <div class="form-group margin-0">
                  <%= up.label :department, t('users.new_university.department', default: 'University Department'), class: "form-label" %>
                  <%= up.text_field :department, class: "form-control", placeholder: t('users.edit.department_placeholder', default: 'e.g. IT & Computer Science Department') %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# ─── TAB PANE 2: SKILLS & STACK (STUDENT ONLY) ────────────────── %>
        <% if current_user.profileable_type == "StudentProfile" %>
          <div class="settings-pane" id="pane-skills">
            <div class="settings-card mb-24">

              <%# Pane Header with Taxonomy Stats & Reset %>
              <div class="settings-card-header mb-24 flex-between flex-wrap gap-16">
                <div class="flex-align-center gap-12">
                  <div class="settings-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                  </div>
                  <div>
                    <div class="flex-align-center gap-8 mb-4">
                      <h3 class="fs-17 fw-700 color-primary margin-0"><%= t('users.edit.skills_heading', default: 'Skills & Domain Taxonomy') %></h3>
                      <span class="cat-count-badge fs-10"><%= (@skills_by_category || {}).keys.count %> Domains &middot; <%= Skill.count %> Skills</span>
                    </div>
                    <p class="fs-12 text-muted margin-0"><%= t('users.edit.skills_subtext', default: 'Curate your verified skill matrix from 300+ competencies across 15 specialized domains') %></p>
                  </div>
                </div>
                <div class="flex-align-center gap-10">
                  <span class="skills-counter-badge" id="skills-live-counter" data-suffix="<%= j(strip_tags(t('users.edit.skills_count_label', default: 'Skills Selected'))) %>">
                    <span class="pulse-emerald-dot"></span>
                    <span id="skills-counter-text"><%= @profile.skill_ids.count %> <%= strip_tags(t('users.edit.skills_count_label', default: 'Skills Selected')) %></span>
                  </span>
                  <button type="button" class="btn btn-secondary btn-compact flex-align-center gap-6" id="btn-clear-skills" title="<%= t('users.edit.clear_skills', default: 'Clear All') %>">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    <span><%= t('users.edit.clear_skills', default: 'Clear All') %></span>
                  </button>
                </div>
              </div>

              <%# Active Selected Stack Top Showcase Box %>
              <div class="selected-stack-showcase-box mb-24" id="selected-stack-container">
                <div class="flex-between flex-align-center mb-12">
                  <div class="flex-align-center gap-8">
                    <span class="pulse-emerald-dot"></span>
                    <strong class="fs-13 fw-700 color-primary"><%= t('users.edit.selected_stack_label', default: 'My Selected Stack') %></strong>
                  </div>
                  <span class="fs-11 text-muted fw-600" id="selected-panel-count" data-suffix="<%= j(strip_tags(t('users.edit.picked_suffix', default: 'picked'))) %>">
                    <%= @profile.skill_ids.count %> <%= strip_tags(t('users.edit.picked_suffix', default: 'picked')) %>
                  </span>
                </div>
                
                <div class="selected-chips-flex-wrap" id="selected-chips-list">
                  <%# Dynamically populated by JS %>
                </div>

                <div class="empty-stack-placeholder <%= 'd-none' if @profile.skill_ids.any? %>" id="empty-stack-msg">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                  <span><%= t('users.edit.empty_stack_message', default: 'No skills selected yet. Click any skill pill below or search to assemble your stack.') %></span>
                </div>
              </div>

              <%# Command Bar: Search Input + Category Dropdown %>
              <div class="skills-search-toolbar mb-16">
                <div class="skill-search-input-wrapper flex-1">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" class="skill-search-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <input type="text" id="hub-skill-search" class="form-control hub-skill-search-field" placeholder="<%= j(strip_tags(t('users.edit.skill_search_placeholder', default: 'Search 300+ skills (e.g. Figma, Python, SolidWorks, Docker, Finance, React)...'))) %>">
                  <kbd class="search-kbd-hint" id="search-kbd-hint">⌘K</kbd>
                  <button type="button" class="search-clear-btn" id="search-clear-btn" aria-label="Clear Search" style="display: none;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  </button>
                </div>

                <div class="custom-cat-dropdown" id="custom-cat-dropdown">
                  <button type="button" class="custom-cat-trigger" id="custom-cat-trigger">
                    <span id="custom-cat-selected-text"><%= t('users.edit.all_domains_filter', default: 'All Domains') %> (<%= Skill.count %>)</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="select-chevron"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>

                  <div class="custom-cat-menu" id="custom-cat-menu">
                    <button type="button" class="custom-cat-option active" data-value="all">
                      <span class="flex-align-center gap-8">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 1 0 10 10H12Z"/></svg>
                        <span><%= t('users.edit.all_domains_filter', default: 'All Domains') %></span>
                      </span>
                      <span class="custom-opt-badge"><%= Skill.count %></span>
                    </button>
                    <% (@skills_by_category || {}).each do |cat_name, list| %>
                      <% icon_raw = cat_icons[cat_name] || default_cat_icon %>
                      <button type="button" class="custom-cat-option" data-value="<%= cat_name.parameterize %>">
                        <span class="flex-align-center gap-8 text-truncate">
                          <%= raw icon_raw %>
                          <span class="text-truncate"><%= cat_name %></span>
                        </span>
                        <span class="custom-opt-badge"><%= list.count %></span>
                      </button>
                    <% end %>
                  </div>
                </div>
              </div>

              <%# Quick-Filter Domain Carousel Pills Bar %>
              <div class="skills-domain-pills-bar mb-24" id="domain-quick-pills">
                <button type="button" class="domain-quick-pill active" data-target-cat="all">
                  <span><%= t('users.edit.all_domains_filter', default: 'All Domains') %></span>
                  <span class="pill-badge"><%= Skill.count %></span>
                </button>
                <% (@skills_by_category || {}).each do |cat_name, list| %>
                  <% short_label = cat_name.split(',').first.split('&').first.strip %>
                  <button type="button" class="domain-quick-pill" data-target-cat="<%= cat_name.parameterize %>" title="<%= cat_name %>">
                    <span><%= short_label %></span>
                    <span class="pill-badge"><%= list.count %></span>
                  </button>
                <% end %>
              </div>

              <%# Matrix Viewport Container for Domain Categories and Skills %>
              <div class="skills-matrix-viewport" id="skills-matrix-viewport">
                <div class="skills-categories-grid" id="skills-matrix">
                  <%= fields_for :student_profile, @profile do |sp| %>
                    <%= hidden_field_tag "student_profile[skill_ids][]", "" %>
                    <% (@skills_by_category || {}).each do |category_title, skills_arr| %>
                      <% slug = category_title.parameterize %>
                      <% cat_icon = cat_icons[category_title] || default_cat_icon %>
                      <div class="skills-cat-card" data-cat-slug="<%= slug %>">
                        <div class="skills-cat-header flex-between flex-align-center mb-14">
                          <div class="flex-align-center gap-10">
                            <span class="skills-cat-icon-wrap"><%= raw cat_icon %></span>
                            <h4 class="fs-14 fw-700 color-primary margin-0"><%= category_title %></h4>
                            <span class="cat-count-badge"><%= skills_arr.count %></span>
                          </div>
                          <div class="flex-align-center gap-8">
                            <span class="cat-active-pill" id="cat-active-pill-<%= slug %>" style="display: none;">0 active</span>
                            <button type="button" class="btn-cat-quick-toggle" data-cat-slug="<%= slug %>">
                              <span class="toggle-text"><%= t('users.edit.select_all_cat', default: 'Select All') %></span>
                            </button>
                          </div>
                        </div>

                        <div class="skills-chips-wrap">
                          <% skills_arr.each do |skill_obj| %>
                            <% selected = @profile.skill_ids.include?(skill_obj.id) %>
                            <div class="skill-chip-box <%= 'chip-active' if selected %>"
                                 data-skill-id="<%= skill_obj.id %>"
                                 data-skill-name="<%= skill_obj.name %>"
                                 data-skill-query="<%= skill_obj.name.downcase %>">
                              <%= check_box_tag "student_profile[skill_ids][]", skill_obj.id, selected, class: "skill-chip-checkbox" %>
                              <span class="chip-label-text"><%= skill_obj.name %></span>
                              <span class="chip-check-icon" aria-hidden="true">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                              </span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  <% end %>

                  <%# Empty Search Results State %>
                  <div class="skills-zero-results-card" id="skills-zero-results" style="display: none;">
                    <div class="zero-results-icon mb-12">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                    </div>
                    <h4 class="fs-15 fw-700 color-primary mb-6"><%= t('users.edit.no_skills_found', default: 'No skills found matching') %> "<span id="zero-query-text"></span>"</h4>
                    <p class="fs-12 text-muted margin-0 mb-14">Try searching with a broader keyword, domain acronym, or clear your query.</p>
                    <button type="button" class="btn btn-secondary btn-compact" id="btn-reset-search">Clear Search Query</button>
                  </div>
                </div>
              </div>

            </div>
          </div>
        <% end %>

        <%# ─── TAB PANE 3: RESUME & CV (STUDENT ONLY) ─────────────────── %>
        <% if current_user.profileable_type == "StudentProfile" %>
          <div class="settings-pane" id="pane-cv">
            <div class="settings-card mb-24">
              <div class="settings-card-header mb-24 flex-between flex-wrap gap-12">
                <div class="flex-align-center gap-12">
                  <div class="settings-icon-badge">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
                  </div>
                  <div>
                    <h3 class="fs-17 fw-700 color-primary margin-0"><%= t('users.edit.resume_heading', default: 'Resume & CV Document') %></h3>
                    <p class="fs-12 text-muted margin-0"><%= t('users.edit.resume_subtext', default: 'PDF document accessible by verified employers') %></p>
                  </div>
                </div>
              </div>

              <%= fields_for :student_profile, @profile do |sp| %>
                <% if @profile.cv.attached? %>
                  <div class="cv-active-card mb-24 flex-between flex-wrap gap-16">
                    <div class="flex-align-center gap-14">
                      <div class="pdf-file-badge">PDF</div>
                      <div>
                        <strong class="fs-14 color-primary block text-truncate"><%= @profile.cv.filename %></strong>
                        <span class="fs-12 text-muted"><%= number_to_human_size(@profile.cv.byte_size) %> &middot; Uploaded</span>
                      </div>
                    </div>
                    <div class="flex-align-center gap-8">
                      <%= link_to rails_blob_path(@profile.cv, disposition: "inline"), target: "_blank", class: "btn btn-secondary btn-compact flex-align-center gap-6" do %>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        <span><%= t('users.edit.preview_pdf', default: 'Preview PDF') %></span>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <div class="cv-dropzone-container" id="cv-dropzone">
                  <div class="cv-dropzone-icon mb-12">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  </div>
                  <div class="fs-14 fw-600 color-primary mb-4"><%= t('users.edit.dropzone_label', default: 'Drag & drop your PDF resume here') %></div>
                  <div class="fs-12 text-muted mb-16"><%= t('users.edit.dropzone_hint', default: 'PDF only · Maximum file size 5MB') %></div>
                  <label class="btn btn-primary btn-compact cursor-pointer">
                    <span><%= t('users.edit.browse_pdf', default: 'Browse PDF File') %></span>
                    <%= sp.file_field :cv, id: "cv-file-input", accept: "application/pdf", class: "d-none" %>
                  </label>
                  <div class="fs-12 text-emerald fw-600 mt-12 display-none" id="cv-selected-filename"></div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# ─── TAB PANE 4: ACCOUNT & SECURITY ────────────────────────── %>
        <div class="settings-pane" id="pane-security">
          <div class="settings-card mb-24">
            <div class="settings-card-header mb-24 flex-between flex-wrap gap-12">
              <div class="flex-align-center gap-12">
                <div class="settings-icon-badge">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                  <h3 class="fs-17 fw-700 color-primary margin-0"><%= t('users.edit.security_heading', default: 'Account Email & Credentials') %></h3>
                  <p class="fs-12 text-muted margin-0"><%= t('users.edit.security_subtext', default: 'Manage login credentials and security authentication') %></p>
                </div>
              </div>
            </div>

            <%# Sub-card A: Email %>
            <div class="security-subcard mb-24">
              <h4 class="fs-14 fw-600 color-primary mb-14 flex-align-center gap-8">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span><%= t('users.edit.email_address_label', default: 'Email Address') %></span>
              </h4>
              <div class="form-group margin-0">
                <%= f.label :email, t('users.edit.email', default: 'Account Email Address'), class: "form-label" %>
                <%= f.email_field :email, class: "form-control", autocomplete: "email", required: true %>
              </div>
            </div>

            <%# Sub-card B: Authentication & Security %>
            <div class="security-subcard mb-24">
              <h4 class="fs-14 fw-600 color-primary mb-14 flex-align-center gap-8">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span><%= t('users.edit.security_verification_label', default: 'Security Verification & Password Change') %></span>
              </h4>
              
              <div class="security-notice-box mb-20">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--warning)" stroke-width="2" class="flex-shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="fs-12 text-secondary"><%= t('users.edit.current_password_help', default: 'To change your email address or set a new password, you must first verify your current password.') %></span>
              </div>

              <div class="form-group mb-24">
                <%= f.label :current_password, t('users.edit.current_password', default: 'Current Password'), class: "form-label" %>
                <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password", placeholder: t('users.edit.current_password_placeholder', default: 'Enter your current password to authorize changes') %>
              </div>

              <div class="hairline-divider mb-24"></div>

              <div class="form-row-2">
                <div class="form-group margin-0">
                  <%= f.label :password, t('users.edit.new_password', default: 'New Password (Optional)'), class: "form-label" %>
                  <%= f.password_field :password, class: "form-control", id: "input-new-password", autocomplete: "new-password", readonly: true, placeholder: t('users.edit.leave_blank_placeholder', default: 'Leave blank to keep unchanged') %>
                  <%# Password Strength Meter %>
                  <div class="password-meter-bar mt-8">
                    <div class="meter-segment" id="meter-1"></div>
                    <div class="meter-segment" id="meter-2"></div>
                    <div class="meter-segment" id="meter-3"></div>
                    <div class="meter-segment" id="meter-4"></div>
                  </div>
                </div>
                <div class="form-group margin-0">
                  <%= f.label :password_confirmation, t('users.edit.confirm_password', default: 'Confirm New Password'), class: "form-label" %>
                  <%= f.password_field :password_confirmation, class: "form-control", id: "input-confirm-password", autocomplete: "new-password", readonly: true, placeholder: t('users.edit.confirm_password_placeholder', default: 'Repeat your new password') %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# Floating Dirty-State Unsaved Changes Bar %>
        <div class="floating-save-bar" id="floating-save-bar">
          <div class="flex-align-center gap-10">
            <span class="save-status-dot"></span>
            <span class="fs-13 fw-600 color-primary"><%= t('users.edit.unsaved_changes', default: 'You have unsaved profile changes') %></span>
          </div>
          <div class="flex-align-center gap-12">
            <%= link_to t('common.cancel', default: 'Cancel'), dashboard_path, class: "btn btn-secondary btn-compact" %>
            <%= f.submit t('users.edit.save_changes', default: 'Save Changes'), class: "btn btn-primary btn-compact px-20", data: { turbo_submits_with: t('users.edit.save_changes', default: 'Save Changes') } %>
          </div>
        </div>

      </div>

    </div>
  <% end %>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    function initMasterSettings() {
      // ─── 1. TAB SWITCHING ──────────────────────────────────────
      var navButtons = document.querySelectorAll('.settings-nav-item');
      var panes = document.querySelectorAll('.settings-pane');

      navButtons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var targetPaneId = btn.dataset.pane;

          navButtons.forEach(function(b) { b.classList.remove('active'); });
          panes.forEach(function(p) { p.classList.remove('active'); });

          btn.classList.add('active');
          var targetPane = document.getElementById(targetPaneId);
          if (targetPane) targetPane.classList.add('active');
        });
      });

      // ─── 2. LIVE MINI PROFILE PREVIEW ─────────────────────────
      var firstNameInput = document.getElementById('input-first-name');
      var lastNameInput = document.getElementById('input-last-name');
      var companyNameInput = document.getElementById('input-company-name');
      var previewNameText = document.getElementById('preview-name-text');
      var previewAvatarText = document.getElementById('preview-avatar-text');

      function updatePreviewName() {
        if (firstNameInput && lastNameInput && previewNameText) {
          var fname = firstNameInput.value.trim();
          var lname = lastNameInput.value.trim();
          if (fname || lname) {
            previewNameText.textContent = (fname + ' ' + lname).trim();
          }
          if (fname && previewAvatarText) {
            previewAvatarText.textContent = fname.charAt(0).toUpperCase();
          }
        } else if (companyNameInput && previewNameText) {
          var cname = companyNameInput.value.trim();
          if (cname) {
            previewNameText.textContent = cname;
            if (previewAvatarText) previewAvatarText.textContent = cname.charAt(0).toUpperCase();
          }
        }
      }

      if (firstNameInput) firstNameInput.addEventListener('input', updatePreviewName);
      if (lastNameInput) lastNameInput.addEventListener('input', updatePreviewName);
      if (companyNameInput) companyNameInput.addEventListener('input', updatePreviewName);

      // ─── 3. BIO CHARACTER COUNTER ──────────────────────────────
      var bioInput = document.getElementById('input-bio');
      var bioCounter = document.getElementById('bio-char-counter');

      if (bioInput && bioCounter) {
        function updateBioCount() {
          var len = bioInput.value.length;
          bioCounter.textContent = len + bioCounter.dataset.suffix;
          if (len >= 280) {
            bioCounter.style.color = '#EF4444';
          } else {
            bioCounter.style.color = 'var(--text-muted)';
          }
        }
        bioInput.addEventListener('input', updateBioCount);
        updateBioCount();
      }

      // ─── 4. SKILLS & TAXONOMY CONTROLS ─────────────────────────
      var chipBoxes = document.querySelectorAll('.skill-chip-box');
      var selectedChipsList = document.getElementById('selected-chips-list');
      var selectedPanelCount = document.getElementById('selected-panel-count');
      var liveCounterText = document.getElementById('skills-counter-text');
      var navBadge = document.getElementById('nav-skills-badge');
      var clearBtn = document.getElementById('btn-clear-skills');
      var searchInput = document.getElementById('hub-skill-search');
      var searchClearBtn = document.getElementById('search-clear-btn');
      var resetSearchBtn = document.getElementById('btn-reset-search');
      var catBlocks = document.querySelectorAll('.skills-cat-card');
      var domainPills = document.querySelectorAll('.domain-quick-pill');
      var emptyStackMsg = document.getElementById('empty-stack-msg');
      var zeroResultsCard = document.getElementById('skills-zero-results');
      var zeroQueryText = document.getElementById('zero-query-text');
      var activeCat = 'all';

      function syncSelectedPanel() {
        if (!selectedChipsList) return;
        selectedChipsList.innerHTML = '';
        var count = 0;
        var catCounts = {};

        chipBoxes.forEach(function(chip) {
          var chk = chip.querySelector('.skill-chip-checkbox');
          if (chk && chk.checked) {
            count++;
            var sName = chip.dataset.skillName || 'Skill';
            var sId = chip.dataset.skillId;
            var parentCard = chip.closest('.skills-cat-card');
            if (parentCard) {
              var slug = parentCard.dataset.catSlug;
              catCounts[slug] = (catCounts[slug] || 0) + 1;
            }

            var tag = document.createElement('div');
            tag.className = 'selected-panel-chip';
            tag.innerHTML = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="mr-2"><polyline points="20 6 9 17 4 12"/></svg><span>' + sName + '</span><button type="button" class="remove-chip-btn" data-id="' + sId + '" aria-label="Remove skill"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>';

            tag.querySelector('.remove-chip-btn').addEventListener('click', function(e) {
              e.stopPropagation();
              chk.checked = false;
              chip.classList.remove('chip-active');
              syncSelectedPanel();
            });

            selectedChipsList.appendChild(tag);
          }
        });

        // Update category active badges
        catBlocks.forEach(function(card) {
          var slug = card.dataset.catSlug;
          var actCount = catCounts[slug] || 0;
          var actPill = document.getElementById('cat-active-pill-' + slug);
          if (actPill) {
            if (actCount > 0) {
              actPill.textContent = actCount + ' selected';
              actPill.style.display = 'inline-flex';
            } else {
              actPill.style.display = 'none';
            }
          }
        });

        // Empty state visibility
        if (emptyStackMsg) {
          if (count === 0) {
            emptyStackMsg.classList.remove('d-none');
            emptyStackMsg.style.display = 'flex';
          } else {
            emptyStackMsg.classList.add('d-none');
            emptyStackMsg.style.display = 'none';
          }
        }

        var suffix = selectedPanelCount ? selectedPanelCount.dataset.suffix : 'picked';
        var liveSuffix = (liveCounterText && liveCounterText.parentElement) ? liveCounterText.parentElement.dataset.suffix : 'Skills Selected';

        if (selectedPanelCount) selectedPanelCount.textContent = count + ' ' + suffix;
        if (liveCounterText) liveCounterText.textContent = count + ' ' + liveSuffix;
        if (navBadge) navBadge.textContent = count;
      }

      chipBoxes.forEach(function(chip) {
        var chk = chip.querySelector('.skill-chip-checkbox');
        if (!chk) return;

        chip.addEventListener('click', function(e) {
          if (e.target !== chk) {
            chk.checked = !chk.checked;
          }
          if (chk.checked) {
            chip.classList.add('chip-active');
          } else {
            chip.classList.remove('chip-active');
          }
          var floatingSaveBar = document.getElementById('floating-save-bar');
          if (floatingSaveBar) floatingSaveBar.classList.add('bar-visible');
          syncSelectedPanel();
        });
      });

      // Select All / Clear per Category
      document.querySelectorAll('.btn-cat-quick-toggle').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var slug = btn.dataset.catSlug;
          var card = document.querySelector('.skills-cat-card[data-cat-slug="' + slug + '"]');
          if (!card) return;

          var checkboxes = card.querySelectorAll('.skill-chip-checkbox');
          var allChecked = Array.from(checkboxes).every(function(c) { return c.checked; });

          checkboxes.forEach(function(chk) {
            chk.checked = !allChecked;
            var box = chk.closest('.skill-chip-box');
            if (box) {
              if (!allChecked) {
                box.classList.add('chip-active');
              } else {
                box.classList.remove('chip-active');
              }
            }
          });

          var toggleSpan = btn.querySelector('.toggle-text');
          if (toggleSpan) {
            toggleSpan.textContent = allChecked ? '<%= t('users.edit.select_all_cat', default: 'Select All') %>' : '<%= t('users.edit.clear_cat', default: 'Clear') %>';
          }

          var floatingSaveBar = document.getElementById('floating-save-bar');
          if (floatingSaveBar) floatingSaveBar.classList.add('bar-visible');
          syncSelectedPanel();
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          document.querySelectorAll('.skill-chip-checkbox').forEach(function(chk) {
            chk.checked = false;
            var p = chk.closest('.skill-chip-box');
            if (p) p.classList.remove('chip-active');
          });
          var floatingSaveBar = document.getElementById('floating-save-bar');
          if (floatingSaveBar) floatingSaveBar.classList.add('bar-visible');
          syncSelectedPanel();
        });
      }

      // Filter skills matrix
      function filterSkills() {
        var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var totalVisibleCategories = 0;
        var matrixViewport = document.getElementById('skills-matrix-viewport');

        if (searchClearBtn) {
          searchClearBtn.style.display = query ? 'flex' : 'none';
        }

        if (matrixViewport) {
          if (activeCat === 'all' && !query) {
            matrixViewport.classList.remove('single-domain-mode');
          } else {
            matrixViewport.classList.add('single-domain-mode');
          }
        }

        catBlocks.forEach(function(block) {
          var slug = block.dataset.catSlug;
          var catMatch = (activeCat === 'all' || activeCat === slug);
          var hasVisible = false;

          var chips = block.querySelectorAll('.skill-chip-box');
          chips.forEach(function(chip) {
            var q = chip.dataset.skillQuery || '';
            var searchMatch = !query || q.includes(query);

            if (catMatch && searchMatch) {
              chip.style.display = 'inline-flex';
              hasVisible = true;
            } else {
              chip.style.display = 'none';
            }
          });

          if (hasVisible) {
            block.style.display = 'block';
            totalVisibleCategories++;
          } else {
            block.style.display = 'none';
          }
        });

        if (zeroResultsCard) {
          if (totalVisibleCategories === 0) {
            zeroResultsCard.style.display = 'block';
            if (zeroQueryText) zeroQueryText.textContent = query;
          } else {
            zeroResultsCard.style.display = 'none';
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterSkills);

        // Keyboard focus shortcut: Cmd+K or Ctrl+K or /
        document.addEventListener('keydown', function(e) {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            searchInput.focus();
            searchInput.select();
          }
        });
      }

      if (searchClearBtn) {
        searchClearBtn.addEventListener('click', function() {
          if (searchInput) {
            searchInput.value = '';
            filterSkills();
            searchInput.focus();
          }
        });
      }

      if (resetSearchBtn) {
        resetSearchBtn.addEventListener('click', function() {
          if (searchInput) {
            searchInput.value = '';
          }
          activeCat = 'all';
          updateDomainPillState('all');
          filterSkills();
        });
      }

      // Domain Quick Pills Carousel
      function updateDomainPillState(targetCat) {
        domainPills.forEach(function(p) {
          if (p.dataset.targetCat === targetCat) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });

        // Sync dropdown
        if (customOptions) {
          customOptions.forEach(function(opt) {
            if (opt.dataset.value === targetCat) {
              opt.classList.add('active');
              var titleText = opt.querySelector('span:first-child').textContent;
              var badgeText = opt.querySelector('.custom-opt-badge').textContent;
              if (customSelectedText) {
                customSelectedText.textContent = titleText + ' (' + badgeText + ')';
              }
            } else {
              opt.classList.remove('active');
            }
          });
        }
      }

      domainPills.forEach(function(pill) {
        pill.addEventListener('click', function(e) {
          e.preventDefault();
          var targetCat = pill.dataset.targetCat;
          activeCat = targetCat;
          updateDomainPillState(targetCat);
          filterSkills();
        });
      });

      // Custom Dropdown Controls
      var customDropdown = document.getElementById('custom-cat-dropdown');
      var customTrigger = document.getElementById('custom-cat-trigger');
      var customMenu = document.getElementById('custom-cat-menu');
      var customSelectedText = document.getElementById('custom-cat-selected-text');
      var customOptions = document.querySelectorAll('.custom-cat-option');

      if (customTrigger && customMenu) {
        customTrigger.addEventListener('click', function(e) {
          e.stopPropagation();
          customDropdown.classList.toggle('is-open');
        });

        customOptions.forEach(function(opt) {
          opt.addEventListener('click', function(e) {
            e.stopPropagation();
            customOptions.forEach(function(o) { o.classList.remove('active'); });
            opt.classList.add('active');
            activeCat = opt.dataset.value;

            var titleText = opt.querySelector('span:first-child').textContent;
            var badgeText = opt.querySelector('.custom-opt-badge').textContent;
            if (customSelectedText) {
              customSelectedText.textContent = titleText + ' (' + badgeText + ')';
            }

            updateDomainPillState(activeCat);
            customDropdown.classList.remove('is-open');
            filterSkills();
          });
        });

        document.addEventListener('click', function(e) {
          if (customDropdown && !customDropdown.contains(e.target)) {
            customDropdown.classList.remove('is-open');
          }
        });
      }

      // Initial Selected Stack sync
      syncSelectedPanel();

      // ─── 5. CV FILE SELECTION PREVIEW ─────────────────────────
      var cvInput = document.getElementById('cv-file-input');
      var cvNameBox = document.getElementById('cv-selected-filename');
      var cvDropzone = document.getElementById('cv-dropzone');

      if (cvInput && cvNameBox) {
        cvInput.addEventListener('change', function() {
          if (cvInput.files && cvInput.files[0]) {
            cvNameBox.textContent = '<%= t('users.edit.selected_file_prefix', default: 'Selected:') %> ' + cvInput.files[0].name;
            cvNameBox.style.display = 'block';
            var floatingSaveBar = document.getElementById('floating-save-bar');
            if (floatingSaveBar) floatingSaveBar.classList.add('bar-visible');
          }
        });
      }

      if (cvDropzone && cvInput) {
        ['dragenter', 'dragover'].forEach(function(eventName) {
          cvDropzone.addEventListener(eventName, function(e) {
            e.preventDefault();
            cvDropzone.classList.add('dropzone-dragover');
          });
        });

        ['dragleave', 'drop'].forEach(function(eventName) {
          cvDropzone.addEventListener(eventName, function(e) {
            e.preventDefault();
            cvDropzone.classList.remove('dropzone-dragover');
          });
        });

        cvDropzone.addEventListener('drop', function(e) {
          if (e.dataTransfer.files && e.dataTransfer.files.length) {
            cvInput.files = e.dataTransfer.files;
            cvNameBox.textContent = '<%= t('users.edit.selected_file_prefix', default: 'Selected:') %> ' + e.dataTransfer.files[0].name;
            cvNameBox.style.display = 'block';
            var floatingSaveBar = document.getElementById('floating-save-bar');
            if (floatingSaveBar) floatingSaveBar.classList.add('bar-visible');
          }
        });
      }

      // ─── 6. PASSWORD STRENGTH METER ────────────────────────────
      var passInput = document.getElementById('input-new-password');
      if (passInput) {
        passInput.addEventListener('input', function() {
          var val = passInput.value;
          var score = 0;
          if (val.length >= 8) score++;
          if (/[A-Z]/.test(val)) score++;
          if (/[0-9]/.test(val)) score++;
          if (/[^A-Za-z0-9]/.test(val)) score++;

          for (var i = 1; i <= 4; i++) {
            var el = document.getElementById('meter-' + i);
            if (el) {
              if (val.length > 0 && i <= score) {
                el.className = 'meter-segment active-' + score;
              } else {
                el.className = 'meter-segment';
              }
            }
          }
        });
      }

      // ─── 7. FLOATING DIRTY STATE SAVE BAR ──────────────────────
      var mainForm = document.getElementById('settings-main-form');
      var floatingSaveBar = document.getElementById('floating-save-bar');
      if (mainForm && floatingSaveBar) {
        function handleDirtyState(e) {
          if (!e.target) return;
          if (e.target.id === 'hub-skill-search' || e.target.classList.contains('hub-skill-search-field') || e.target.classList.contains('no-dirty-track')) {
            return;
          }
          floatingSaveBar.classList.add('bar-visible');
        }
        mainForm.addEventListener('input', handleDirtyState);
        mainForm.addEventListener('change', handleDirtyState);

        // Client-side validation to require current_password if changing email/password
        var currentPassInput = document.getElementById('user_current_password');
        var emailInput = document.getElementById('user_email');
        var originalEmail = emailInput ? emailInput.value : '';

        mainForm.addEventListener('submit', function(e) {
          var needsCurrent = false;
          
          if (passInput && passInput.value.length > 0) {
            needsCurrent = true;
          }
          
          if (emailInput && emailInput.value.trim().toLowerCase() !== originalEmail.trim().toLowerCase()) {
            needsCurrent = true;
          }

          if (needsCurrent && currentPassInput && currentPassInput.value.trim() === '') {
            e.preventDefault();
            
            alert("<%= escape_javascript(t('users.edit.current_password_required_js', default: 'Please enter your current password to save security changes.')) %>");
            
            currentPassInput.style.borderColor = '#EF4444';
            currentPassInput.focus();
            
            var submitBtn = mainForm.querySelector('[type="submit"]');
            if (submitBtn) {
              setTimeout(function() { submitBtn.disabled = false; }, 100);
            }
          }
        });

        // Remove readonly from password fields on interaction
        var confirmPassInput = document.getElementById('input-confirm-password');
        function removeReadonly(e) {
          e.target.removeAttribute('readonly');
        }
        if (passInput) {
          passInput.addEventListener('focus', removeReadonly);
          passInput.addEventListener('click', removeReadonly);
        }
        if (confirmPassInput) {
          confirmPassInput.addEventListener('focus', removeReadonly);
          confirmPassInput.addEventListener('click', removeReadonly);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMasterSettings);
    } else {
      initMasterSettings();
    }
    document.addEventListener('turbo:load', initMasterSettings);
  })();
</script>
