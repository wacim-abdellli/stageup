<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title"><%= t('registrations.new_student.title') %></h2>
      <p class="auth-subtitle"><%= t('registrations.new_student.subtitle') %></p>
    </div>

    <%= form_with scope: :student_profile, url: student_registration_path do |f| %>
      
      <!-- Display Validation Errors from both Profile and User -->
      <% errors = (@student_profile.errors.full_messages + @user.errors.full_messages).uniq %>
      <% if errors.any? %>
        <div class="flash-message flash-alert flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
            <strong><%= t('registrations.new_student.errors_title') %></strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="first_name"><%= t('registrations.new_student.form.first_name') %></label>
          <%= f.text_field :first_name, value: @student_profile.first_name, id: "first_name", class: "form-control", placeholder: t('registrations.new_student.form.first_name_placeholder'), required: true %>
        </div>

        <div class="form-group">
          <label class="form-label" for="last_name"><%= t('registrations.new_student.form.last_name') %></label>
          <%= f.text_field :last_name, value: @student_profile.last_name, id: "last_name", class: "form-control", placeholder: t('registrations.new_student.form.last_name_placeholder'), required: true %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="phone"><%= t('registrations.new_student.form.phone') %></label>
        <%= f.telephone_field :phone, value: @student_profile.phone, id: "phone", class: "form-control", placeholder: t('registrations.new_student.form.phone_placeholder') %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="major"><%= t('registrations.new_student.form.major') %></label>
          <%= f.text_field :major, value: @student_profile.major, id: "major", class: "form-control", placeholder: t('registrations.new_student.form.major_placeholder') %>
        </div>

        <div class="form-group">
          <label class="form-label" for="graduation_year"><%= t('registrations.new_student.form.graduation_year') %></label>
          <%= f.number_field :graduation_year, value: @student_profile.graduation_year || Time.current.year + 1, id: "graduation_year", class: "form-control", placeholder: t('registrations.new_student.form.graduation_year_placeholder') %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="bio"><%= t('registrations.new_student.form.bio') %></label>
        <%= f.text_area :bio, value: @student_profile.bio, id: "bio", class: "form-control", rows: 3, placeholder: t('registrations.new_student.form.bio_placeholder') %>
      </div>

      <!-- Nested User Fields -->
      <%= fields_for :user, @user do |u| %>
        <div class="form-group">
          <label class="form-label" for="user_email"><%= t('registrations.new_student.form.email') %></label>
          <%= u.email_field :email, id: "user_email", class: "form-control", placeholder: t('registrations.new_student.form.email_placeholder'), required: true %>
          <small class="hint-text">
            <%= t('registrations.new_student.form.email_hint') %>
          </small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="user_password"><%= t('registrations.new_student.form.password') %></label>
            <div class="pw-wrap">
              <%= u.password_field :password, id: "user_password", class: "form-control", placeholder: "••••••••", required: true %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="user_password_confirmation"><%= t('registrations.new_student.form.password_confirmation') %></label>
            <div class="pw-wrap">
              <%= u.password_field :password_confirmation, id: "user_password_confirmation", class: "form-control", placeholder: "••••••••", required: true %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <button type="submit" class="btn btn-primary btn-mt" data-turbo-submits-with="<%= t('registrations.new_student.form.submitting') %>">
        <%= t('registrations.new_student.form.submit') %>
      </button>
    <% end %>

    <div class="auth-footer mt-25">
      <%= t('registrations.new_student.not_student') %> <%= link_to t('registrations.new_student.back'), select_role_path %>
    </div>
  </div>
</div>
