<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title"><%= t('registrations.new_university.title') %></h2>
      <p class="auth-subtitle"><%= t('registrations.new_university.subtitle') %></p>
    </div>

    <%= form_with scope: :university_profile, url: university_registration_path do |f| %>
      
      <!-- Display Validation Errors -->
      <% errors = (@university_profile.errors.full_messages + @user.errors.full_messages).uniq %>
      <% if errors.any? %>
        <div class="flash-message flash-alert flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
            <strong><%= t('registrations.new_university.errors_title') %></strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <label class="form-label" for="university_id"><%= t('registrations.new_university.form.university') %></label>
        <%= f.collection_select :university_id, @universities, :id, :name, { prompt: t('registrations.new_university.form.university_placeholder') }, { id: "university_id", class: "form-control", required: true } %>
      </div>

      <div class="form-group">
        <label class="form-label" for="admin_name"><%= t('registrations.new_university.form.admin_name') %></label>
        <%= f.text_field :admin_name, value: @university_profile.admin_name, id: "admin_name", class: "form-control", placeholder: t('registrations.new_university.form.admin_name_placeholder'), required: true %>
      </div>

      <div class="form-group">
        <label class="form-label" for="department"><%= t('registrations.new_university.form.department') %></label>
        <%= f.text_field :department, value: @university_profile.department, id: "department", class: "form-control", placeholder: t('registrations.new_university.form.department_placeholder'), required: true %>
      </div>

      <!-- Nested User Fields -->
      <%= fields_for :user, @user do |u| %>
        <div class="form-group">
          <label class="form-label" for="user_email"><%= t('registrations.new_university.form.email') %></label>
          <%= u.email_field :email, id: "user_email", class: "form-control", placeholder: t('registrations.new_university.form.email_placeholder'), required: true %>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="user_password"><%= t('registrations.new_university.form.password') %></label>
            <div class="pw-wrap">
              <%= u.password_field :password, id: "user_password", class: "form-control", placeholder: "••••••••", required: true %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="user_password_confirmation"><%= t('registrations.new_university.form.password_confirmation') %></label>
            <div class="pw-wrap">
              <%= u.password_field :password_confirmation, id: "user_password_confirmation", class: "form-control", placeholder: "••••••••", required: true %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="Toggle password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <button type="submit" class="btn btn-primary btn-mt" data-turbo-submits-with="<%= t('registrations.new_university.form.submitting') %>">
        <%= t('registrations.new_university.form.submit') %>
      </button>
    <% end %>

    <div class="auth-footer mt-25">
      <%= t('registrations.new_university.not_coordinator') %> <%= link_to t('registrations.new_university.back'), select_role_path %>
    </div>
  </div>
</div>
