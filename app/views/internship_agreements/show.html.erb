<% content_for :title, "Convention de Stage – StageUp" %>
<% student = @agreement.student_profile %>
<% company = @agreement.submission.offer.company_profile %>
<% university = @agreement.university %>

<div class="agreement-container">
  <div class="agreement-action-bar hide-on-print">
    <%= link_to dashboard_path, class: "btn btn-secondary" do %>
      <i data-lucide="arrow-left"></i>
      Dashboard
    <% end %>
    <button id="print-btn" class="btn btn-secondary">
      <i data-lucide="printer"></i>
      Print / Save as PDF
    </button>
  </div>
  <div class="agreement-card">

    <% if @agreement.status == "declined" %>
      <div class="agreement-declined-banner">
        <p class="agreement-declined-title">
          <i data-lucide="x-circle" class="icon-16 stroke-danger"></i>
          Agreement Declined
        </p>
        <p class="agreement-declined-reason"><strong>Reason:</strong> <%= @agreement.rejection_reason %></p>
        <p class="agreement-declined-by">Declined by <%= university&.name %> coordinator</p>
      </div>
    <% end %>

    <div class="agreement-header">
      <h1 class="agreement-title">CONVENTION DE STAGE</h1>
      <p class="agreement-subtitle">This agreement is made in accordance with Tunisian law governing internship programmes.</p>
    </div>

    <% if @agreement.status == "fully_executed" && @agreement.verification_token.present? %>
      <div class="cert-banner hide-on-print mb-24">
        <div class="cert-banner-left">
          <svg class="icon-18 icon-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
          <div>
            <strong class="cert-banner-title">Certificate Available</strong>
            <p class="cert-banner-sub">This internship is fully executed and publicly verifiable.</p>
          </div>
        </div>
        <%= link_to "Open Public Certificate →",
            verify_certificate_path(token: @agreement.verification_token),
            class: "btn btn-primary btn-compact",
            target: "_blank" %>
      </div>
    <% end %>

    <div class="text-center mb-30">
      <% if @agreement.status == "fully_executed" %>
        <span class="badge-status badge-completed fs-14 pill-lg">
          FULLY EXECUTED — All parties have signed
        </span>
        <div class="mt-10 hide-on-print">
          <button type="button" id="print-btn-2" class="btn btn-secondary">Print / Save PDF</button>
        </div>
      <% elsif @agreement.status == "declined" %>
        <span class="badge-status badge-declined fs-14 pill-lg">
          DECLINED — University rejected this agreement
        </span>
      <% else %>
        <span class="badge-status badge-pending fs-14 pill-lg">
          PENDING SIGNATURES — Awaiting: <%= @agreement.pending_signatories.join(", ") %>
        </span>
      <% end %>
    </div>

    <div class="mb-30">
      <h2 class="agreement-article-title">Article 1 — Parties</h2>
      <p class="agreement-text">
        This Convention de Stage is entered into between the following three parties:
      </p>
      <ul class="agreement-list">
        <li><strong class="text-primary">The Student:</strong> <%= student.first_name %> <%= student.last_name %>, enrolled at <%= university&.name || "an affiliated university" %> (<%= student.major.presence || "No major specified" %>)</li>
        <li><strong class="text-primary">The Employer:</strong> <%= company.name %>, registered in Tunisia</li>
        <li><strong class="text-primary">The University:</strong> <%= university&.name || "Independent / Self-declared" %></li>
      </ul>
    </div>

    <div class="mb-30">
      <h2 class="agreement-article-title">Article 2 — Dates & Duration</h2>
      <p class="agreement-text">
        The internship shall commence on <strong class="text-primary"><%= @agreement.start_date.strftime("%B %d, %Y") %></strong> 
        and conclude on <strong class="text-primary"><%= @agreement.end_date.strftime("%B %d, %Y") %></strong>.
      </p>
      <p class="agreement-text mt-8">
        Total duration: <strong class="text-primary"><%= (@agreement.end_date - @agreement.start_date).to_i %> days</strong>.
      </p>
    </div>

    <div class="mb-30">
      <h2 class="agreement-article-title">Article 3 — Internship Subject</h2>
      <p class="agreement-text">
        <%= student.first_name %> shall carry out an internship titled <strong class="text-primary">"<%= @agreement.submission.offer.title %>"</strong> 
        at <%= company.name %> under the terms described in the original offer.
      </p>
    </div>

    <div class="border-top pt-30">
      <h2 class="agreement-article-title">Signatures</h2>
      <p class="text-muted fs-13 mb-25">
        Each party must sign below for this agreement to be fully executed. Once all three signatures are present, the status will automatically update to "Fully Executed".
      </p>

      <div class="agreement-signatures-grid">
        <div class="agreement-sign-box<%= ' awaiting-mine' if !@agreement.student_signed_at && current_user.profileable_type == "StudentProfile" && current_user.profileable == student && @agreement.status != "declined" %>">
          <i data-lucide="graduation-cap" class="icon-20 mb-8 stroke-muted"></i>
          <h3 class="agreement-sign-box-title">Student</h3>
          <p class="agreement-sign-box-name"><%= student.first_name %> <%= student.last_name %></p>
          <% if @agreement.student_signed_at %>
            <div class="agreement-signed-badge">
              <span class="agreement-signed-label">Signed</span>
              <p class="agreement-signed-date"><%= @agreement.student_signed_at.strftime("%B %d, %Y at %H:%M") %></p>
            </div>
          <% else %>
            <% if current_user.profileable_type == "StudentProfile" && current_user.profileable == student && @agreement.status != "declined" %>
              <%= button_to "Sign Agreement", sign_submission_internship_agreement_path(@submission, @agreement), method: :post, class: "btn btn-primary btn-compact", data: { disable_with: "Signing…" } %>
            <% else %>
              <span class="agreement-unsigned-label">Not signed yet</span>
            <% end %>
          <% end %>
        </div>

        <div class="agreement-sign-box<%= ' awaiting-mine' if !@agreement.company_signed_at && current_user.profileable_type == "CompanyProfile" && current_user.profileable == company && @agreement.status != "declined" %>">
          <i data-lucide="briefcase" class="icon-20 mb-8 stroke-muted"></i>
          <h3 class="agreement-sign-box-title">Employer</h3>
          <p class="agreement-sign-box-name"><%= company.name %></p>
          <% if @agreement.company_signed_at %>
            <div class="agreement-signed-badge">
              <span class="agreement-signed-label">Signed</span>
              <p class="agreement-signed-date"><%= @agreement.company_signed_at.strftime("%B %d, %Y at %H:%M") %></p>
            </div>
          <% else %>
            <% if current_user.profileable_type == "CompanyProfile" && current_user.profileable == company && @agreement.status != "declined" %>
              <%= button_to "Sign Agreement", sign_submission_internship_agreement_path(@submission, @agreement), method: :post, class: "btn btn-primary btn-compact", data: { disable_with: "Signing…" } %>
            <% else %>
              <span class="agreement-unsigned-label">Not signed yet</span>
            <% end %>
          <% end %>
        </div>

        <div class="agreement-sign-box<%= ' awaiting-mine' if !@agreement.university_signed_at && current_user.profileable_type == "UniversityProfile" && @submission.student_profile.university_id == current_user.profileable.university_id && @agreement.status != "declined" %>">
          <i data-lucide="landmark" class="icon-20 mb-8 stroke-muted"></i>
          <h3 class="agreement-sign-box-title">University Coordinator</h3>
          <p class="agreement-sign-box-name"><%= university&.name || "Independent" %></p>
          <% if @agreement.university_signed_at %>
            <div class="agreement-signed-badge">
              <span class="agreement-signed-label">Signed</span>
              <p class="agreement-signed-date"><%= @agreement.university_signed_at.strftime("%B %d, %Y at %H:%M") %></p>
            </div>
          <% else %>
            <% if current_user.profileable_type == "UniversityProfile" && @submission.student_profile.university_id == current_user.profileable.university_id && @agreement.status != "declined" %>
              <%= button_to "Sign Agreement", sign_submission_internship_agreement_path(@submission, @agreement), method: :post, class: "btn btn-primary btn-compact", data: { disable_with: "Signing…" } %>
              <div class="mt-10">
                <button type="button" class="btn btn-secondary btn-compact" onclick="document.getElementById('decline-form').classList.toggle('d-none')">Decline Agreement</button>
              </div>
            <% else %>
              <span class="agreement-unsigned-label">Not signed yet</span>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if current_user.profileable_type == "UniversityProfile" && @agreement.status == "pending_signatures" && @submission.student_profile.university_id == current_user.profileable.university_id %>
        <div id="decline-form" class="decline-form-wrapper d-none">
          <%= form_with model: [@submission, @agreement], url: decline_submission_internship_agreement_path(@submission, @agreement), method: :post, local: true do |f| %>
            <label class="fs-12 text-secondary fw-600 mb-4 block">Reason for declining:</label>
            <%= text_area_tag :rejection_reason, nil, placeholder: "Explain why this agreement is being declined...", class: "decline-textarea", required: true %>
            <div class="decline-actions">
              <button type="button" class="btn btn-secondary btn-compact-sm" onclick="document.getElementById('decline-form').classList.add('d-none')">Cancel</button>
              <%= f.submit "Confirm Decline", class: "btn btn-secondary btn-compact-sm btn-decline-confirm", data: { disable_with: "Declining…" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="agreement-back-row">
      <%= link_to "← Back to Dashboard", dashboard_path, class: "btn btn-secondary agreement-back-link" %>
    </div>
  </div>
</div>
<%= javascript_tag nonce: true do %>
  document.getElementById('print-btn')?.addEventListener('click', function() { window.print(); });
  document.getElementById('print-btn-2')?.addEventListener('click', function() { window.print(); });
<% end %>
