<% student = @agreement.student_profile %>
<% company = @agreement.submission.offer.company_profile %>
<% university = @agreement.university %>

<div class="agreement-container">
  <div class="agreement-card">

    <% if flash[:notice] %>
      <div class="flash-message flash-notice">
        <i data-lucide="check-circle" class="icon-16 flex-shrink-0" style="stroke: #34D399;"></i>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="flash-message flash-alert">
        <i data-lucide="alert-circle" class="icon-16 flex-shrink-0" style="stroke: #F87171;"></i>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <!-- Document Header -->
    <div class="agreement-header">
      <h1 class="agreement-title">CONVENTION DE STAGE</h1>
      <p class="agreement-subtitle">This agreement is made in accordance with Tunisian law governing internship programmes.</p>
    </div>

    <!-- Agreement Status Badge -->
    <div class="text-center mb-30">
      <% if @agreement.status == "fully_executed" %>
        <span class="badge-status badge-completed fs-14" style="padding: 6px 18px;">
          ✓ FULLY EXECUTED — All parties have signed
        </span>
      <% else %>
        <span class="badge-status badge-pending fs-14" style="padding: 6px 18px;">
          ⏳ PENDING SIGNATURES — Awaiting: <%= @agreement.pending_signatories.join(", ") %>
        </span>
      <% end %>
    </div>

    <!-- Article 1: Parties -->
    <div class="mb-30">
      <h2 class="agreement-article-title">Article 1 — Parties</h2>
      <p class="agreement-text">
        This Convention de Stage is entered into between the following three parties:
      </p>
      <ul class="agreement-list">
        <li><strong style="color: var(--text-primary);">The Student:</strong> <%= student.first_name %> <%= student.last_name %>, enrolled at <%= university&.name || "an affiliated university" %> (<%= student.major.presence || "No major specified" %>)</li>
        <li><strong style="color: var(--text-primary);">The Employer:</strong> <%= company.name %>, registered in Tunisia</li>
        <li><strong style="color: var(--text-primary);">The University:</strong> <%= university&.name || "Independent / Self-declared" %></li>
      </ul>
    </div>

    <!-- Article 2: Dates -->
    <div class="mb-30">
      <h2 class="agreement-article-title">Article 2 — Dates & Duration</h2>
      <p class="agreement-text">
        The internship shall commence on <strong style="color: var(--text-primary);"><%= @agreement.start_date.strftime("%B %d, %Y") %></strong> 
        and conclude on <strong style="color: var(--text-primary);"><%= @agreement.end_date.strftime("%B %d, %Y") %></strong>.
      </p>
      <p class="agreement-text mt-8">
        Total duration: <strong style="color: var(--text-primary);"><%= (@agreement.end_date - @agreement.start_date).to_i %> days</strong>.
      </p>
    </div>

    <!-- Article 3: Subject -->
    <div class="mb-30">
      <h2 class="agreement-article-title">Article 3 — Internship Subject</h2>
      <p class="agreement-text">
        <%= student.first_name %> shall carry out an internship titled <strong style="color: var(--text-primary);">"<%= @agreement.submission.offer.title %>"</strong> 
        at <%= company.name %> under the terms described in the original offer.
      </p>
    </div>

    <!-- Signatures Panel -->
    <div class="border-top pt-30">
      <h2 class="agreement-article-title">Signatures</h2>
      <p class="text-muted fs-13 mb-25">
        Each party must sign below for this agreement to be fully executed. Once all three signatures are present, the status will automatically update to "Fully Executed".
      </p>

      <div class="agreement-signatures-grid">
        <!-- Student Signature Box -->
        <div class="agreement-sign-box">
          <i data-lucide="graduation-cap" class="icon-20" style="stroke: var(--text-muted); margin-bottom: 8px;"></i>
          <h3 class="agreement-sign-box-title">Student</h3>
          <p class="agreement-sign-box-name"><%= student.first_name %> <%= student.last_name %></p>
          <% if @agreement.student_signed_at %>
            <div class="agreement-signed-badge">
              <span class="agreement-signed-label">✓ Signed</span>
              <p class="agreement-signed-date"><%= @agreement.student_signed_at.strftime("%B %d, %Y at %H:%M") %></p>
            </div>
          <% else %>
            <% if current_user.profileable_type == "StudentProfile" && current_user.profileable == student %>
              <%= button_to "Sign Agreement", sign_submission_internship_agreement_path(@submission, @agreement), method: :post, class: "btn btn-primary btn-compact" %>
            <% else %>
              <span class="agreement-unsigned-label">Not signed yet</span>
            <% end %>
          <% end %>
        </div>

        <!-- Employer Signature Box -->
        <div class="agreement-sign-box">
          <i data-lucide="briefcase" class="icon-20" style="stroke: var(--text-muted); margin-bottom: 8px;"></i>
          <h3 class="agreement-sign-box-title">Employer</h3>
          <p class="agreement-sign-box-name"><%= company.name %></p>
          <% if @agreement.company_signed_at %>
            <div class="agreement-signed-badge">
              <span class="agreement-signed-label">✓ Signed</span>
              <p class="agreement-signed-date"><%= @agreement.company_signed_at.strftime("%B %d, %Y at %H:%M") %></p>
            </div>
          <% else %>
            <% if current_user.profileable_type == "CompanyProfile" && current_user.profileable == company %>
              <%= button_to "Sign Agreement", sign_submission_internship_agreement_path(@submission, @agreement), method: :post, class: "btn btn-primary btn-compact" %>
            <% else %>
              <span class="agreement-unsigned-label">Not signed yet</span>
            <% end %>
          <% end %>
        </div>

        <!-- University Signature Box -->
        <div class="agreement-sign-box">
          <i data-lucide="landmark" class="icon-20" style="stroke: var(--text-muted); margin-bottom: 8px;"></i>
          <h3 class="agreement-sign-box-title">University Coordinator</h3>
          <p class="agreement-sign-box-name"><%= university&.name || "Independent" %></p>
          <% if @agreement.university_signed_at %>
            <div class="agreement-signed-badge">
              <span class="agreement-signed-label">✓ Signed</span>
              <p class="agreement-signed-date"><%= @agreement.university_signed_at.strftime("%B %d, %Y at %H:%M") %></p>
            </div>
          <% else %>
            <% if current_user.profileable_type == "UniversityProfile" && @submission.student_profile.university_id == current_user.profileable.university_id %>
              <%= button_to "Sign Agreement", sign_submission_internship_agreement_path(@submission, @agreement), method: :post, class: "btn btn-primary btn-compact" %>
            <% else %>
              <span class="agreement-unsigned-label">Not signed yet</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Back Button -->
    <div class="agreement-back-row">
      <%= link_to "← Back to Dashboard", dashboard_path, class: "btn btn-secondary agreement-back-link" %>
    </div>
  </div>
</div>
