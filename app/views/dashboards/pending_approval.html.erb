<div class="dashboard-container">
  <div class="dashboard-header">
    <div>
      <%= render "layouts/navbar_brand" %>
      <p class="text-secondary fs-14"><%= t('dashboard.pending_approval.logged_in_as') %> <strong><%= current_user.email %></strong></p>
    </div>
    <div>
      <%= button_to t('nav.sign_out'), destroy_user_session_path, method: :delete, class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="profile-card profile-card-centered">
    <div class="pending-icon-row">
      <i data-lucide="lock" class="pending-lock-icon"></i>
    </div>
    <h2 class="pending-title"><%= t('dashboard.pending_approval.title') %></h2>
    <p class="pending-text">
      <%= t('dashboard.pending_approval.registration_thanks', university: @profile.university.name, department: @profile.department) %>
      <%= t('dashboard.pending_approval.privacy_notice') %>
    </p>

    <div class="pending-info-card">
      <h3 class="pending-info-title"><%= t('dashboard.pending_approval.what_next') %></h3>
      <ul class="pending-info-list">
        <li><%= t('dashboard.pending_approval.step1') %></li>
        <li><%= t('dashboard.pending_approval.step2') %></li>
        <li><%= t('dashboard.pending_approval.step3') %></li>
      </ul>
    </div>

    <p class="pending-contact">
      <%= t('dashboard.pending_approval.contact', email: "support@stageup.tn") %>
    </p>
  </div>
</div>
