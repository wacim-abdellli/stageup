<div class="dashboard-container">
  <div class="dashboard-header">
    <div>
      <%= render "layouts/navbar_brand" %>
      <p class="text-secondary fs-14">Logged in as: <strong><%= current_user.email %></strong></p>
    </div>
    <div>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <div class="profile-card profile-card-centered">
    <div class="pending-icon-row">
      <i data-lucide="lock" class="pending-lock-icon"></i>
    </div>
    <h2 class="pending-title">Verification Pending</h2>
    <p class="pending-text">
      Thank you for registering as a coordinator for <strong><%= @profile.university.name %></strong> (<%= @profile.department %>). 
      To protect student data privacy, coordinator dashboards must be verified by StageUp administrators before activation.
    </p>

    <div class="pending-info-card">
      <h3 class="pending-info-title">What happens next?</h3>
      <ul class="pending-info-list">
        <li>We will verify your official university email domain.</li>
        <li>We may contact your department head or review university records.</li>
        <li>Once approved, you will receive a notification email and full access will be unlocked.</li>
      </ul>
    </div>

    <p class="pending-contact">
      Need urgent activation? Contact us at <a href="mailto:support@stageup.tn">support@stageup.tn</a>.
    </p>
  </div>
</div>
