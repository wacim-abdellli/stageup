<% content_for :title, "Dashboard – StageUp" %>

<div class="dashboard-container">

  <%# ─── Dashboard Welcome Hero ───────────────────────────────────── %>
  <div class="dash-welcome">
    <div class="dash-welcome-inner">
      <div>
        <h1 class="dash-welcome-title">
          Welcome back<% if @profile.respond_to?(:first_name) && @profile.first_name.present? %>, <%= @profile.first_name %><% elsif @profile.respond_to?(:name) && @profile.name.present? %>, <%= @profile.name %><% end %>
        </h1>
        <p class="dash-welcome-sub">
          <% if @role_type == "StudentProfile" %>
            Manage your applications, track internship progress, and build your commitment score.
          <% elsif @role_type == "CompanyProfile" %>
            Review student applicants, publish proof missions, and manage active internship offers.
          <% else %>
            Monitor student internship agreements and track university partner commitments.
          <% end %>
        </p>
      </div>
      <div class="dash-welcome-meta">
        <span class="dash-date-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          <span><%= Date.today.strftime("%B %d, %Y") %></span>
        </span>
      </div>
    </div>
  </div>

  <div class="dashboard-grid">

    <%# ─── Left Main Column ───────────────────────────────────────── %>
    <div class="left-col">

      <%# ─── Profile Bento Card ────────────────────────────────────── %>
      <div class="profile-card mb-30">
        <div class="section-heading-row">
          <div class="section-title-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <h2>My Profile</h2>
          </div>
          <div class="section-heading-row-right">
            <% if @role_type == "StudentProfile" %>
              <span class="badge badge-info">Student</span>
            <% elsif @role_type == "CompanyProfile" %>
              <span class="badge badge-info">Company</span>
            <% else %>
              <span class="badge badge-info">University</span>
            <% end %>
            <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-secondary btn-compact" %>
          </div>
        </div>

        <div class="profile-bento-grid">
          <% if @role_type == "StudentProfile" %>
            <div class="profile-bento-item">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Full Name
              </span>
              <span class="bento-value"><%= @profile.first_name %> <%= @profile.last_name %></span>
            </div>

            <div class="profile-bento-item">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Phone
              </span>
              <span class="bento-value">
                <% student_phone = @profile.respond_to?(:phone) ? @profile.phone : (@profile.respond_to?(:phone_number) ? @profile.phone_number : nil) %>
                <%= student_phone.presence || "Not specified" %>
              </span>
            </div>

            <div class="profile-bento-item">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                Major
              </span>
              <span class="bento-value">
                <% student_major = @profile.respond_to?(:major) ? @profile.major : (@profile.respond_to?(:field_of_study) ? @profile.field_of_study : nil) %>
                <%= student_major.presence || "Not specified" %>
              </span>
            </div>

            <div class="profile-bento-item">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                Graduation Year
              </span>
              <span class="bento-value"><%= @profile.graduation_year.presence || "Not specified" %></span>
            </div>

            <div class="profile-bento-item">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                University
              </span>
              <span class="bento-value">
                <% if @profile.respond_to?(:university) && @profile.university %>
                  <%= @profile.university.name %>
                <% else %>
                  <span class="text-muted italic">Self-declared / Unassociated</span>
                <% end %>
              </span>
            </div>

            <div class="profile-bento-item">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                Skills
              </span>
              <span class="bento-value">
                <% if @profile.respond_to?(:skills) && @profile.skills.any? %>
                  <%= @profile.skills.map(&:name).join(", ") %>
                <% else %>
                  <span class="text-muted italic">None added</span>
                <% end %>
              </span>
            </div>

            <div class="profile-bento-item bento-full-width">
              <span class="bento-label">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                Bio
              </span>
              <span class="bento-value"><%= (@profile.respond_to?(:bio) && @profile.bio.present?) ? @profile.bio : "No bio provided yet." %></span>
            </div>

          <% elsif @role_type == "CompanyProfile" %>
            <div class="profile-bento-item">
              <span class="bento-label">Company Name</span>
              <span class="bento-value"><%= @profile.name %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Website</span>
              <span class="bento-value"><%= (@profile.respond_to?(:website) && @profile.website.present?) ? @profile.website : "Not specified" %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Verification Status</span>
              <span class="bento-value"><%= (@profile.respond_to?(:verified?) && @profile.verified?) ? "Verified Recruiter" : "Pending Verification" %></span>
            </div>
            <div class="profile-bento-item bento-full-width">
              <span class="bento-label">Description</span>
              <span class="bento-value"><%= (@profile.respond_to?(:description) && @profile.description.present?) ? @profile.description : "No description provided." %></span>
            </div>

          <% elsif @role_type == "UniversityProfile" %>
            <div class="profile-bento-item">
              <span class="bento-label">Admin Name</span>
              <span class="bento-value"><%= @profile.admin_name %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Department</span>
              <span class="bento-value"><%= @profile.department %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Institution Name</span>
              <span class="bento-value"><%= @profile.university ? @profile.university.name : "University Partner" %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# ─── Role-Specific Primary Section ──────────────────────────── %>
      <% if @role_type == "StudentProfile" %>

        <%# Active Internships & Milestones %>
        <div class="profile-card mb-30">
          <div class="section-heading-row">
            <div class="section-title-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              <h2>Active Internships & Milestone Progress</h2>
            </div>
          </div>

          <% if @active_internships.any? %>
            <div class="inline-list">
              <% @active_internships.each do |sub| %>
                <div class="internship-item">
                  <div class="internship-item-left">
                    <strong class="internship-item-title"><%= sub.offer.title %></strong>
                    <span class="internship-item-meta">
                      Company: <%= sub.offer.company_profile.name %>
                      <span class="badge-status <%= "badge-#{sub.status}" %> ml-8"><%= sub.status.humanize %></span>
                      <% match_pct = sub.offer.match_percentage_for(@profile) rescue 100 %>
                      <% if match_pct < 100 %>
                        <span class="match-badge <%= match_pct >= 70 ? 'match-badge-high' : (match_pct >= 40 ? 'match-badge-medium' : 'match-badge-low') %> ml-4"><%= match_pct %>% Match</span>
                      <% end %>
                    </span>

                    <%# Milestone Tracker %>
                    <div class="timeline-container">
                      <div class="timeline-steps">
                        <% submission_milestones(sub).each_with_index do |ms, idx| %>
                          <div class="timeline-step-wrapper">
                            <div class="timeline-tooltip">
                              <% if ms[:timestamp] %>
                                <%= ms[:timestamp].strftime("%b %d, %Y") %>
                              <% else %>
                                <%= ms[:complete] ? "Done" : "—" %>
                              <% end %>
                            </div>
                            <div class="timeline-step <%= ms[:complete] ? 'completed' : 'pending' %>">
                              <% if ms[:complete] %>
                                <svg class="timeline-step-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                              <% else %>
                                <%= idx + 1 %>
                              <% end %>
                            </div>
                            <% if idx < submission_milestones(sub).length - 1 %>
                              <div class="timeline-line <%= ms[:complete] ? 'completed' : 'pending' %>"></div>
                            <% end %>
                            <span class="timeline-label <%= ms[:complete] ? 'completed' : '' %>"><%= ms[:label] %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <div class="internship-item-actions">
                    <% if sub.status == "accepted" %>
                      <% if sub.student_confirmed_completed %>
                        <span class="badge-status badge-completion-pending">
                          Waiting for Employer
                        </span>
                      <% else %>
                        <%= button_to "Mark Completed", confirm_completion_submission_path(sub), method: :post, class: "btn btn-primary btn-compact-success" %>
                        <%= button_to "Abandon", abandon_submission_path(sub), method: :post, class: "btn btn-secondary btn-compact-danger", data: { turbo_confirm: "Are you sure you want to abandon this internship? Your commitment score will be penalized." } %>
                      <% end %>

                      <% if sub.internship_agreement %>
                        <% if sub.internship_agreement.status == "pending_signatures" %>
                          <span class="badge-status badge-pending">Awaiting Signatures</span>
                        <% elsif sub.internship_agreement.status == "declined" %>
                          <span class="badge-status badge-declined">Agreement Declined</span>
                        <% end %>
                        <%= link_to "View & Sign Agreement", submission_internship_agreement_path(sub, sub.internship_agreement), class: "btn btn-primary btn-compact" %>
                      <% else %>
                        <%= link_to "Generate Convention de Stage", new_submission_internship_agreement_path(sub), class: "btn btn-secondary btn-compact" %>
                      <% end %>
                    <% else %>
                      <span class="badge-status badge-completed">Completed</span>
                      <% my_review = sub.reviews.detect { |r| r.author_id == current_user.id } %>
                      <% if my_review.nil? %>
                        <%= link_to "Leave Review", new_submission_review_path(sub), class: "btn btn-primary w-auto fs-12 btn-review" %>
                      <% else %>
                        <span class="fs-12 text-muted">Review Submitted</span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <h3 class="empty-state-title">No Active Internships</h3>
              <p class="empty-state-text">
                You haven't started any internships on StageUp yet. Search for active offers, apply, and complete your proof mission!
              </p>
              <%= link_to "Browse Active Offers", offers_path, class: "btn btn-primary btn-compact" %>
            </div>
          <% end %>
        </div>

      <% elsif @role_type == "CompanyProfile" %>

        <%# Active Offers Management %>
        <div class="profile-card mb-30">
          <div class="section-heading-row">
            <div class="section-title-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
              <h2>My Internship Offers</h2>
            </div>
            <%= link_to "Post New Offer", new_offer_path, class: "btn btn-primary btn-compact" %>
          </div>

          <% if @company_offers.any? %>
            <div class="inline-list-sm">
              <% @company_offers.each do |offer| %>
                <div class="inline-list-sm-item">
                  <div class="offer-mgmt-left">
                    <span class="offer-mgmt-status-dot <%= offer.draft? ? 'dot-muted' : 'dot-success' %>"></span>
                    <div>
                      <strong class="inline-list-sm-title">
                        <%= link_to offer.title, offer_path(offer), class: "offer-mgmt-link" %>
                      </strong>
                      <span class="inline-list-sm-meta">
                        <%= offer.draft? ? "Draft" : offer.status.humanize %> &middot; <%= offer.submissions.count %> applicant(s)
                      </span>
                    </div>
                  </div>
                  <div class="action-group-8">
                    <%= link_to "Edit", edit_offer_path(offer), class: "btn btn-secondary btn-compact-sm" %>
                    <% if offer.draft? %>
                      <%= button_to "Delete", offer_path(offer), method: :delete, class: "btn btn-secondary btn-compact-danger-sm", data: { turbo_confirm: "Permanently delete this draft?" } %>
                    <% else %>
                      <%= button_to "Archive", offer_path(offer), method: :delete, class: "btn btn-secondary btn-compact-danger-sm", data: { turbo_confirm: "Archive this offer?" } %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
              </div>
              <h3 class="empty-state-title">No Offers Posted Yet</h3>
              <p class="empty-state-text">Publish your first internship offer to attract candidate talent and receive proof mission submissions.</p>
              <%= link_to "Post an Offer", new_offer_path, class: "btn btn-primary btn-compact-empty" %>
            </div>
          <% end %>
        </div>

      <% end %>

    </div>

    <%# ─── Right Column: Reputation Metrics & Ledger ──────────────── %>
    <div class="right-col">

      <%# Reputation Metrics Card %>
      <% if @role_type == "StudentProfile" %>
        <div class="profile-card rep-metrics-card mb-24">
          <div class="rep-metrics-header">
            <h3 class="rep-metrics-title">Reputation</h3>
            <span class="rep-metrics-sub">Public · Verified</span>
          </div>

          <div class="rep-score-row">
            <div class="rep-score-main">
              <% score = @commitment_score.round(0) rescue 100 %>
              <span class="rep-score-number <%= score >= 90 ? 'score-color-high' : (score >= 70 ? 'score-color-mid' : 'score-color-low') %>">
                <%= score %>
              </span>
              <span class="rep-score-label">/ 100</span>
            </div>
            <span class="rep-score-desc">Commitment Score</span>
          </div>

          <div class="rep-divider"></div>

          <div class="rep-rating-row">
            <div class="rep-rating-left">
              <svg class="icon-14 icon-amber-fill" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <span class="rep-rating-label">Avg. Rating</span>
            </div>
            <span class="rep-rating-value">
              <% if defined?(@avg_rating) && @avg_rating %>
                <%= @avg_rating.round(1) %> / 5
              <% else %>
                Unrated
              <% end %>
            </span>
          </div>
        </div>

      <% else %>
        <div class="profile-card p-25 mb-24">
          <h3 class="metrics-card-title">Reputation Metrics</h3>
          <% if @role_type == "CompanyProfile" %>
            <div class="rep-stat-list">
              <div class="rep-stat-row">
                <span class="rep-stat-label">Active Offers</span>
                <strong><%= @company_offers.count %></strong>
              </div>
              <div class="rep-stat-row">
                <span class="rep-stat-label">Verification</span>
                <span class="rep-metrics-sub"><%= @profile.verified? ? "Verified" : "Grace Period" %></span>
              </div>
            </div>
          <% elsif @role_type == "UniversityProfile" %>
            <div class="rep-stat-list">
              <div class="rep-stat-row">
                <span class="rep-stat-label">Associated Students</span>
                <strong><%= @profile.student_profiles.count %></strong>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Commitment Ledger History %>
      <% if @role_type == "StudentProfile" %>
        <div class="profile-card p-25">
          <div class="ledger-card-header">
            <div class="ledger-card-title-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              <h3 class="ledger-card-title">Commitment Ledger</h3>
            </div>
            <span class="ledger-card-sub">Score History</span>
          </div>

          <% if @commitment_ledger_events.present? && @commitment_ledger_events.any? %>
            <div class="ledger-timeline">
              <% @commitment_ledger_events.each do |event| %>
                <div class="ledger-event-item">
                  <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                  <div class="ledger-event-body">
                    <div class="ledger-event-header">
                      <span class="ledger-event-title"><%= (event.respond_to?(:event_type) && event.event_type.present?) ? event.event_type.humanize : "Event" %></span>
                      <span class="ledger-event-delta <%= event.score_delta > 0 ? 'delta-positive' : 'delta-negative' %>">
                        <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %>
                      </span>
                    </div>
                    <p class="ledger-event-desc"><%= event.description %></p>
                    <span class="ledger-event-time"><%= time_ago_in_words(event.created_at) %> ago</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="ledger-empty-state">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <p>No reputation events logged yet. Complete internships to build your score history.</p>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>

  </div>

</div>
