<% content_for :title, "#{t('dashboard.title')} – StageUp" %>

<div class="dashboard-container">

  <%# ─── Dashboard Welcome Hero ───────────────────────────────────── %>
  <div class="dash-welcome">
    <div class="dash-welcome-inner">
      <div>
        <h1 class="dash-welcome-title">
          <%= t('dashboard.welcome_back', name: @profile.respond_to?(:first_name) && @profile.first_name.present? ? @profile.first_name : (@profile.respond_to?(:name) && @profile.name.present? ? @profile.name : '')) %>
        </h1>
        <p class="dash-welcome-sub">
          <% if @role_type == "StudentProfile" %>
            <%= t('dashboard.welcome_sub.student') %>
          <% elsif @role_type == "CompanyProfile" %>
            <%= t('dashboard.welcome_sub.company') %>
          <% else %>
            <%= t('dashboard.welcome_sub.university') %>
          <% end %>
        </p>
      </div>
      <div class="dash-welcome-meta">
        <span class="dash-date-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          <span><%= Date.today.strftime("%B %d, %Y") %></span>
        </span>
      </div>
    </div>
  </div>

  <div class="dashboard-grid">

    <%# ─── Left Main Column ───────────────────────────────────────── %>
    <div class="left-col">

      <%# ─── Profile Bento Card ────────────────────────────────────── %>
      <div class="profile-card mb-30">
        <div class="section-heading-row">
          <div class="section-title-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <h2><%= t('dashboard.profile.title') %></h2>
          </div>
          <div class="section-heading-row-right">
            <% if @role_type == "StudentProfile" %>
              <span class="badge badge-info"><%= t('dashboard.profile.roles.student') %></span>
            <% elsif @role_type == "CompanyProfile" %>
              <span class="badge badge-info"><%= t('dashboard.profile.roles.company') %></span>
            <% else %>
              <span class="badge badge-info"><%= t('dashboard.profile.roles.university') %></span>
            <% end %>
            <% my_public_profile_path = case @role_type
                                        when "StudentProfile" then student_profile_path(@profile)
                                        when "CompanyProfile" then company_profile_path(@profile)
                                        else nil
                                        end %>
            <% if my_public_profile_path %>
              <%= link_to my_public_profile_path, class: "btn btn-primary btn-compact mr-6" do %>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-4"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <%= t('dashboard.profile.view_public', default: 'View My Profile') %>
              <% end %>
            <% end %>
            <%= link_to t('dashboard.profile.edit'), edit_user_registration_path, class: "btn btn-secondary btn-compact" %>
          </div>
        </div>

        <div class="profile-bento-grid">
          <% if @role_type == "StudentProfile" %>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge indigo">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.full_name') %></span>
              </div>
              <span class="bento-value"><%= @profile.first_name %> <%= @profile.last_name %></span>
            </div>

            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge emerald">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.phone') %></span>
              </div>
              <span class="bento-value">
                <% student_phone = @profile.respond_to?(:phone) ? @profile.phone : (@profile.respond_to?(:phone_number) ? @profile.phone_number : nil) %>
                <%= student_phone.presence || t('dashboard.profile_bento.phone_not_specified') %>
              </span>
            </div>

            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge amber">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.major') %></span>
              </div>
              <span class="bento-value">
                <% student_major = @profile.respond_to?(:major) ? @profile.major : (@profile.respond_to?(:field_of_study) ? @profile.field_of_study : nil) %>
                <%= student_major.presence || t('dashboard.profile_bento.major_not_specified') %>
              </span>
            </div>

            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge purple">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.graduation_year') %></span>
              </div>
              <span class="bento-value"><%= @profile.graduation_year.presence || t('dashboard.profile_bento.graduation_not_specified') %></span>
            </div>

            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge cyan">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.university') %></span>
              </div>
              <span class="bento-value">
                <% if @profile.respond_to?(:university) && @profile.university %>
                  <%= @profile.university.name %>
                <% else %>
                  <span class="text-muted italic"><%= t('dashboard.profile_bento.university_self_declared') %></span>
                <% end %>
              </span>
            </div>

            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge indigo">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.skills') %></span>
              </div>
              <div class="bento-value">
                <% if @profile.respond_to?(:skills) && @profile.skills.any? %>
                  <div class="bento-skills-list">
                    <% @profile.skills.each do |skill| %>
                      <span class="bento-skill-pill"><%= skill.name %></span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-muted italic"><%= t('dashboard.profile_bento.skills_none') %></span>
                <% end %>
              </div>
            </div>

            <div class="profile-bento-item bento-full-width">
              <div class="bento-header-row">
                <span class="bento-icon-badge emerald">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                </span>
                <span class="bento-label"><%= t('dashboard.profile_bento.bio') %></span>
              </div>
              <span class="bento-value"><%= (@profile.respond_to?(:bio) && @profile.bio.present?) ? @profile.bio : t('dashboard.profile_bento.bio_empty') %></span>
            </div>

          <% elsif @role_type == "CompanyProfile" %>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge indigo"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M19 21v-4a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v4"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.company_name') %></span>
              </div>
              <span class="bento-value"><%= @profile.name %></span>
            </div>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge cyan"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" x2="22" y1="12" y2="12"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.website') %></span>
              </div>
              <span class="bento-value"><%= (@profile.respond_to?(:website) && @profile.website.present?) ? @profile.website : t('dashboard.profile_bento.website_not_provided') %></span>
            </div>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge emerald"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.verification_status') %></span>
              </div>
              <span class="bento-value"><%= (@profile.respond_to?(:verified?) && @profile.verified?) ? t('dashboard.profile_bento.verified') : t('dashboard.profile_bento.not_verified') %></span>
            </div>
            <div class="profile-bento-item bento-full-width">
              <div class="bento-header-row">
                <span class="bento-icon-badge purple"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.description') %></span>
              </div>
              <span class="bento-value"><%= (@profile.respond_to?(:description) && @profile.description.present?) ? @profile.description : t('dashboard.profile_bento.description_empty') %></span>
            </div>

          <% elsif @role_type == "UniversityProfile" %>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge indigo"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.admin_name') %></span>
              </div>
              <span class="bento-value"><%= @profile.admin_name %></span>
            </div>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge amber"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.department') %></span>
              </div>
              <span class="bento-value"><%= @profile.department %></span>
            </div>
            <div class="profile-bento-item">
              <div class="bento-header-row">
                <span class="bento-icon-badge cyan"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/></svg></span>
                <span class="bento-label"><%= t('dashboard.profile_bento.institution_name') %></span>
              </div>
              <span class="bento-value"><%= @profile.university ? @profile.university.name : t('dashboard.profile_bento.institution_name') %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# ─── Role-Specific Primary Section ──────────────────────────── %>
      <% if @role_type == "StudentProfile" %>

        <%# Active Internships & Milestones %>
        <%= render "dashboards/active_internships_card" %>

      <% elsif @role_type == "CompanyProfile" %>

        <%# Active Internships & Milestones for Company %>
        <% if @active_internships.any? %>
          <%= render "dashboards/active_internships_card" %>
        <% end %>

        <%# Applications Pipeline (Kanban Board) %>
        <div class="profile-card mb-30">
          <div class="section-heading-row">
            <div class="section-title-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              <h2><%= t('dashboard.kanban.title') %></h2>
            </div>
          </div>

          <%= render "dashboards/kanban_board",
              pending_submissions: @pending_submissions,
              active_internships: @active_internships,
              processed_submissions: @processed_submissions %>
        </div>

        <%# Active Offers Management %>
        <div class="profile-card mb-30">
          <div class="section-heading-row">
            <div class="section-title-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
              <h2><%= t('dashboard.offers.title') %></h2>
            </div>
            <%= link_to t('dashboard.offers.post_offer'), new_offer_path, class: "btn btn-primary btn-compact" %>
          </div>

          <% if @company_offers.any? %>
            <div class="inline-list-sm">
              <% @company_offers.each do |offer| %>
                <div class="inline-list-sm-item">
                  <div class="offer-mgmt-left">
                    <span class="offer-mgmt-status-dot <%= offer.draft? ? 'dot-muted' : 'dot-success' %>"></span>
                    <div>
                      <strong class="inline-list-sm-title">
                        <%= link_to offer.title, offer_path(offer), class: "offer-mgmt-link" %>
                      </strong>
                      <span class="inline-list-sm-meta">
                        <%= offer.draft? ? t('dashboard.offers.draft_label') : t("dashboard.offers.status_#{offer.status}", default: offer.status.humanize) %> &middot; <%= offer.submissions.size %> <%= t('dashboard.offers.applicant_count') %>
                      </span>
                    </div>
                  </div>
                  <div class="action-group-8">
                    <%= link_to t('common.edit'), edit_offer_path(offer), class: "btn btn-secondary btn-compact-sm" %>
                    <% if offer.draft? %>
                      <%= button_to t('dashboard.offers.delete_draft'), offer_path(offer), method: :delete, class: "btn btn-secondary btn-compact-danger-sm", data: { turbo_confirm: t('dashboard.offers.delete_draft_confirm') } %>
                    <% else %>
                      <%= button_to t('dashboard.offers.archive'), offer_path(offer), method: :delete, class: "btn btn-secondary btn-compact-danger-sm", data: { turbo_confirm: t('dashboard.offers.archive_confirm') } %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
              </div>
              <h3 class="empty-state-title"><%= t('dashboard.offers.no_offers_title') %></h3>
              <p class="empty-state-text"><%= t('dashboard.offers.no_offers_text') %></p>
              <%= link_to t('dashboard.offers.post_offer_empty'), new_offer_path, class: "btn btn-primary btn-compact-empty" %>
            </div>
          <% end %>
        </div>

      <% elsif @role_type == "UniversityProfile" %>

        <%# Enrolled Students & Internship Agreements %>
        <div class="profile-card mb-30">
          <div class="section-heading-row">
            <div class="section-title-left">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
              <h2><%= t('dashboard.university.students_title', default: 'Enrolled Students & Internship Agreements') %></h2>
            </div>
            <span class="badge-status badge-completed"><%= @students_total rescue 0 %> <%= t('dashboard.university.students_count', default: 'Students') %></span>
          </div>

          <% if @students.any? %>
            <div class="inline-list-sm">
              <% @students.each do |student| %>
                <% agreement = student.active_submissions.map(&:internship_agreement).compact.first %>
                <% submission = student.active_submissions.first %>
                <div class="inline-list-sm-item flex-between py-12 px-16">
                  <div class="flex-align-center gap-12 min-width-0">
                    <div class="kanban-avatar avatar-emerald flex-shrink-0">
                      <%= student.first_name.first.upcase rescue 'S' %>
                    </div>
                    <div class="min-width-0">
                      <strong class="inline-list-sm-title text-truncate block color-primary">
                        <%= student.first_name %> <%= student.last_name %>
                      </strong>
                      <span class="inline-list-sm-meta text-truncate block text-muted fs-12">
                        <%= student.major.presence || t('dashboard.profile_bento.student') %> &middot; <%= student.user.email %>
                      </span>
                    </div>
                  </div>

                  <div class="flex-align-center gap-10 flex-shrink-0">
                    <% if agreement.present? && submission.present? %>
                      <% if agreement.status == "fully_executed" %>
                        <span class="badge-status badge-completed">✓ <%= t('dashboard.internship_agreements.show.fully_executed_badge', default: 'Fully Executed') %></span>
                        <%= link_to submission_internship_agreement_path(submission, agreement), class: "btn btn-secondary btn-compact-sm" do %>
                          <%= t('dashboard.active_internships.view_sign_agreement', default: 'View Agreement') %> &rarr;
                        <% end %>
                      <% elsif agreement.status == "declined" %>
                        <span class="badge-status badge-declined"><%= t('dashboard.active_internships.agreement_declined', default: 'Declined') %></span>
                        <%= link_to submission_internship_agreement_path(submission, agreement), class: "btn btn-secondary btn-compact-sm" do %>
                          <%= t('dashboard.active_internships.view_sign_agreement', default: 'View Agreement') %> &rarr;
                        <% end %>
                      <% else %>
                        <span class="badge-status badge-pending">⏳ <%= t('dashboard.active_internships.awaiting_signatures', default: 'Pending Signatures') %></span>
                        <%= link_to submission_internship_agreement_path(submission, agreement), class: "btn btn-primary btn-compact-sm" do %>
                          <%= t('dashboard.active_internships.view_sign_agreement', default: 'View & Sign Agreement') %> &rarr;
                        <% end %>
                      <% end %>
                    <% else %>
                      <span class="fs-12 text-muted"><%= t('dashboard.university.no_active_agreement', default: 'No Agreement Pending') %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <h3 class="empty-state-title"><%= t('dashboard.university.no_students_title', default: 'No Enrolled Students') %></h3>
              <p class="empty-state-text"><%= t('dashboard.university.no_students_text', default: 'No students are currently associated with your institution.') %></p>
            </div>
          <% end %>
        </div>

      <% end %>

    </div>

    <%# ─── Right Column: Reputation Metrics & Ledger ──────────────── %>
    <div class="right-col">

      <%# Reputation Metrics Card %>
      <% if @role_type == "StudentProfile" %>
        <div class="profile-card rep-metrics-card mb-24">
          <div class="rep-metrics-header">
            <h3 class="rep-metrics-title"><%= t('dashboard.reputation.title') %></h3>
            <span class="rep-metrics-sub"><%= t('dashboard.reputation.public_verified_label') %></span>
          </div>

          <div class="rep-score-row">
            <div class="rep-score-main">
              <% score = @commitment_score.round(0) rescue 100 %>
              <span class="rep-score-number <%= score >= 90 ? 'score-color-high' : (score >= 70 ? 'score-color-mid' : 'score-color-low') %>">
                <%= score %>
              </span>
              <span class="rep-score-label">/ 100</span>
            </div>
            <span class="rep-score-desc"><%= t('dashboard.reputation.score_label') %></span>
          </div>

          <div class="rep-divider"></div>

          <div class="rep-rating-row">
            <div class="rep-rating-left">
              <svg class="icon-14 icon-amber-fill" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <span class="rep-rating-label"><%= t('dashboard.reputation.avg_rating') %></span>
            </div>
            <span class="rep-rating-value">
              <% if defined?(@avg_rating) && @avg_rating %>
                <%= @avg_rating.round(1) %> / 5
              <% else %>
                <%= t('common.unrated') %>
              <% end %>
            </span>
          </div>
        </div>

      <% else %>
        <div class="profile-card p-25 mb-24">
          <h3 class="metrics-card-title"><%= t('dashboard.reputation.metrics_title') %></h3>
          <% if @role_type == "CompanyProfile" %>
            <div class="rep-stat-list">
              <div class="rep-stat-row">
                <span class="rep-stat-label"><%= t('dashboard.reputation.active_offers') %></span>
                <strong><%= @company_offers.count %></strong>
              </div>
              <div class="rep-stat-row">
                <span class="rep-stat-label"><%= t('dashboard.reputation.verification_label') %></span>
                <span class="rep-metrics-sub"><%= @profile.verified? ? t('dashboard.reputation.verified_status') : t('dashboard.reputation.grace_period') %></span>
              </div>
            </div>
          <% elsif @role_type == "UniversityProfile" %>
            <div class="rep-stat-list">
              <div class="rep-stat-row">
                <span class="rep-stat-label"><%= t('dashboard.reputation.associated_students') %></span>
                <strong><%= @total_students_count %></strong>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Commitment Ledger History %>
      <% if @role_type == "StudentProfile" %>
        <div class="profile-card p-25">
          <div class="ledger-card-header">
            <div class="ledger-card-title-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              <h3 class="ledger-card-title"><%= t('dashboard.reputation.ledger_title') %></h3>
            </div>
            <span class="ledger-card-sub"><%= t('dashboard.reputation.history_title') %></span>
          </div>

          <% if @commitment_ledger_events.present? && @commitment_ledger_events.any? %>
            <div class="ledger-timeline">
              <% @commitment_ledger_events.each do |event| %>
                <div class="ledger-event-item">
                  <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                  <div class="ledger-event-body">
                    <div class="ledger-event-header">
                      <span class="ledger-event-title"><%= (event.respond_to?(:event_type) && event.event_type.present?) ? t("commitment_events.descriptions.#{event.event_type}", default: event.event_type.humanize) : t('dashboard.reputation.event_label') %></span>
                      <span class="ledger-event-delta <%= event.score_delta > 0 ? 'delta-positive' : (event.score_delta == 0 ? 'delta-neutral' : 'delta-negative') %>">
                        <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %>
                      </span>
                    </div>
                    <% event_title_text = t("commitment_events.descriptions.#{event.event_type}", default: event.event_type.humanize) rescue "" %>
                    <% if event.description.present? && event.description.strip != event_title_text.strip && event.description != event.event_type.humanize %>
                      <p class="ledger-event-desc"><%= event.description %></p>
                    <% end %>
                    <span class="ledger-event-time"><%= time_ago_in_words(event.created_at) %> <%= t('common.ago') %></span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="ledger-empty-state">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <p><%= t('dashboard.reputation.empty') %></p>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Received Reviews Card %>
      <% if defined?(@received_reviews) && @received_reviews.present? && @received_reviews.any? %>
        <div class="profile-card p-25 mt-24">
          <div class="ledger-card-header mb-16">
            <div class="ledger-card-title-row">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" class="color-amber"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <h3 class="ledger-card-title"><%= t('dashboard.reviews.received_title', default: 'Verified Reviews') %></h3>
            </div>
            <span class="ledger-card-sub"><%= @received_reviews.count %> <%= t('dashboard.reviews.count_label', default: 'reviews') %></span>
          </div>

          <div class="received-reviews-list">
            <% @received_reviews.each do |rev| %>
              <% author_profile = rev.author.profileable %>
              <% author_name = author_profile.is_a?(StudentProfile) ? "#{author_profile.first_name} #{author_profile.last_name}" : author_profile.name %>
              <div class="received-review-item py-12 border-bottom-subtle">
                <div class="flex-between flex-align-center mb-6">
                  <div class="flex-align-center gap-8">
                    <div class="kanban-avatar avatar-indigo flex-shrink-0" style="width: 24px; height: 24px; font-size: 11px;">
                      <%= author_name.first.upcase rescue 'U' %>
                    </div>
                    <strong class="fs-13 color-primary"><%= author_name %></strong>
                  </div>
                  <div class="flex-align-center gap-4 color-amber fs-13 fw-700">
                    <span>★ <%= rev.rating %>.0</span>
                  </div>
                </div>
                <p class="fs-12 text-secondary margin-0 mb-4 line-height-14"><%= rev.comment %></p>
                <div class="flex-between fs-11 text-muted">
                  <span><%= rev.submission.offer.title rescue nil %></span>
                  <span><%= time_ago_in_words(rev.created_at) %> <%= t('common.ago') %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>

  </div>

</div>
