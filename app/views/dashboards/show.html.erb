<% content_for :title, "My Dashboard – StageUp" %>
<div class="dashboard-container">
  <div class="dash-welcome">
    <div class="dash-welcome-inner">
      <div>
        <h1 class="dash-welcome-title">
          Welcome back<% if @profile.respond_to?(:first_name) && @profile.first_name.present? %>, <%= @profile.first_name %><% end %>
        </h1>
        <p class="dash-welcome-sub">
          <% if @role_type == "StudentProfile" %>
            Manage your applications and track your reputation score.
          <% elsif @role_type == "CompanyProfile" %>
            Review applicants and manage your active offers.
          <% else %>
            Monitor your institution's internship agreements.
          <% end %>
        </p>
      </div>
      <div class="dash-welcome-meta">
        <span class="dash-date-pill">
          <i data-lucide="calendar" style="width:12px;height:12px;stroke:var(--text-muted)"></i>
          <%= Date.today.strftime("%B %d, %Y") %>
        </span>
      </div>
    </div>
  </div>
  <div class="dashboard-grid">
    
    <!-- Left Column: Primary Details -->
    <div>
      <div class="profile-card card-mb">
        <div class="section-heading-row">
          <h2 class="fs-22">My Profile</h2>
          <div>
            <% if @role_type == "StudentProfile" %>
              <span class="badge badge-info">Student</span>
            <% elsif @role_type == "CompanyProfile" %>
              <span class="badge badge-success">Company</span>
            <% else %>
              <span class="badge badge-university">University Admin</span>
            <% end %>
          </div>
          <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-secondary btn-compact-sm" %>
        </div>

        <!-- Student Details -->
        <% if @role_type == "StudentProfile" %>
          <div class="profile-grid-bento">
            <div class="profile-bento-item">
              <span class="bento-label">Full Name</span>
              <span class="bento-value"><%= @profile.first_name %> <%= @profile.last_name %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Phone</span>
              <span class="bento-value"><%= @profile.phone.presence || "Not specified" %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Major</span>
              <span class="bento-value"><%= @profile.major.presence || "Not specified" %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Graduation Year</span>
              <span class="bento-value"><%= @profile.graduation_year.presence || "Not specified" %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">University</span>
              <span class="bento-value">
                <% if @profile.university %>
                  <%= @profile.university.name %>
                  <% if @profile.university.approved? %>
                    <span class="badge badge-success badge-verified">Verified Partner</span>
                  <% end %>
                <% else %>
                  <em class="text-muted">Self-declared / Unassociated</em>
                <% end %>
              </span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Skills</span>
              <span class="bento-value">
                <% if @profile.skills.any? %>
                  <div class="flex-row flex-wrap gap-4">
                    <% @profile.skills.each do |skill| %>
                      <span class="skill-tag"><%= skill.name %></span>
                    <% end %>
                  </div>
                <% else %>
                  <em class="text-muted">None added</em>
                <% end %>
              </span>
            </div>
          </div>

          <div class="profile-bio-section">
            <span class="bento-label">Bio</span>
            <div class="bio-card">
              <p><%= @profile.bio.presence || "No bio added yet." %></p>
            </div>
          </div>

          <div class="profile-cv-section">
            <span class="bento-label">Resume / CV</span>
            <div class="cv-dropzone">
              <div class="cv-dropzone-icon">
                <i data-lucide="file-text" class="icon-32 stroke-secondary"></i>
              </div>
              <% if @profile.cv.attached? %>
                <div class="cv-dropzone-file">
                  <span class="cv-dropzone-filename"><%= @profile.cv.filename.to_s %></span>
                  <span class="cv-dropzone-size"><%= number_to_human_size(@profile.cv.byte_size) %></span>
                  <%= link_to "Download", rails_blob_path(@profile.cv, disposition: "attachment"), target: "_blank", class: "btn btn-accent btn-compact-sm" %>
                </div>
              <% else %>
                <p class="cv-dropzone-empty">No CV uploaded yet. Recruiter applications will be blank without one.</p>
              <% end %>
              <%= form_with model: @profile, url: update_cv_dashboard_path, method: :patch, local: true, multipart: true, class: "cv-dropzone-form" do |f| %>
                <%= f.file_field :cv, accept: "application/pdf", id: "cv-file-input", class: "cv-file-input" %>
                <label for="cv-file-input" class="cv-file-label">
                  <i data-lucide="upload" class="icon-14"></i>
                  Choose PDF
                </label>
                <%= f.submit "Upload", class: "btn btn-primary btn-compact-sm" %>
              <% end %>
            </div>
          </div>

        <!-- Company Details -->
        <% elsif @role_type == "CompanyProfile" %>
          <div class="profile-grid-bento">
            <div class="profile-bento-item w-full">
              <span class="bento-label">Company Name</span>
              <span class="bento-value">
                <%= @profile.name %>
                <% if @profile.verified? %>
                  <span class="badge badge-success badge-verified">Verified Partner</span>
                <% end %>
              </span>
            </div>
            <div class="profile-bento-item w-full">
              <span class="bento-label">Website</span>
              <span class="bento-value">
                <% if @profile.website.present? %>
                  <%= link_to @profile.website, @profile.website, target: "_blank" %>
                <% else %>
                  <em class="text-muted">No website listed</em>
                <% end %>
              </span>
            </div>
          </div>
          <div class="profile-bio-section">
            <span class="bento-label">Description</span>
            <div class="bio-card">
              <p><%= @profile.description.presence || "No company description added yet." %></p>
            </div>
          </div>

        <!-- University Coordinator Details -->
        <% elsif @role_type == "UniversityProfile" %>
          <div class="profile-grid-bento">
            <div class="profile-bento-item">
              <span class="bento-label">Coordinator Name</span>
              <span class="bento-value"><%= @profile.admin_name %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">University</span>
              <span class="bento-value"><%= @profile.university.name %></span>
            </div>
            <div class="profile-bento-item">
              <span class="bento-label">Department</span>
              <span class="bento-value"><%= @profile.department %></span>
            </div>
          </div>

          <div class="overview-grid">
            <div class="profile-card overview-stat-card">
              <div class="fs-12 text-secondary mb-6">Total Students Enrolled</div>
              <strong class="fs-26"><%= @total_students_count %></strong>
            </div>
            <div class="profile-card overview-stat-card">
              <div class="fs-12 text-secondary mb-6">Active &amp; Completed Internships</div>
              <strong class="fs-26"><%= @active_internships_count %></strong>
            </div>
            <div class="profile-card overview-stat-card">
              <div class="fs-12 text-secondary mb-6">Avg Student Commitment</div>
              <div class="flex-center">
                <div class="score-pill fs-12">
                  <span class="dot <%= @avg_student_score >= 90 ? 'dot-success' : (@avg_student_score >= 70 ? 'dot-warning' : 'dot-danger') %>"></span>
                  <strong><%= @avg_student_score %></strong>
                  <span class="score-label">Avg</span>
                </div>
              </div>
            </div>
          </div>

          <h2 class="section-heading mt-25">
            <i data-lucide="users" class="section-heading-icon"></i>
            Student Directory
          </h2>
          <% if @students.any? %>
            <div class="overflow-x-auto">
              <table class="processed-table w-100">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Major</th>
                    <th>Graduation Year</th>
                    <th>Active Internship</th>
                    <th>Agreement</th>
                    <th>Commitment Score</th>
                  </tr>
                </thead>
                <tbody>
                  <% @students.each do |s| %>
                    <% active_sub = s.submissions.detect { |sub| %w[accepted completed].include?(sub.status) } %>
                    <% agreement = active_sub&.internship_agreement %>
                    <tr>
                      <td><%= s.first_name %> <%= s.last_name %></td>
                      <td><%= s.major.presence || "—" %></td>
                      <td><%= s.graduation_year.presence || "—" %></td>
                      <td>
                        <% if active_sub %>
                          <span class="badge-status <%= active_sub.status == 'completed' ? 'badge-completed' : 'badge-accepted' %>">
                            <%= active_sub.offer.title.truncate(24) %>
                          </span>
                        <% else %>
                          <span class="fs-12 text-muted">None</span>
                        <% end %>
                      </td>
                      <td>
                        <% if active_sub && agreement %>
                          <% if agreement.status == "fully_executed" %>
                            <span class="badge-status badge-completed">✓ Signed</span>
                          <% else %>
                            <span class="badge-status badge-pending">Pending</span>
                            <%= link_to "View & Sign", submission_internship_agreement_path(active_sub, agreement), class: "btn btn-primary btn-compact-sm ml-8" %>
                          <% end %>
                        <% elsif active_sub %>
                          <span class="fs-12 text-muted">—</span>
                        <% else %>
                          <span class="fs-12 text-muted">—</span>
                        <% end %>
                      </td>
                      <td>
                        <% student_score = s.commitment_score.round(0) %>
                        <div class="score-pill score-pill-sm">
                          <span class="dot <%= student_score >= 90 ? 'dot-success' : (student_score >= 70 ? 'dot-warning' : 'dot-danger') %>"></span>
                          <strong><%= student_score %></strong>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon"><i data-lucide="users" class="icon-40"></i></div>
              <h3 class="empty-state-title">No Students Yet</h3>
              <p class="empty-state-text">Registered students from your university will appear here once they sign up.</p>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Student Internships Panel -->
      <% if @role_type == "StudentProfile" %>
        <div class="profile-card card-mb">
          <h2 class="section-heading">
            <i data-lucide="briefcase" class="section-heading-icon"></i>
            My Internships
          </h2>
          <% if @active_internships.any? %>
            <div class="inline-list">
              <% @active_internships.each do |sub| %>
                <div class="inline-list-item">
                  <div>
                    <strong class="inline-list-item-title"><%= sub.offer.title %></strong>
                    <span class="inline-list-item-meta">
                      Company: <%= sub.offer.company_profile.name %>
                      <% match_pct = sub.offer.match_percentage_for(@profile) %>
                      <% if match_pct < 100 %>
                        <span class="match-badge <%= match_pct >= 70 ? 'match-badge-high' : (match_pct >= 40 ? 'match-badge-medium' : 'match-badge-low') %>"><%= match_pct %>% Match</span>
                      <% end %>
                    </span>
                  </div>
                  <div class="timeline-container">
                    <div class="timeline-steps">
                      <% submission_milestones(sub).each_with_index do |ms, idx| %>
                        <div class="timeline-step-wrapper">
                          <div class="timeline-tooltip">
                            <% if ms[:timestamp] %>
                              <%= ms[:timestamp].strftime("%b %d, %Y") %>
                            <% else %>
                              <%= ms[:complete] ? "Done" : "—" %>
                            <% end %>
                          </div>
                          <div class="timeline-step <%= ms[:complete] ? 'completed' : 'pending' %>">
                            <% if ms[:complete] %>
                              <svg class="timeline-step-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                            <% else %>
                              <%= idx + 1 %>
                            <% end %>
                          </div>
                          <% if idx < submission_milestones(sub).length - 1 %>
                            <div class="timeline-line <%= ms[:complete] ? 'completed' : 'pending' %>"></div>
                          <% end %>
                          <span class="timeline-label <%= ms[:complete] ? 'completed' : '' %>"><%= ms[:label] %></span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                  <div>
                    <% if sub.status == "accepted" %>
                      <div class="flex-col gap-8 items-end">
                        <div class="action-group">
                          <% if sub.student_confirmed_completed %>
                            <span class="badge-status badge-completion-pending">
                              Waiting for Employer
                            </span>
                          <% else %>
                            <%= button_to "Mark Completed", confirm_completion_submission_path(sub), method: :post, class: "btn btn-primary btn-compact-success" %>
                            <%= button_to "Abandon", abandon_submission_path(sub), method: :post, class: "btn btn-secondary btn-compact-danger", data: { turbo_confirm: "Are you sure you want to abandon this internship? Your commitment score will be penalized." } %>
                          <% end %>
                        </div>
                          <div class="action-group">
                          <% if sub.internship_agreement %>
                            <% if sub.internship_agreement.status == "pending_signatures" %>
                              <span class="badge-status badge-pending">Awaiting: <%= sub.internship_agreement.pending_signatories.join(", ") %></span>
                            <% elsif sub.internship_agreement.status == "declined" %>
                              <span class="badge-status badge-declined">Agreement Declined</span>
                            <% end %>
                            <%= link_to "View & Sign Agreement", submission_internship_agreement_path(sub, sub.internship_agreement), class: "btn btn-primary btn-compact" %>
                            <% if sub.internship_agreement.status == "declined" %>
                              <%= link_to "Generate New Agreement", new_submission_internship_agreement_path(sub), class: "btn btn-secondary btn-compact" %>
                            <% end %>
                          <% else %>
                            <%= link_to "Generate Convention de Stage", new_submission_internship_agreement_path(sub), class: "btn btn-secondary btn-compact" %>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <span class="badge-status badge-completed mr-10">Completed</span>
                      <% my_review = sub.reviews.detect { |r| r.author_id == current_user.id } %>
                      <% if my_review.nil? %>
                        <%= link_to "Leave Review", new_submission_review_path(sub), class: "btn btn-primary w-auto fs-12 btn-review" %>
                      <% else %>
                        <span class="fs-12 text-muted">Review Submitted</span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon"><i data-lucide="briefcase" class="icon-40"></i></div>
              <h3 class="empty-state-title">No Internships Yet</h3>
              <p class="empty-state-text">
                You haven't started or completed any internships on StageUp. Go search for active offers, apply, and complete your proof mission!
              </p>
              <%= link_to "Browse Internship Offers", offers_path, class: "btn btn-primary btn-compact-empty" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Recruiter Submissions Panel (Hiring Hub) & Active Internships -->
      <% if @role_type == "CompanyProfile" %>
        <div class="profile-card card-mb">
          <h2 class="section-heading">
            <i data-lucide="megaphone" class="section-heading-icon"></i>
            My Offers
          </h2>
          <% if @company_offers.any? %>
            <div class="inline-list-sm">
              <% @company_offers.each do |offer| %>
                <div class="inline-list-sm-item">
                  <div>
                    <strong class="inline-list-sm-title"><%= link_to offer.title, offer_path(offer), class: "offer-mgmt-link" %></strong>
                    <span class="inline-list-sm-meta">
                      <%= offer.status.humanize %> &middot; <%= offer.submissions.count %> applicant(s)
                    </span>
                  </div>
                  <div class="action-group-8">
                    <%= link_to "Edit", edit_offer_path(offer), class: "btn btn-primary btn-compact-sm" %>
                    <% if offer.draft? %>
                      <%= button_to "Delete", offer_path(offer), method: :delete, class: "btn btn-secondary btn-compact-danger-sm", data: { turbo_confirm: "Permanently delete this draft?" } %>
                    <% else %>
                      <%= button_to "Archive", offer_path(offer), method: :delete, class: "btn btn-secondary btn-compact-danger-sm", data: { turbo_confirm: "Archive this offer? It will no longer be visible to students." } %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon"><i data-lucide="megaphone" class="icon-40"></i></div>
              <h3 class="empty-state-title">No Offers Yet</h3>
              <p class="empty-state-text">You haven't posted any internship offers yet. Create your first one to attract candidates.</p>
              <%= link_to "Post an Offer", new_offer_path, class: "btn btn-primary btn-compact-empty" %>
            </div>
          <% end %>
        </div>

        <div class="profile-card card-mb">
          <h2 class="section-heading">
            <i data-lucide="briefcase" class="section-heading-icon"></i>
            Active & Past Internships
          </h2>
          <% if @active_internships.any? %>
            <div class="inline-list">
              <% @active_internships.each do |sub| %>
                <div class="inline-list-item">
                  <div>
                    <strong class="inline-list-item-title"><%= sub.student_profile.first_name %> <%= sub.student_profile.last_name %></strong>
                    <span class="inline-list-item-meta">
                      Role: <%= sub.offer.title %>
                    </span>
                  </div>
                  <div class="timeline-container">
                    <div class="timeline-steps">
                      <% submission_milestones(sub).each_with_index do |ms, idx| %>
                        <div class="timeline-step-wrapper">
                          <div class="timeline-tooltip">
                            <% if ms[:timestamp] %>
                              <%= ms[:timestamp].strftime("%b %d, %Y") %>
                            <% else %>
                              <%= ms[:complete] ? "Done" : "—" %>
                            <% end %>
                          </div>
                          <div class="timeline-step <%= ms[:complete] ? 'completed' : 'pending' %>">
                            <% if ms[:complete] %>
                              <svg class="timeline-step-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                            <% else %>
                              <%= idx + 1 %>
                            <% end %>
                          </div>
                          <% if idx < submission_milestones(sub).length - 1 %>
                            <div class="timeline-line <%= ms[:complete] ? 'completed' : 'pending' %>"></div>
                          <% end %>
                          <span class="timeline-label <%= ms[:complete] ? 'completed' : '' %>"><%= ms[:label] %></span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                  <div>
                    <% if sub.status == "accepted" %>
                      <div class="flex-col gap-8 items-end">
                        <div class="action-group">
                          <% if sub.company_confirmed_completed %>
                            <span class="badge-status badge-completion-pending">
                              Waiting for Student
                            </span>
                          <% else %>
                            <%= button_to "Mark Completed", confirm_completion_submission_path(sub), method: :post, class: "btn btn-primary btn-compact-success" %>
                            <%= button_to "Cancel", cancel_submission_path(sub), method: :post, class: "btn btn-secondary btn-compact-danger", data: { turbo_confirm: "Cancel this internship? This will notify the student." } %>
                          <% end %>
                        </div>
                        <div class="action-group">
                          <% if sub.internship_agreement %>
                            <% if sub.internship_agreement.status == "pending_signatures" %>
                              <span class="badge-status badge-pending">Awaiting: <%= sub.internship_agreement.pending_signatories.join(", ") %></span>
                            <% elsif sub.internship_agreement.status == "declined" %>
                              <span class="badge-status badge-declined">Agreement Declined</span>
                            <% end %>
                            <%= link_to "View & Sign Agreement", submission_internship_agreement_path(sub, sub.internship_agreement), class: "btn btn-primary btn-compact" %>
                            <% if sub.internship_agreement.status == "declined" %>
                              <%= link_to "Generate New Agreement", new_submission_internship_agreement_path(sub), class: "btn btn-secondary btn-compact" %>
                            <% end %>
                          <% else %>
                            <%= link_to "Generate Convention de Stage", new_submission_internship_agreement_path(sub), class: "btn btn-secondary btn-compact" %>
                          <% end %>
                        </div>
                      </div>
                    <% else %>
                      <span class="badge-status badge-completed mr-10">Completed</span>
                      <% my_review = sub.reviews.detect { |r| r.author_id == current_user.id } %>
                      <% if my_review.nil? %>
                        <%= link_to "Leave Review", new_submission_review_path(sub), class: "btn btn-primary w-auto fs-12 btn-review" %>
                      <% else %>
                        <span class="fs-12 text-muted">Review Submitted</span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon"><i data-lucide="briefcase" class="icon-40"></i></div>
              <h3 class="empty-state-title">No Active Internships</h3>
              <p class="empty-state-text">
                Once you review student submissions, accept their work, and start working together, your active student list will appear here.
              </p>
            </div>
          <% end %>
        </div>

        <div class="profile-card">
          <h2 class="section-heading">
            <i data-lucide="inbox" class="section-heading-icon"></i>
            Incoming Applications
          </h2>

          <% if @pending_submissions.any? || @processed_submissions.any? %>
            <div class="flex-col gap-20">
              <% @pending_submissions.group_by(&:offer).each do |offer, pending_subs| %>
                <div class="app-group-card">
                  <h3 class="app-group-title">
                    <%= offer.title %> (<%= pending_subs.size %> pending)
                  </h3>
                  
                  <div class="flex-col gap-15">
                    <% pending_subs.each do |sub| %>
                        <div class="app-item">
                          <div>
                            <strong class="fs-14 fw-600 text-primary">
                              <%= sub.student_profile.first_name %> <%= sub.student_profile.last_name %>
                            </strong>
                            <span class="block fs-12 text-secondary mt-4">
                              Major: <%= sub.student_profile.major %> | Class of <%= sub.student_profile.graduation_year %>
                            </span>
                            <span class="block fs-12 text-secondary mt-4">
                              Submitted: <%= time_ago_in_words(sub.submitted_at) %> ago
                            </span>
                            
                            <% if sub.student_profile.cv.attached? %>
                              <div class="cv-link mt-8 fs-13">
                                📄 <%= link_to "Download Candidate CV", rails_blob_path(sub.student_profile.cv, disposition: "attachment"), target: "_blank" %>
                              </div>
                            <% else %>
                              <div class="mt-8 fs-12 text-muted">
                                ⚠️ No CV attached (candidate hasn't uploaded one).
                              </div>
                            <% end %>

                            <% if sub.github_link.present? %>
                              <div class="solution-link mt-8 fs-13">
                                🔗 <%= link_to "View Proof Solution", sub.github_link, target: "_blank" %>
                                <% if sub.auto_verification_status == "checking" || sub.auto_verification_status == "pending" %>
                                  <span class="badge-status badge-pending ml-8">Checking URL...</span>
                                <% elsif sub.auto_verification_status == "passed" %>
                                  <span class="badge-status badge-completed ml-8">✓ Passed Auto-Check</span>
                                <% elsif sub.auto_verification_status == "failed" %>
                                  <span class="badge-status badge-rejected ml-8" title="<%= sub.auto_verification_log %>">✗ Failed Auto-Check</span>
                                <% end %>
                              </div>
                            <% end %>

                            <% if sub.submission_notes.present? %>
                              <p class="sub-notes">
                                "<%= sub.submission_notes %>"
                              </p>
                            <% end %>
                          </div>

                          <div class="flex-row gap-8">
                            <%= button_to "Accept", accept_submission_path(sub), method: :post, class: "btn btn-primary w-auto fs-12 btn-review-accept" %>
                            <%= button_to "Reject", reject_submission_path(sub), method: :post, class: "btn btn-secondary w-auto fs-12 btn-review-reject" %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>

              <% if @processed_submissions.any? %>
                <div class="mt-15">
                  <h4 class="fs-14 text-secondary mb-10">Processed History</h4>
                  <table class="processed-table">
                    <thead>
                      <tr>
                        <th>Student</th>
                        <th>Offer</th>
                        <th>Status</th>
                        <th>Actioned</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @processed_submissions.each do |sub| %>
                        <tr>
                          <td><%= sub.student_profile.first_name %> <%= sub.student_profile.last_name %></td>
                          <td><%= sub.offer.title %></td>
                          <td>
                            <span class="badge-status <%= sub.status == 'accepted' ? 'badge-accepted' : (sub.status == 'completed' ? 'badge-completed' : 'badge-rejected') %>">
                              <%= sub.status %>
                            </span>
                          </td>
                          <td><%= sub.responded_at ? time_ago_in_words(sub.responded_at) + " ago" : "N/A" %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="empty-state-card">
              <div class="empty-state-icon"><i data-lucide="inbox" class="icon-40"></i></div>
              <h3 class="empty-state-title">No Applications Yet</h3>
              <p class="empty-state-text">
                You haven't received any student applications yet. Keep posting offers to attract more candidate talent.
              </p>
              <%= link_to "Post a New Offer", new_offer_path, class: "btn btn-primary btn-compact-empty" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Right Column: Reputation Metrics & Event History -->
    <div class="right-col">
      
      <!-- Metrics Card -->
      <div class="profile-card p-25">
        <h3 class="metrics-card-title">
          Reputation Metrics
        </h3>
        
        <% if @role_type == "StudentProfile" %>
          <div class="text-center py-15">
            <div class="flex-center mb-12">
              <% score = @profile.commitment_score.round(0) %>
              <div class="score-pill">
                <span class="dot <%= score >= 90 ? 'dot-success' : (score >= 70 ? 'dot-warning' : 'dot-danger') %>"></span>
                <strong><%= score %></strong>
                <span class="score-label">Commitment</span>
              </div>
            </div>
            <p class="score-caption">Reliability score based on your internship history</p>
            
            <% student_avg = @profile.average_rating %>
            <% if student_avg %>
              <div class="flex-center mt-15">
                <div class="rating-display">
                  <i data-lucide="star"></i>
                  <strong><%= student_avg %></strong>
                  <span class="rating-count">(<%= @profile.reviews_received_count %> reviews)</span>
                </div>
              </div>
            <% else %>
              <div class="unrated-text">Unrated (No reviews yet)</div>
            <% end %>
          </div>

        <% elsif @role_type == "CompanyProfile" %>
          <% if @completed_internships_count < 3 %>
            <div class="flex-center mb-12">
              <div class="badge-grace" title="Commitment score is protected during your first 3 internships to help you get established.">
                <i data-lucide="sparkles"></i>
                <span>New Recruiter (Grace Period)</span>
              </div>
            </div>
          <% end %>

          <% company_score = @profile.commitment_score.round(0) %>
          <div class="flex-center mb-15">
            <div class="score-pill">
              <span class="dot <%= company_score >= 90 ? 'dot-success' : (company_score >= 70 ? 'dot-warning' : 'dot-danger') %>"></span>
              <strong><%= company_score %></strong>
              <span class="score-label">Commitment</span>
            </div>
          </div>

          <div class="metrics-list">
            <div class="metrics-row">
              <span class="metrics-label">Response Rate:</span>
              <strong class="metrics-value-success"><%= @profile.response_rate %>%</strong>
            </div>
            <div class="metrics-row">
              <span class="metrics-label">Avg. Decision Time:</span>
              <strong><%= @profile.avg_response_time_hours %> hours</strong>
            </div>
            <div class="metrics-row">
              <span class="metrics-label">Active Offers:</span>
              <strong><%= @offers_count %></strong>
            </div>
            <div class="metrics-rating-row">
              <span class="metrics-label">Average Rating:</span>
              <% company_avg = @profile.average_rating %>
              <% if company_avg %>
                <div class="rating-display">
                  <i data-lucide="star"></i>
                  <strong><%= company_avg %></strong>
                  <span class="rating-count">(<%= @profile.reviews_received_count %> reviews)</span>
                </div>
              <% else %>
                <strong class="text-secondary">Unrated</strong>
              <% end %>
            </div>
          </div>

        <% elsif @role_type == "UniversityProfile" %>
          <div class="metrics-list">
            <div class="metrics-row">
              <span class="metrics-label">Students Registered:</span>
              <strong><%= @total_students_count %></strong>
            </div>
            <div class="metrics-row">
              <span class="metrics-label">Active/Completed Internships:</span>
              <strong><%= @active_internships_count %></strong>
            </div>
            <div class="metrics-rating-row">
              <span class="metrics-label">Avg Commitment Score:</span>
              <div class="score-pill">
                <span class="dot <%= @avg_student_score >= 90 ? 'dot-success' : (@avg_student_score >= 70 ? 'dot-warning' : 'dot-danger') %>"></span>
                <strong><%= @avg_student_score %></strong>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Reputation History Ledger / Commitment Timeline -->
      <% if @role_type == "UniversityProfile" %>
        <div class="profile-card p-25">
          <h3 class="metrics-card-title">
            <i data-lucide="activity" class="icon-16 stroke-secondary v-align-middle mr-4"></i>
            University Reputation Feed
          </h3>

          <% if @recent_reputation_events.any? %>
            <div class="ledger-timeline">
              <% @recent_reputation_events.each do |event| %>
                <div class="ledger-event">
                  <div class="ledger-event-line"></div>
                  <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                  <div class="ledger-event-body">
                    <div class="ledger-event-header">
                      <span class="ledger-event-person"><%= event.profileable.first_name %> <%= event.profileable.last_name %></span>
                      <span class="ledger-event-delta <%= event.score_delta > 0 ? 'delta-positive' : 'delta-negative' %>">
                        <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %>
                      </span>
                    </div>
                    <p class="ledger-event-desc"><%= event.description %></p>
                    <span class="ledger-event-time"><%= time_ago_in_words(event.created_at) %> ago</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="ledger-empty">
              No reputation events logged yet for your university.
            </p>
          <% end %>
        </div>
      <% else %>
        <div class="profile-card p-25">
          <h3 class="metrics-card-title">
            Commitment Ledger
          </h3>

          <% if @commitment_ledger_events.any? %>
            <div class="ledger-timeline">
              <% @commitment_ledger_events.each do |event| %>
                <div class="ledger-event">
                  <div class="ledger-event-line"></div>
                  <div class="ledger-event-node <%= event.score_delta > 0 ? 'node-positive' : (event.score_delta == 0 ? 'node-neutral' : 'node-negative') %>"></div>
                  <div class="ledger-event-body">
                    <div class="ledger-event-header">
                      <span class="ledger-event-title">Action</span>
                      <span class="ledger-event-delta <%= event.score_delta > 0 ? 'delta-positive' : 'delta-negative' %>">
                        <%= event.score_delta > 0 ? "+#{event.score_delta}" : event.score_delta %>
                      </span>
                    </div>
                    <p class="ledger-event-desc"><%= event.description %></p>
                    <span class="ledger-event-time"><%= time_ago_in_words(event.created_at) %> ago</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="ledger-empty">
              No reputation events logged yet.
            </p>
          <% end %>
        </div>
      <% end %>

    </div>

  </div>

</div>
