<%# ─── Real-Time Drag-and-Drop Kanban Board ───────────────────────── %>
<div class="kanban-board">

  <%# Column 1: Submitted & Under Review %>
  <div class="kanban-col kanban-drop-zone" data-target-status="pending">
    <div class="kanban-col-header flex-between">
      <div class="flex-align-center gap-6">
        <span class="status-dot dot-amber"></span>
        <span class="kanban-col-title"><%= t('kanban.columns.review', default: 'UNDER REVIEW') %></span>
      </div>
      <span class="kanban-col-count"><%= (pending_submissions || []).count %></span>
    </div>

    <div class="kanban-card-list">
      <% if (pending_submissions || []).any? %>
        <% (pending_submissions || []).each do |sub| %>
          <div class="kanban-card" draggable="true" data-submission-id="<%= sub.id %>" data-status="<%= sub.status %>">
            <div class="kanban-card-header flex-between mb-8">
              <div class="flex-align-center gap-8">
                <div class="kanban-avatar">
                  <%= sub.student_profile.first_name.first.upcase rescue 'S' %>
                </div>
                <div>
                  <div class="kanban-student-name"><%= sub.student_profile.first_name %> <%= sub.student_profile.last_name %></div>
                  <div class="kanban-uni-label"><%= sub.student_profile.university&.name || sub.student_profile.major.presence || t('dashboard.profile_bento.student') %></div>
                </div>
              </div>
              <span class="rep-score-pill-sm">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <strong><%= sub.student_profile.commitment_score.round(0) rescue 100 %></strong>
              </span>
            </div>

            <div class="kanban-card-offer mb-10">
              <span class="badge-offer-title"><%= sub.offer.title %></span>
            </div>

            <div class="kanban-card-proof mb-12">
              <% if sub.github_link.present? %>
                <%= link_to sub.github_link, target: "_blank", class: "btn-proof-link" do %>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                  <%= t('kanban.card.view_proof', default: 'View Proof') %>
                <% end %>
              <% end %>
              <% if sub.student_profile.cv.attached? %>
                <%= link_to rails_blob_path(sub.student_profile.cv, disposition: "inline"), target: "_blank", class: "btn-proof-link ml-4" do %>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><polyline points="14 2 14 8 20 8"/></svg>
                  CV
                <% end %>
              <% end %>
            </div>

            <div class="kanban-card-actions flex-between">
              <div class="action-buttons-row">
                <%= button_to accept_submission_path(sub), method: :post, class: "btn btn-primary btn-compact-xs", data: { disable_with: "..." } do %>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                  <%= t('kanban.actions.accept', default: 'Accept') %>
                <% end %>
                <%= button_to reject_submission_path(sub), method: :post, class: "btn btn-secondary btn-compact-xs-danger", data: { disable_with: "..." } do %>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  <%= t('kanban.actions.reject', default: 'Reject') %>
                <% end %>
              </div>
              <span class="kanban-card-date"><%= sub.created_at.strftime("%b %d") %></span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="kanban-empty-col">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 12h6"/></svg>
          <span><%= t('kanban.empty.review', default: 'No pending submissions') %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# Column 2: Accepted / Active %>
  <div class="kanban-col kanban-drop-zone" data-target-status="accept">
    <div class="kanban-col-header flex-between">
      <div class="flex-align-center gap-6">
        <span class="status-dot dot-emerald"></span>
        <span class="kanban-col-title"><%= t('kanban.columns.accepted', default: 'ACCEPTED') %></span>
      </div>
      <span class="kanban-col-count"><%= (active_internships || []).count %></span>
    </div>

    <div class="kanban-card-list">
      <% if (active_internships || []).any? %>
        <% (active_internships || []).each do |sub| %>
          <div class="kanban-card" draggable="true" data-submission-id="<%= sub.id %>" data-status="<%= sub.status %>">
            <div class="kanban-card-header flex-between mb-8">
              <div class="flex-align-center gap-8">
                <div class="kanban-avatar avatar-emerald">
                  <%= sub.student_profile.first_name.first.upcase rescue 'S' %>
                </div>
                <div>
                  <div class="kanban-student-name"><%= sub.student_profile.first_name %> <%= sub.student_profile.last_name %></div>
                  <div class="kanban-uni-label"><%= sub.student_profile.university&.name || sub.student_profile.major.presence || t('dashboard.profile_bento.student') %></div>
                </div>
              </div>
              <span class="badge-status badge-accepted"><%= t('kanban.columns.accepted', default: 'ACCEPTED') %></span>
            </div>

            <div class="kanban-card-offer mb-10">
              <span class="badge-offer-title"><%= sub.offer.title %></span>
            </div>

            <div class="kanban-card-footer flex-between">
              <span class="kanban-card-date"><%= sub.responded_at&.strftime("%b %d") || sub.created_at.strftime("%b %d") %></span>
              <% if sub.internship_agreement %>
                <%= link_to submission_internship_agreement_path(sub, sub.internship_agreement), class: "btn-proof-link" do %>
                  <%= t('kanban.card.agreement', default: 'Agreement') %> &rarr;
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="kanban-empty-col">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span><%= t('kanban.empty.accepted', default: 'No active accepted candidates') %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# Column 3: Rejected %>
  <div class="kanban-col kanban-drop-zone" data-target-status="reject">
    <div class="kanban-col-header flex-between">
      <div class="flex-align-center gap-6">
        <span class="status-dot dot-rose"></span>
        <span class="kanban-col-title"><%= t('kanban.columns.rejected', default: 'REJECTED') %></span>
      </div>
      <span class="kanban-col-count"><%= (processed_submissions || []).select { |s| s.status == "rejected" }.count rescue 0 %></span>
    </div>

    <div class="kanban-card-list">
      <% rejected_list = (processed_submissions || []).select { |s| s.status == "rejected" } %>
      <% if rejected_list.any? %>
        <% rejected_list.each do |sub| %>
          <div class="kanban-card" draggable="true" data-submission-id="<%= sub.id %>" data-status="<%= sub.status %>">
            <div class="kanban-card-header flex-between mb-8">
              <div class="flex-align-center gap-8">
                <div class="kanban-avatar avatar-muted">
                  <%= sub.student_profile.first_name.first.upcase rescue 'S' %>
                </div>
                <div>
                  <div class="kanban-student-name"><%= sub.student_profile.first_name %> <%= sub.student_profile.last_name %></div>
                  <div class="kanban-uni-label"><%= sub.student_profile.major.presence || t('dashboard.profile_bento.student') %></div>
                </div>
              </div>
              <span class="badge-status badge-rejected"><%= t('kanban.columns.rejected', default: 'REJECTED') %></span>
            </div>

            <div class="kanban-card-offer mb-10">
              <span class="badge-offer-title"><%= sub.offer.title %></span>
            </div>

            <div class="kanban-card-footer flex-between">
              <span class="kanban-card-date"><%= sub.responded_at&.strftime("%b %d") || sub.created_at.strftime("%b %d") %></span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="kanban-empty-col">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <span><%= t('kanban.empty.rejected', default: 'No rejected applications') %></span>
        </div>
      <% end %>
    </div>
  </div>

</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    function initKanban() {
      var csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

      document.querySelectorAll('.kanban-card').forEach(function(card) {
        card.addEventListener('dragstart', function(e) {
          e.dataTransfer.setData('text/plain', card.dataset.submissionId);
          card.classList.add('dragging');
        });

        card.addEventListener('dragend', function() {
          card.classList.remove('dragging');
        });
      });

      document.querySelectorAll('.kanban-drop-zone').forEach(function(zone) {
        zone.addEventListener('dragover', function(e) {
          e.preventDefault();
          zone.classList.add('drag-over');
        });

        zone.addEventListener('dragleave', function() {
          zone.classList.remove('drag-over');
        });

        zone.addEventListener('drop', function(e) {
          e.preventDefault();
          zone.classList.remove('drag-over');
          var submissionId = e.dataTransfer.getData('text/plain');
          var targetStatus = zone.dataset.targetStatus;
          if (!submissionId || !targetStatus) return;

          var url = '/submissions/' + submissionId + '/' + targetStatus;
          fetch(url, {
            method: 'POST',
            headers: {
              'X-CSRF-Token': csrfToken,
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            }
          }).then(function(res) {
            if (res.ok) {
              window.location.reload();
            }
          }).catch(function(err) {
            console.error('Kanban drag error:', err);
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKanban);
    } else {
      initKanban();
    }
  })();
</script>
