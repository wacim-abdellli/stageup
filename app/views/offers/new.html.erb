<div class="auth-container auth-container-compact">
  <div class="auth-card auth-card-wide">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Post an Internship Offer</h2>
      <p class="auth-subtitle">Add your requirements and attach an optional proof mission</p>
    </div>

    <%= form_with model: @offer, local: true do |f| %>
      
      <!-- Validation Errors -->
      <% if @offer.errors.any? %>
        <div class="flash-message flash-alert flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
            <strong>Please resolve the following errors:</strong>
          </div>
          <ul class="error-list">
            <% @offer.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h3 class="section-heading-lg">
        1. Internship Details
      </h3>

      <div class="form-group">
        <label class="form-label" for="offer_title">Internship Title</label>
        <%= f.text_field :title, id: "offer_title", class: "form-control", placeholder: "e.g. Front-End Web Developer Intern", required: true %>
      </div>

      <div class="form-group">
        <label class="form-label" for="offer_description">Detailed Description & Requirements</label>
        <%= f.text_area :description, id: "offer_description", class: "form-control", rows: 5, placeholder: "Describe the tasks, tools, and profile you are looking for...", required: true %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="offer_stage_type">Stage Type</label>
          <%= f.select :stage_type, [["PFE (Graduation)", "PFE"], ["PFA (Mid-Study)", "PFA"], ["Initiation / Observation", "initiation"], ["Free / Skill-Building", "free"]], { prompt: "Select Stage Type" }, { id: "offer_stage_type", class: "form-control", required: true } %>
        </div>

        <div class="form-group">
          <label class="form-label" for="offer_spots">Available Spots</label>
          <%= f.number_field :spots, id: "offer_spots", class: "form-control", min: 1, required: true %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="offer_location">Location (Tunisia)</label>
          <%= f.text_field :location, id: "offer_location", class: "form-control", placeholder: "e.g. Sfax", required: true %>
        </div>

        <div class="form-group">
          <label class="form-label" for="offer_work_mode">Work Mode</label>
          <%= f.select :work_mode, [["On-Site", "onsite"], ["Remote", "remote"], ["Hybrid", "hybrid"]], {}, { id: "offer_work_mode", class: "form-control", required: true } %>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="offer_deadline">Application Deadline (Optional)</label>
        <%= f.date_field :deadline, id: "offer_deadline", class: "form-control" %>
      </div>

      <h3 class="section-heading-mission">
        2. Proof of Work Mission (Optional)
      </h3>
      <p class="mission-info-text">
        Attach a small test (30-90 min) to filter candidate capability. If you leave these fields empty, candidates will apply directly with their standard CVs.
      </p>

      <%= f.fields_for :mission do |m| %>
        <div class="form-group">
          <label class="form-label" for="mission_title">Mission Title</label>
          <%= m.text_field :title, id: "mission_title", class: "form-control", placeholder: "e.g. Build a Responsive Navigation Bar" %>
        </div>

        <div class="form-group">
          <label class="form-label" for="mission_instructions">Mission Instructions & Rubric</label>
          <%= m.text_area :instructions, id: "mission_instructions", class: "form-control", rows: 4, placeholder: "Provide the goal, specifications, resources, and evaluation details..." %>
        </div>

        <div class="form-group">
          <label class="form-label" for="mission_duration">Estimated Completion Time (Minutes)</label>
          <%= m.number_field :estimated_duration_minutes, id: "mission_duration", class: "form-control", placeholder: "e.g. 60" %>
        </div>
      <% end %>

      <div class="form-footer-row">
        <%= link_to "Cancel", dashboard_path, class: "btn btn-secondary" %>
        <%= f.submit "Post Internship & Mission", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
