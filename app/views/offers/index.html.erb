<div class="dashboard-container">
  <div class="dashboard-header">
    <div>
      <%= render "layouts/navbar_brand" %>
      <p class="text-secondary fs-14 mt-6">Tunisia's first verified internship directory</p>
    </div>
    <div class="flex-row gap-12 items-center">
      <% if current_user %>
        <%= link_to "My Dashboard", dashboard_path, class: "btn glass-card text-decoration-none fs-13", style: "padding: 10px 20px;" %>
        <% if current_user.profileable_type == "CompanyProfile" %>
          <%= link_to "Post an Offer", new_offer_path, class: "btn btn-accent text-decoration-none fs-13", style: "padding: 10px 20px;" %>
        <% end %>
        <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn glass-card fs-13", style: "padding: 10px 20px; margin: 0; color: #F87171;" %>
      <% else %>
        <%= link_to "Sign In / Register", new_user_session_path, class: "btn btn-accent text-decoration-none fs-13", style: "padding: 10px 20px;" %>
      <% end %>
    </div>
  </div>

  <div class="offers-directory-layout items-start" style="display: grid; grid-template-columns: 280px 1fr; gap: 32px;">
    
    <div class="glass-card sticky-top-20" style="padding: 24px; border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
      <h3 class="fs-16 inline-flex-center-gap-8" style="font-weight: 700; margin-bottom: 20px; color: var(--text-primary);">
        <i data-lucide="sliders-horizontal" class="icon-16 stroke-secondary"></i>
        Filter Offers
      </h3>

      <%= form_tag offers_path, method: :get, id: "filters-form" do %>
        <div style="margin-bottom: 20px;">
          <label class="label-sm">Search keyword</label>
          <div class="pos-relative">
            <i data-lucide="search" class="search-icon-abs stroke-muted" style="width: 14px; height: 14px;"></i>
            <%= text_field_tag :query, params[:query], placeholder: "Search title, company...", class: "fs-13", style: "width: 100%; padding: 10px 12px 10px 36px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); color: white;" %>
          </div>
        </div>

        <div style="margin-bottom: 20px;">
          <label class="label-sm">Stage Type</label>
          <%= select_tag :stage_type, options_for_select([["All types", ""], ["PFE", "PFE"], ["PFA", "PFA"]], params[:stage_type]), onchange: "this.form.submit();", class: "fs-13", style: "width: 100%; padding: 10px 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); color: white; cursor: pointer;" %>
        </div>

        <div style="margin-bottom: 24px;">
          <label class="label-sm">Work Mode</label>
          <%= select_tag :work_mode, options_for_select([["All modes", ""], ["Remote", "remote"], ["On-site", "onsite"], ["Hybrid", "hybrid"]], params[:work_mode]), onchange: "this.form.submit();", class: "fs-13", style: "width: 100%; padding: 10px 12px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: var(--radius-md); color: white; cursor: pointer;" %>
        </div>

        <div class="flex-col gap-8">
          <%= submit_tag "Apply Search", class: "btn btn-accent fs-13", style: "width: 100%; padding: 10px; cursor: pointer;" %>
          <% if params[:query].present? || params[:stage_type].present? || params[:work_mode].present? %>
            <%= link_to "Reset Filters", offers_path, class: "btn glass-card text-decoration-none fs-13", style: "width: 100%; padding: 10px; text-align: center;" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <div class="flex-row justify-between items-center" style="margin-bottom: 20px;">
        <h2 class="fs-20" style="font-weight: 700; color: white; margin: 0;">Available Internships</h2>
        <span class="fs-13 text-secondary"><%= pluralize(@offers.size, 'internship') %> found</span>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px;">
        <% if @offers.any? %>
          <% @offers.each do |offer| %>
            <div class="glass-card offer-card" onclick="window.location='<%= offer_path(offer) %>'">
              <div>
                <div class="offer-card-header">
                  <span class="offer-card-badge-stage"><%= offer.stage_type %></span>
                  
                  <% if offer.mission.present? %>
                    <span class="offer-card-badge-proof inline-flex-center">
                      <i data-lucide="git-commit" class="icon-w-12 stroke-accent"></i>
                      Mission Attached
                    </span>
                  <% else %>
                    <span class="offer-card-badge-cv inline-flex-center">
                      <i data-lucide="check-circle" class="icon-w-12 stroke-secondary"></i>
                      CV Only
                    </span>
                  <% end %>
                </div>

                <h3 class="offer-card-title"><%= offer.title %></h3>
                <span class="offer-card-company"><%= offer.company_profile.name %></span>
                
                <p class="offer-card-desc">
                  <%= offer.description %>
                </p>
              </div>

              <div class="offer-card-footer">
                <span class="offer-card-location">
                  <i data-lucide="map-pin" class="icon-w-12 stroke-secondary"></i>
                  <% if offer.location.downcase == "remote" %>
                    Remote
                  <% else %>
                    <%= offer.location %> (<%= offer.work_mode.capitalize %>)
                  <% end %>
                </span>
                <span class="offer-card-action">
                  Details <i data-lucide="arrow-right" class="icon-w-12 stroke-accent"></i>
                </span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="glass-card empty-state-icon" style="grid-column: 1 / -1; text-align: center; padding: 48px; border: 1px solid var(--border-color); border-radius: var(--radius-lg);">
            <i data-lucide="search-code" style="width: 40px; height: 40px; margin-bottom: 12px; display: inline-block;"></i>
            <h3 class="fs-16" style="font-weight: 600; color: white; margin-bottom: 6px;">No offers match your criteria</h3>
            <p class="text-secondary fs-13" style="margin: 0;">Try broadening your query or clearing active filters.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 992px) {
    .offers-directory-layout {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
  }
</style>
