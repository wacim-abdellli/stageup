<div class="dashboard-container">
  <div class="dashboard-header">
    <p class="text-secondary fs-14 mt-6">Tunisia's first verified internship directory</p>
    <% unless current_user %>
      <%= link_to "Sign In / Register", new_user_session_path, class: "btn btn-accent text-decoration-none fs-13 btn-header-padded" %>
    <% end %>
  </div>

  <div class="offers-directory-grid items-start">
    
    <div class="glass-card sticky-top-20 filter-sidebar-card">
      <h3 class="fs-16 inline-flex-center-gap-8 filter-title">
        <i data-lucide="sliders-horizontal" class="icon-16 stroke-secondary"></i>
        Filter Offers
      </h3>

      <%= form_tag offers_path, method: :get, id: "filters-form" do %>
        <div class="filter-section">
          <label class="label-sm">Search keyword</label>
          <div class="pos-relative">
            <i data-lucide="search" class="search-icon-abs stroke-muted icon-14"></i>
            <%= text_field_tag :query, params[:query], placeholder: "Search title, company...", class: "fs-13 form-search-field" %>
          </div>
        </div>

        <div class="filter-section">
          <label class="label-sm">Stage Type</label>
          <%= select_tag :stage_type, options_for_select([["All types", ""], ["PFE", "PFE"], ["PFA", "PFA"]], params[:stage_type]), onchange: "this.form.submit();", class: "fs-13 form-select-filter" %>
        </div>

        <div class="filter-section-last">
          <label class="label-sm">Work Mode</label>
          <%= select_tag :work_mode, options_for_select([["All modes", ""], ["Remote", "remote"], ["On-site", "onsite"], ["Hybrid", "hybrid"]], params[:work_mode]), onchange: "this.form.submit();", class: "fs-13 form-select-filter" %>
        </div>

        <div class="flex-col gap-8">
          <%= submit_tag "Apply Search", class: "btn btn-accent fs-13 btn-filter-apply" %>
          <% if params[:query].present? || params[:stage_type].present? || params[:work_mode].present? %>
            <%= link_to "Reset Filters", offers_path, class: "btn glass-card text-decoration-none fs-13 btn-filter-reset" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <div class="flex-row justify-between items-center mb-20">
        <h2 class="fs-20 section-title-lg">Available Internships</h2>
        <span class="fs-13 text-secondary"><%= pluralize(@offers.size, 'internship') %> found</span>
      </div>

      <div class="offers-grid">
        <% if @offers.any? %>
          <% @offers.each do |offer| %>
            <div class="glass-card offer-card" onclick="window.location='<%= offer_path(offer) %>'">
              <div>
                <div class="offer-card-header">
                  <span class="offer-card-badge-stage"><%= offer.stage_type %></span>
                  
                  <% if offer.mission.present? %>
                    <span class="offer-card-badge-proof inline-flex-center">
                      <i data-lucide="git-commit" class="icon-w-12 stroke-accent"></i>
                      Mission Attached
                    </span>
                  <% else %>
                    <span class="offer-card-badge-cv inline-flex-center">
                      <i data-lucide="check-circle" class="icon-w-12 stroke-secondary"></i>
                      CV Only
                    </span>
                  <% end %>
                </div>

                <h3 class="offer-card-title"><%= offer.title %></h3>
                <span class="offer-card-company"><%= offer.company_profile.name %></span>
                
                <p class="offer-card-desc">
                  <%= offer.description %>
                </p>

                <% if offer.skills.any? %>
                  <div class="flex-row flex-wrap gap-4 mt-8">
                    <% offer.skills.each do |skill| %>
                      <span class="skill-tag-sm"><%= skill.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <div class="offer-card-footer">
                <span class="offer-card-location">
                  <i data-lucide="map-pin" class="icon-w-12 stroke-secondary"></i>
                  <% if offer.location.downcase == "remote" %>
                    Remote
                  <% else %>
                    <%= offer.location %> (<%= offer.work_mode.capitalize %>)
                  <% end %>
                </span>
                <span class="offer-card-action flex-row gap-4 items-center">
                  Details <i data-lucide="arrow-right" class="icon-w-12 stroke-accent"></i>
                  <% if current_user&.profileable_type == "StudentProfile" %>
                    <% match_pct = offer.match_percentage_for(current_user.profileable) %>
                    <% if match_pct < 100 %>
                      <span class="match-badge <%= match_pct >= 70 ? 'match-badge-high' : (match_pct >= 40 ? 'match-badge-medium' : 'match-badge-low') %>"><%= match_pct %>% Match</span>
                    <% end %>
                  <% end %>
                </span>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="glass-card empty-state-full">
            <i data-lucide="search-code" class="empty-state-icon-lg"></i>
            <h3 class="fs-16 empty-state-heading">No offers match your criteria</h3>
            <p class="text-secondary fs-13 m-0">Try broadening your query or clearing active filters.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  @media (max-width: 992px) {
    .offers-directory-grid {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
  }
</style>
