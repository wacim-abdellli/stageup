<div class="dashboard-container">
  <div class="dashboard-header">
    <div>
      <%= render "layouts/navbar_brand" %>
      <p style="color: var(--text-secondary); font-size: 14px;">Browse active internship opportunities in Tunisia</p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center;">
      <% if current_user %>
        <%= link_to "My Dashboard", dashboard_path, class: "btn btn-secondary", style: "width: auto; padding: 8px 16px; font-size: 13px;" %>
        <% if current_user.profileable_type == "CompanyProfile" %>
          <%= link_to "Post an Offer", new_offer_path, class: "btn btn-primary", style: "width: auto; padding: 8px 16px; font-size: 13px;" %>
        <% end %>
        <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "btn btn-secondary", style: "width: auto; padding: 8px 16px; font-size: 13px; margin: 0;" %>
      <% else %>
        <%= link_to "Sign In / Register", new_user_session_path, class: "btn btn-accent", style: "width: auto; padding: 8px 16px; font-size: 13px; text-decoration: none;" %>
      <% end %>
    </div>
  </div>

  <h2 style="font-size: 22px; margin-bottom: 25px;">Available Internships</h2>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 20px;">
    <% if @offers.any? %>
      <% @offers.each do |offer| %>
         <div class="profile-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 25px; transition: var(--transition); cursor: pointer;" onclick="window.location='<%= offer_path(offer) %>'">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
              <div>
                <h3 style="font-size: 18px; margin-bottom: 4px;"><%= offer.title %></h3>
                <span style="font-size: 14px; color: var(--text-secondary);"><%= offer.company_profile.name %></span>
              </div>
              <span class="badge-status" style="border: 1px solid var(--border-color); color: var(--text-secondary); background: transparent; text-transform: uppercase;"><%= offer.stage_type %></span>
            </div>

            <p style="color: var(--text-secondary); font-size: 14px; line-height: 1.6; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
              <%= offer.description %>
            </p>
          </div>

          <div style="border-top: 1px solid var(--border-color); padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
              <% if offer.location.downcase != "remote" %>
                <span class="badge-status" style="border: 1px solid var(--border-color); color: var(--text-secondary); background: transparent; display: inline-flex; align-items: center; gap: 4px; text-transform: none; padding: 2px 8px;">
                  <i data-lucide="map-pin" style="width: 12px; height: 12px; stroke: var(--text-secondary);"></i>
                  <%= offer.location %>
                </span>
              <% end %>
              <span class="badge-status" style="border: 1px solid var(--border-color); color: var(--text-secondary); background: transparent; display: inline-flex; align-items: center; gap: 4px; text-transform: none; padding: 2px 8px;">
                <i data-lucide="monitor" style="width: 12px; height: 12px; stroke: var(--text-secondary);"></i>
                <%= offer.work_mode.capitalize %>
              </span>
              <% if offer.mission %>
                <span class="badge-status" style="background: rgba(99, 102, 241, 0.06); border: 1px solid rgba(99, 102, 241, 0.2); color: #818CF8; display: inline-flex; align-items: center; gap: 4px; text-transform: none; padding: 2px 8px;">
                  <i data-lucide="git-commit" style="width: 12px; height: 12px; stroke: #818CF8;"></i>
                  Mission Attached
                </span>
              <% else %>
                <span class="badge-status" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); color: var(--text-secondary); display: inline-flex; align-items: center; gap: 4px; text-transform: none; padding: 2px 8px;">
                  <i data-lucide="check-circle" style="width: 12px; height: 12px; stroke: var(--text-secondary);"></i>
                  CV Only
                </span>
              <% end %>
            </div>
            <%= link_to "Details →", offer_path(offer), style: "font-size: 13px; font-weight: 600;" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="profile-card" style="grid-column: 1 / -1; text-align: center; padding: 40px;">
        <p style="color: var(--text-secondary);">No active internship offers available at the moment.</p>
      </div>
    <% end %>
  </div>
</div>
