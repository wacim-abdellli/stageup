<% content_for :title, t('offers.index.title', default: "Available Internships – StageUp") %>

<div class="dir-page">
  <%
    stage_type_options = [
      [t('offers.index.filters.all_types'), ""],
      ["PFE", "PFE"],
      ["PFA", "PFA"],
      [t('common.stage_types.initiation'), "initiation"],
      [t('common.stage_types.free'), "free"]
    ]
    work_mode_options = [
      [t('offers.index.filters.all_modes'), ""],
      [t('common.work_modes.remote'), "remote"],
      [t('common.work_modes.on_site'), "onsite"],
      [t('common.work_modes.hybrid'), "hybrid"]
    ]
    selected_stage_type = stage_type_options.find { |_, value| value == params[:stage_type].to_s } || stage_type_options.first
    selected_work_mode = work_mode_options.find { |_, value| value == params[:work_mode].to_s } || work_mode_options.first
  %>

  <%# ─── Page Header ─────────────────────────────────────────── %>
  <div class="dir-header">
    <div>
      <div class="dir-eyebrow">
        <svg class="icon-indigo" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span><%= t('offers.index.eyebrow', default: 'VERIFIED OPPORTUNITIES') %></span>
      </div>
      <h1 class="dir-heading"><%= t('offers.index.title') %></h1>
      <p class="dir-sub"><%= t('offers.index.subtitle') %> &mdash; <%= t('offers.index.active_listings', count: @offers.size) %></p>
    </div>
    <% unless current_user %>
      <%= link_to new_user_session_path, class: "dir-signin-cta" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
        <span><%= t('nav.sign_in') %></span>
      <% end %>
    <% end %>
  </div>

  <div class="dir-body">

    <%# ─── Filter Sidebar ──────────────────────────────────────── %>
    <aside class="dir-sidebar">
      <div class="sidebar-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><line x1="4" x2="20" y1="21" y2="21"/><line x1="4" x2="20" y1="14" y2="14"/><line x1="4" x2="20" y1="7" y2="7"/><circle cx="8" cy="14" r="2"/><circle cx="16" cy="7" r="2"/><circle cx="12" cy="21" r="2"/></svg>
        <span class="sidebar-title"><%= t('offers.index.filters.title', default: 'Filters') %></span>
      </div>

      <%= form_tag offers_path, method: :get, id: "filters-form" do %>
        <div class="sidebar-field">
          <label class="filter-label"><%= t('offers.index.filters.search_placeholder') %></label>
          <div class="pos-relative">
            <svg class="search-icon-abs" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <%= text_field_tag :query, params[:query],
                placeholder: t('offers.index.filters.search_placeholder'),
                class: "filter-input",
                autocomplete: "off" %>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-field">
          <label class="filter-label"><%= t('offers.index.filters.stage_type') %></label>
          <div class="select-wrap custom-select" data-filter-select>
            <%= hidden_field_tag :stage_type, params[:stage_type].to_s, data: { filter_select_input: true } %>
            <button type="button"
                    class="filter-select custom-select-trigger"
                    data-filter-select-trigger
                    aria-haspopup="listbox"
                    aria-expanded="false">
              <span data-filter-select-label><%= selected_stage_type.first %></span>
              <svg class="custom-select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="custom-select-menu" role="listbox">
              <% stage_type_options.each do |label, value| %>
                <% selected = value == params[:stage_type].to_s %>
                <button type="button"
                        class="custom-select-option <%= 'is-selected' if selected %>"
                        role="option"
                        aria-selected="<%= selected %>"
                        data-filter-select-option
                        data-value="<%= value %>">
                  <span><%= label %></span>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div class="sidebar-divider"></div>

        <div class="sidebar-field">
          <label class="filter-label"><%= t('offers.index.filters.work_mode') %></label>
          <div class="select-wrap custom-select" data-filter-select>
            <%= hidden_field_tag :work_mode, params[:work_mode].to_s, data: { filter_select_input: true } %>
            <button type="button"
                    class="filter-select custom-select-trigger"
                    data-filter-select-trigger
                    aria-haspopup="listbox"
                    aria-expanded="false">
              <span data-filter-select-label><%= selected_work_mode.first %></span>
              <svg class="custom-select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="custom-select-menu" role="listbox">
              <% work_mode_options.each do |label, value| %>
                <% selected = value == params[:work_mode].to_s %>
                <button type="button"
                        class="custom-select-option <%= 'is-selected' if selected %>"
                        role="option"
                        aria-selected="<%= selected %>"
                        data-filter-select-option
                        data-value="<%= value %>">
                  <span><%= label %></span>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div class="sidebar-actions">
          <%= submit_tag t('common.search'), class: "btn btn-accent fs-13 btn-filter-apply" %>
          <% if params[:query].present? || params[:stage_type].present? || params[:work_mode].present? %>
            <%= link_to t('offers.index.filters.clear_filters'), offers_path, class: "btn-filter-reset" %>
          <% end %>
        </div>
      <% end %>
    </aside>

    <%# ─── Main Content ─────────────────────────────────────────── %>
    <div class="dir-main">

      <div class="dir-list-header">
        <h2 class="dir-list-title"><%= t('offers.index.title') %></h2>
        <div class="dir-list-meta">
          <% if params[:query].present? || params[:stage_type].present? || params[:work_mode].present? %>
            <span class="filter-active-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
              <span><%= t('offers.index.filters.filters_active', default: 'Filters active') %></span>
            </span>
          <% end %>
          <span class="dir-count-badge"><%= t('offers.index.stats.total_offers', count: @offers.size) %></span>
        </div>
      </div>

      <% if @offers.any? %>
        <div class="offers-grid">
          <% @offers.each do |offer| %>
            <%= link_to offer_path(offer), class: "offer-card", aria: { label: offer.title } do %>

              <%# Top row: avatar + title + active dot %>
              <div class="ocard-top">
                <div class="ocard-company-row">
                  <div class="ocard-avatar" aria-hidden="true">
                    <%= offer.company_profile.name[0..1].upcase %>
                  </div>
                  <div class="ocard-company-info">
                    <h3 class="offer-card-title"><%= offer.title %></h3>
                    <span class="offer-card-company"><%= offer.company_profile.name %></span>
                  </div>
                </div>
                <span class="ocard-live-dot" title="<%= t('offers.index.active_listing_tooltip') %>"></span>
              </div>

              <%# Badges row %>
              <div class="ocard-badges">
                <span class="offer-card-badge-stage"><%= offer.stage_type.upcase %></span>
                <% if offer.mission.present? %>
                  <span class="offer-card-badge-proof">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><line x1="12" x2="12" y1="12" y2="18"/></svg>
                    <span><%= t('offers.index.card.mission_attached') %></span>
                  </span>
                <% else %>
                  <span class="offer-card-badge-cv">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    <span><%= t('offers.index.card.cv_only') %></span>
                  </span>
                <% end %>
                <% if current_user&.profileable_type == "StudentProfile" %>
                  <% breakdown = offer.match_breakdown_for(current_user.profileable) rescue nil %>
                  <% if breakdown && breakdown[:total] < 100 %>
                    <span class="match-badge match-badge-tooltip-wrapper <%= breakdown[:total] >= 70 ? 'match-badge-high' : (breakdown[:total] >= 40 ? 'match-badge-medium' : 'match-badge-low') %>">
                      <%= breakdown[:total] %>% match
                      <span class="match-tooltip">
                        <span class="match-tooltip-row">Skills: <%= breakdown[:skill].round %>pt</span>
                        <span class="match-tooltip-row">Major: <%= breakdown[:major].round %>pt</span>
                        <span class="match-tooltip-row">Score: <%= breakdown[:readiness].round %>pt</span>
                      </span>
                    </span>
                  <% end %>
                <% end %>
              </div>

              <%# Description %>
              <p class="offer-card-desc line-clamp-2"><%= offer.description %></p>

              <%# Skills %>
              <% if offer.skills.any? %>
                <div class="ocard-skills">
                  <% offer.skills.first(3).each do |skill| %>
                    <span class="skill-tag"><%= skill.name %></span>
                  <% end %>
                  <% if offer.skills.size > 3 %>
                    <span class="skill-tag skill-tag-more">+<%= offer.skills.size - 3 %></span>
                  <% end %>
                </div>
              <% end %>

              <%# Footer: location + CTA %>
              <div class="offer-card-footer">
                <span class="offer-card-location">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>
                    <% if offer.location.downcase == "remote" %>
                      <%= t('common.work_modes.remote') %>
                    <% else %>
                      <%= offer.location %> &middot; <%= t("common.work_modes.#{offer.work_mode}", default: offer.work_mode.capitalize) %>
                    <% end %>
                  </span>
                </span>
                <span class="offer-card-action">
                  <span><%= t('offers.index.card.view_details') %></span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </div>

            <% end %>
          <% end %>
        </div>

      <% else %>
        <div class="dir-empty">
          <div class="dir-empty-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="8" x2="14" y1="8" y2="14"/><line x1="14" x2="8" y1="8" y2="14"/></svg>
          </div>
          <h3 class="dir-empty-title"><%= t('offers.index.no_results') %></h3>
          <p class="dir-empty-sub"><%= t('offers.index.no_results_hint') %></p>
          <% if params[:query].present? || params[:stage_type].present? || params[:work_mode].present? %>
            <%= link_to t('common.clear_filters'), offers_path, class: "btn btn-secondary" %>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  (function() {
    function closeFilterSelect(select) {
      var trigger = select.querySelector('[data-filter-select-trigger]');
      select.classList.remove('open');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
    }

    document.querySelectorAll('[data-filter-select]').forEach(function(select) {
      var trigger = select.querySelector('[data-filter-select-trigger]');
      var input = select.querySelector('[data-filter-select-input]');
      var label = select.querySelector('[data-filter-select-label]');
      var form = select.closest('form');

      if (!trigger || !input || !label) return;

      trigger.addEventListener('click', function(event) {
        event.stopPropagation();
        var willOpen = !select.classList.contains('open');
        document.querySelectorAll('[data-filter-select].open').forEach(closeFilterSelect);
        select.classList.toggle('open', willOpen);
        trigger.setAttribute('aria-expanded', willOpen);
      });

      select.querySelectorAll('[data-filter-select-option]').forEach(function(option) {
        option.addEventListener('click', function(event) {
          event.stopPropagation();
          input.value = option.dataset.value || '';
          label.textContent = option.textContent.trim();

          select.querySelectorAll('[data-filter-select-option]').forEach(function(item) {
            item.classList.remove('is-selected');
            item.setAttribute('aria-selected', 'false');
          });
          option.classList.add('is-selected');
          option.setAttribute('aria-selected', 'true');
          closeFilterSelect(select);

          if (form && typeof form.requestSubmit === 'function') {
            form.requestSubmit();
          } else if (form) {
            form.submit();
          }
        });
      });
    });

    document.addEventListener('click', function(event) {
      if (!event.target.closest('[data-filter-select]')) {
        document.querySelectorAll('[data-filter-select].open').forEach(closeFilterSelect);
      }
    });

    var inp = document.querySelector('#filters-form input[name="query"]');
    if (!inp) return;

    inp.addEventListener('input', function() {
      var q = inp.value.trim().toLowerCase();
      var cards = document.querySelectorAll('.offers-grid .offer-card');
      if (!cards.length) return;

      cards.forEach(function(card) {
        if (!q) {
          card.style.display = '';
        } else {
          var text = card.textContent.toLowerCase();
          card.style.display = text.includes(q) ? '' : 'none';
        }
      });
    });
  })();
<% end %>
