<% content_for :title, "#{@offer.title} – StageUp" %>
<div class="offer-detail-page">
  <nav class="offer-breadcrumb">
    <%= link_to offers_path, class: "offer-back-link" do %>
      <i data-lucide="arrow-left"></i>
      Back to Offers
    <% end %>
  </nav>

  <div class="offer-grid">
    
    <!-- Left Column: Internship Details -->
    <div class="profile-card p-40">
      <div class="offer-header-row">
        <div>
          <h2 class="offer-title-lg"><%= @offer.title %></h2>
          <span class="offer-company"><%= @company.name %>
            <% if current_user&.profileable_type == "StudentProfile" %>
              <% match_pct = @offer.match_percentage_for(current_user.profileable) %>
              <% if match_pct < 100 %>
                <span class="match-badge ml-8 <%= match_pct >= 70 ? 'match-badge-high' : (match_pct >= 40 ? 'match-badge-medium' : 'match-badge-low') %>"><%= match_pct %>% Match</span>
              <% end %>
            <% end %>
          </span>
        </div>
        <span class="badge-status offer-stage-badge"><%= @offer.stage_type %></span>
      </div>

      <div class="offer-tags">
        <% if @offer.location.downcase != "remote" %>
          <span class="offer-tag">
            <i data-lucide="map-pin" class="offer-tag-icon"></i>
            <%= @offer.location %>
          </span>
        <% end %>
        <span class="offer-tag">
          <i data-lucide="monitor" class="offer-tag-icon"></i>
          <%= @offer.work_mode.capitalize %>
        </span>
        <span class="offer-tag">
          <i data-lucide="users" class="offer-tag-icon"></i>
          <%= pluralize(@offer.spots, 'spot') %> available
        </span>
        <% if @offer.deadline %>
          <% days_left = (@offer.deadline.to_date - Date.today).to_i %>
          <span class="offer-tag <%= days_left <= 3 ? 'offer-tag-urgent' : (days_left <= 7 ? 'offer-tag-warning' : '') %>">
            <i data-lucide="calendar" class="offer-tag-icon"></i>
            <% if days_left <= 0 %>
              Deadline passed
            <% elsif days_left == 1 %>
              1 day left
            <% elsif days_left <= 7 %>
              <%= days_left %> days left
            <% else %>
              <%= @offer.deadline.strftime("%b %d, %Y") %>
            <% end %>
          </span>
        <% end %>
      </div>

      <% if @offer.skills.any? %>
        <div class="offer-tags mb-20">
          <% @offer.skills.each do |skill| %>
            <span class="skill-tag"><%= skill.name %></span>
          <% end %>
        </div>
      <% end %>

      <div class="mb-35">
        <h3 class="fs-18 mb-12 border-bottom pb-8">Role Description</h3>
        <p class="offer-desc-text">
          <%= @offer.description %>
        </p>
      </div>

      <!-- Mission / Proof Layer -->
      <% if @mission %>
        <div class="mission-card">
          <div class="mission-header">
            <h3 class="mission-title">
              <i data-lucide="git-commit" class="mission-title-icon"></i>
              Attached Proof Mission
            </h3>
            <span class="badge-status mission-duration-tag">
              <i data-lucide="clock" class="mission-duration-icon"></i>
              Est. Time: <%= @mission.estimated_duration_minutes %> mins
            </span>
          </div>
          <h4 class="mission-name"><%= @mission.title %></h4>
          <p class="mission-text">
            <%= @mission.instructions %>
          </p>
        </div>
      <% end %>
    </div>

    <!-- Right Column: Recruiter Stats & Application Button -->
    <div class="flex-col gap-20 sticky-sidebar">
      
      <!-- Recruiter Transparency Card -->
      <div class="profile-card employer-card">
        <div class="employer-card-header">
          <div class="employer-avatar">
            <%= @company.name[0].upcase %>
          </div>
          <h3 class="employer-card-name"><%= @company.name %></h3>
        </div>
        
        <!-- Grace Period Check -->
        <% in_grace_period = @company.first_offer_posted_at.nil? || @company.first_offer_posted_at > 30.days.ago %>
        <% if in_grace_period %>
          <div class="grace-box">
            <div class="badge-grace-box">
              <i data-lucide="clock" class="icon-13 icon-amber"></i>
              <span>New Recruiter · Grace Period</span>
            </div>
            <p class="grace-text">
              This employer recently started posting on StageUp. Detailed response rate metrics are hidden during their 30-day grace period.
            </p>
          </div>
        <% else %>
          <div class="emp-stat-row">
            <span class="emp-stat-label">Response Rate</span>
            <strong class="text-success"><%= @company.response_rate %>%</strong>
          </div>
          <div class="emp-stat-row">
            <span class="emp-stat-label">Avg. Decision Time</span>
            <strong><%= @company.avg_response_time_hours %> hours</strong>
          </div>
          <div class="emp-stat-row">
            <span class="emp-stat-label">Verified Recruiter</span>
            <strong><%= @company.verified? ? "Yes" : "No" %></strong>
          </div>
        <% end %>

        <div class="emp-commit-row">
          <% company_score = @company.commitment_score.round(0) %>
          <div class="score-pill fs-12">
            <span class="dot <%= company_score >= 90 ? 'dot-success' : (company_score >= 70 ? 'dot-warning' : 'dot-danger') %>"></span>
            <strong><%= company_score %></strong>
            <span class="score-label">Commitment</span>
          </div>
        </div>

        <div class="emp-rating-row">
          <span class="emp-stat-label">Average Rating</span>
          <% if @reviews.any? %>
            <% comp_avg = (@reviews.sum(&:rating).to_f / @reviews.size).round(1) %>
            <strong class="emp-rating-inner">
              <i data-lucide="star" class="star-icon"></i>
              <%= comp_avg %> (<%= @reviews.size %> reviews)
            </strong>
          <% else %>
            <strong class="text-secondary">Unrated</strong>
          <% end %>
        </div>
      </div>

      <!-- Employer Reviews List -->
      <% if @reviews.any? %>
        <div class="profile-card p-25 mb-20">
          <h3 class="employer-card-title">Candidate Reviews</h3>
          <div class="review-list">
            <% @reviews.each do |rev| %>
              <div class="review-item">
                <div class="review-header">
                  <span class="review-rating">
                    <i data-lucide="star" class="star-icon"></i>
                    <%= rev.rating %> / 5
                  </span>
                  <span class="fs-10 text-muted"><%= time_ago_in_words(rev.created_at) %> ago</span>
                </div>
                <p class="review-comment">"<%= rev.comment %>"</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Application Status / Actions -->
      <div class="profile-card p-25">
        <h3 class="employer-card-title">Application</h3>

        <% if current_user.nil? %>
          <p class="fs-13 text-secondary mb-20 lh-15">
            You must be logged in as a student to apply or take on the proof-of-work mission.
          </p>
          <%= link_to "Sign In / Register", new_user_session_path, class: "btn btn-accent text-decoration-none w-100 text-center" %>
        <% elsif current_user.profileable_type == "StudentProfile" %>
          <% if @submission.nil? %>
            <% if @offer.mission %>
              <p class="fs-13 text-secondary mb-20 lh-15">
                This offer has an attached task. Clicking below starts a <strong>48-hour window</strong> to complete the mission and submit your work.
              </p>
              <button type="button" class="btn btn-primary w-100" id="btn-open-mission-modal">
                Start Proof Mission
              </button>
            <% else %>
              <p class="fs-13 text-secondary mb-20 lh-15">
                This offer accepts standard CV applications. Click below to review your CV link and submit.
              </p>
              <button type="button" class="btn btn-primary w-100" id="btn-open-cv-modal">
                Apply with CV
              </button>
            <% end %>
          
          <% elsif @submission.status == "started" %>
            <div class="mission-started-box mb-16">
              <span class="mission-started-title">Mission In Progress</span>
              <span class="mission-started-text">You started this mission. Don't forget to submit your code link before the 48h deadline!</span>
            </div>
            <%= link_to "Submit Solution URL →", edit_submission_path(@submission), class: "btn btn-primary w-100 text-center text-decoration-none" %>

          <% else %>
            <div class="app-status-center">
              <p class="fs-14 text-secondary mb-8">Application Status:</p>
              <span class="badge badge-success fs-12">
                <%= @submission.status.upcase.gsub('_', ' ') %>
              </span>
              <% if @submission.github_link.present? %>
                <div class="mt-15 fs-13">
                  <%= link_to "View My Submission Link", @submission.github_link, target: "_blank", class: "text-accent" %>
                </div>
              <% end %>
            </div>
          <% end %>

        <% else %>
          <p class="fs-13 text-muted text-center p-10">
            Only logged-in students can apply to internships.
          </p>
        <% end %>
      </div>

    </div>

  </div>

</div>

<%# ─── Custom Modal: Mission Start Confirmation ──────────────── %>
<% if current_user&.profileable_type == "StudentProfile" && @submission.nil? && @offer.mission %>
  <div class="modal-backdrop" id="mission-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-icon-wrap icon-amber-bg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h3 class="modal-title">Start 48-Hour Proof Mission</h3>
        <button type="button" class="modal-close-btn close-modal-trigger">&times;</button>
      </div>
      <div class="modal-body">
        <p class="modal-desc">
          You are about to start the proof-of-work mission for <strong><%= @offer.title %></strong>.
        </p>
        <div class="modal-info-box">
          <div class="info-row">
            <span class="info-label">Timer Window:</span>
            <strong>48 Hours</strong>
          </div>
          <div class="info-row">
            <span class="info-label">Success Reward:</span>
            <strong class="text-success">+10 Commitment Score</strong>
          </div>
          <div class="info-row">
            <span class="info-label">Missed Deadline:</span>
            <strong class="text-danger">-15 Commitment Penalty</strong>
          </div>
        </div>
        <p class="modal-subtext">Are you sure you have time to start this challenge right now?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary close-modal-trigger">Cancel</button>
        <%= button_to "Confirm & Start Mission", submissions_path(offer_id: @offer.id, mission_id: @offer.mission.id), class: "btn btn-primary", data: { disable_with: "Starting…" } %>
      </div>
    </div>
  </div>
<% end %>

<%# ─── Custom Modal: CV Application ─────────────────────────── %>
<% if current_user&.profileable_type == "StudentProfile" && @submission.nil? && @offer.mission.nil? %>
  <div class="modal-backdrop" id="cv-modal" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-icon-wrap icon-indigo-bg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#818CF8" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <h3 class="modal-title">Apply with CV</h3>
        <button type="button" class="modal-close-btn close-modal-trigger">&times;</button>
      </div>
      <%= form_with url: submissions_path, method: :post, local: true do |f| %>
        <%= f.hidden_field :offer_id, value: @offer.id %>
        <div class="modal-body">
          <p class="modal-desc">
            You are applying to <strong><%= @offer.title %></strong> at <%= @company.name %>.
          </p>
          
          <div class="form-group mb-16">
            <label class="form-label" for="custom_cv_url">CV Link / Document URL</label>
            <%= f.url_field :custom_cv_url, value: current_user.profileable.cv_url, class: "form-control",
                placeholder: "https://drive.google.com/your-cv.pdf", required: true %>
            <span class="fs-12 text-muted mt-4 display-block">
              Paste a public Google Drive, Dropbox, LinkedIn, or PDF link to your resume.
            </span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary close-modal-trigger">Cancel</button>
          <%= f.submit "Confirm & Submit CV", class: "btn btn-primary", data: { disable_with: "Submitting…" } %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    function setupModal(triggerId, modalId) {
      var btn = document.getElementById(triggerId);
      var modal = document.getElementById(modalId);
      if (!btn || !modal) return;

      var clone = btn.cloneNode(true);
      btn.parentNode.replaceChild(clone, btn);

      clone.addEventListener('click', function(e) {
        e.preventDefault();
        modal.style.display = 'flex';
      });

      modal.querySelectorAll('.close-modal-trigger').forEach(function(c) {
        c.addEventListener('click', function() {
          modal.style.display = 'none';
        });
      });

      modal.addEventListener('click', function(e) {
        if (e.target === modal) modal.style.display = 'none';
      });
    }

    setupModal('btn-open-mission-modal', 'mission-modal');
    setupModal('btn-open-cv-modal', 'cv-modal');
  })();
</script>
