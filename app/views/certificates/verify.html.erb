<% content_for :title, "#{t('certificates.verify.badge', default: 'Certificate of Completion')} - #{@student.first_name} #{@student.last_name}" %>
<% content_for :description, "Verify the official internship certificate of #{@student.first_name} #{@student.last_name} at #{@company.name}. Issued by StageUp Trust Ledger." %>
<% duration_days = (@agreement.end_date - @agreement.start_date).to_i %>
<% qr_url = verify_certificate_url(token: @agreement.verification_token) %>
<% qr = RQRCode::QRCode.new(qr_url) %>
<% university_name = @student.university&.name || "ISET Sfax" %>
<% student_major = (@student.respond_to?(:major) && @student.major.present?) ? @student.major : "Software Engineering" %>
<% start_str = @agreement.start_date.strftime("%B %d, %Y") %>
<% end_str   = @agreement.end_date.strftime("%B %d, %Y") %>

<div class="cert-page-wrap">
  <%# Top Action Bar %>
  <div class="cert-action-bar">
    <%= link_to root_path, class: "cert-btn cert-btn-secondary" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      <%= t('certificates.verify.home', default: 'Home') %>
    <% end %>
    <button id="cert-print-btn" class="cert-btn cert-btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
      <%= t('certificates.verify.print', default: 'Print / Export PDF') %>
    </button>
  </div>

  <%# The Main Certificate Diploma Card %>
  <div class="cert-diploma-frame">
    <%# Top gold gradient stripe %>
    <div class="cert-diploma-stripe cert-diploma-stripe-top"></div>

    <div class="cert-diploma-body">
      <%# Issuer Header %>
      <div class="cert-diploma-issuer">
        <span class="cert-diploma-logo">StageUp</span>
        <span class="cert-diploma-sep">&middot;</span>
        <span class="cert-diploma-ledger"><%= t('certificates.verify.trust_ledger', default: 'Trust Ledger') %></span>
      </div>

      <%# Ornamental line with Gold Star %>
      <div class="cert-diploma-ornament">
        <span class="cert-diploma-orn-line"></span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#C9A84C" stroke="none"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        <span class="cert-diploma-orn-line"></span>
      </div>

      <%# Title & Decree %>
      <h1 class="cert-diploma-title"><%= t('certificates.verify.badge', default: 'Certificate of Completion') %></h1>
      <p class="cert-diploma-decree">This is to certify that</p>

      <%# Student Name %>
      <div class="cert-diploma-name-wrap">
        <h2 class="cert-diploma-student-name"><%= @student.first_name %> <%= @student.last_name %></h2>
        <div class="cert-diploma-name-underline"></div>
      </div>

      <%# Achievement Description %>
      <p class="cert-diploma-achievement">
        has successfully completed a
        <strong class="cert-diploma-stage-type"><%= @offer.stage_type.to_s.upcase %></strong>
        internship programme at
        <strong class="cert-diploma-company"><%= @company.name %></strong>
      </p>
      <p class="cert-diploma-subject">under the subject: &ldquo;<em><%= @offer.title %></em>&rdquo;</p>

      <%# Metadata Row %>
      <div class="cert-diploma-meta-row">
        <div class="cert-diploma-meta-cell">
          <span class="cert-diploma-meta-label"><%= t('certificates.verify.institution', default: 'Institution') %></span>
          <span class="cert-diploma-meta-val"><%= university_name %></span>
        </div>
        <div class="cert-diploma-meta-divider"></div>
        <div class="cert-diploma-meta-cell">
          <span class="cert-diploma-meta-label"><%= t('certificates.verify.duration', default: 'Duration') %></span>
          <span class="cert-diploma-meta-val"><%= duration_days %> <%= t('certificates.verify.days', default: 'days') %></span>
        </div>
        <div class="cert-diploma-meta-divider"></div>
        <div class="cert-diploma-meta-cell">
          <span class="cert-diploma-meta-label"><%= t('certificates.verify.period', default: 'Period') %></span>
          <span class="cert-diploma-meta-val"><%= start_str %> &ndash; <%= end_str %></span>
        </div>
      </div>

      <%# Second Ornament %>
      <div class="cert-diploma-ornament cert-diploma-ornament-sm">
        <span class="cert-diploma-orn-line"></span>
        <span class="cert-diploma-orn-diamond"></span>
        <span class="cert-diploma-orn-line"></span>
      </div>

      <%# Signatures Row %>
      <div class="cert-diploma-sigs">
        <div class="cert-diploma-sig">
          <div class="cert-diploma-sig-line"></div>
          <p class="cert-diploma-sig-name"><%= @student.first_name %> <%= @student.last_name %></p>
          <p class="cert-diploma-sig-role"><%= t('certificates.verify.cap_graduate', default: 'Graduate Intern') %></p>
          <p class="cert-diploma-sig-date"><%= @agreement.student_signed_at ? @agreement.student_signed_at.strftime("%b %d, %Y") : "—" %></p>
        </div>
        <div class="cert-diploma-sig">
          <div class="cert-diploma-sig-line"></div>
          <p class="cert-diploma-sig-name"><%= @company.name %></p>
          <p class="cert-diploma-sig-role"><%= t('certificates.verify.host_org', default: 'Host Organisation') %></p>
          <p class="cert-diploma-sig-date"><%= @agreement.company_signed_at ? @agreement.company_signed_at.strftime("%b %d, %Y") : "—" %></p>
        </div>
        <div class="cert-diploma-sig">
          <div class="cert-diploma-sig-line"></div>
          <p class="cert-diploma-sig-name"><%= university_name %></p>
          <p class="cert-diploma-sig-role"><%= t('certificates.verify.cap_university', default: 'Academic Institution') %></p>
          <p class="cert-diploma-sig-date"><%= @agreement.university_signed_at ? @agreement.university_signed_at.strftime("%b %d, %Y") : "—" %></p>
        </div>
      </div>

      <%# Verification Footer %>
      <div class="cert-diploma-footer">
        <div class="cert-diploma-qr-col">
          <% qr_svg = qr.as_svg(offset: 0, color: "000000", shape_rendering: "crispEdges", viewbox: true, use_path: true, standalone: false) %>
          <%= qr_svg.sub('<svg ', '<svg width="64" height="64" ').html_safe %>
        </div>
        <div class="cert-diploma-token-col">
          <p class="cert-diploma-token-label"><%= t('certificates.verify.verification_token', default: 'Verification Token') %> (StageUp <%= t('certificates.verify.trust_ledger', default: 'Trust Ledger') %>)</p>
          <p class="cert-diploma-token-val"><%= @agreement.verification_token %></p>
          <p class="cert-diploma-token-url"><%= qr_url %></p>
        </div>
        <div class="cert-diploma-seal-col">
          <div class="cert-diploma-seal">
            <svg viewBox="0 0 80 80" width="76" height="76">
              <circle cx="40" cy="40" r="38" fill="none" stroke="#C9A84C" stroke-width="1.5"/>
              <circle cx="40" cy="40" r="33" fill="none" stroke="#C9A84C" stroke-width="0.5"/>
              <path d="M40 10 L43 25 L58 20 L50 33 L65 38 L50 43 L58 56 L43 51 L40 66 L37 51 L22 56 L30 43 L15 38 L30 33 L22 20 L37 25 Z" fill="none" stroke="#C9A84C" stroke-width="1" opacity="0.6"/>
              <text x="40" y="36" text-anchor="middle" font-size="6" font-weight="800" letter-spacing="1" fill="#C9A84C" font-family="Outfit, sans-serif">STAGE</text>
              <text x="40" y="44" text-anchor="middle" font-size="6" font-weight="800" letter-spacing="1" fill="#C9A84C" font-family="Outfit, sans-serif">UP</text>
              <text x="40" y="52" text-anchor="middle" font-size="4" letter-spacing="0.5" fill="#C9A84C" font-family="Outfit, sans-serif">VERIFIED</text>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <%# Bottom gold gradient stripe %>
    <div class="cert-diploma-stripe cert-diploma-stripe-bottom"></div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    function initCertPrint() {
      var printBtn = document.getElementById('cert-print-btn');
      if (printBtn && !printBtn.dataset.printInitialized) {
        printBtn.dataset.printInitialized = 'true';
        printBtn.addEventListener('click', function(e) {
          e.preventDefault();
          window.print();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCertPrint);
    } else {
      initCertPrint();
    }
    document.addEventListener('turbo:load', initCertPrint);
  })();
</script>
