<% content_for :title, "Certificate of Completion – #{@student.first_name} #{@student.last_name}" %>
<% duration_days = (@agreement.end_date - @agreement.start_date).to_i %>
<% qr_url = verify_certificate_url(token: @agreement.verification_token) %>
<% qr = RQRCode::QRCode.new(qr_url) %>

<div class="agreement-container">

  <%# ─── Action Bar ─── %>
  <div class="agreement-action-bar hide-on-print">
    <%= link_to root_path, class: "btn btn-secondary" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      Home
    <% end %>
    <div style="display:flex;gap:8px;">
      <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>alert('Link copied!'))" class="btn btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        Share
      </button>
      <button onclick="window.print()" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
        Print PDF
      </button>
    </div>
  </div>

  <div class="agreement-card">

    <%# ─── Verified Badge Strip ─── %>
    <div class="cert-banner hide-on-print" style="margin-bottom:32px;">
      <div class="cert-banner-left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        <div>
          <strong class="cert-banner-title">Certificate Available</strong>
          <p class="cert-banner-sub">This internship is fully executed and publicly verifiable.</p>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="width:8px;height:8px;border-radius:50%;background:#10B981;display:inline-block;"></span>
        <span style="font-size:11px;font-weight:700;color:#10B981;letter-spacing:0.06em;">VERIFIED</span>
      </div>
    </div>

    <%# ─── Document Header ─── %>
    <div class="agreement-header" style="margin-bottom:32px;padding-bottom:24px;">
      <div class="flex-center gap-8 mb-12">
        <span class="badge-document-tag">CERTIFICATE OF COMPLETION</span>
        <span class="badge-document-id">ID: AGR-<%= @agreement.id %></span>
      </div>
      <h1 class="agreement-title">CERTIFICATE OF COMPLETION</h1>
      <p class="agreement-subtitle">Officially issued under the Republic of Tunisia · Ministry of Higher Education & Scientific Research</p>
    </div>

    <%# ─── Graduate Recipient Block ─── %>
    <div style="text-align:center;margin-bottom:32px;padding:24px;background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--radius-md);">
      <p style="font-size:11px;font-weight:700;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;margin:0 0 8px 0;">Awarded To</p>
      <h2 style="font-size:34px;font-weight:900;margin:0 0 10px 0;background:linear-gradient(135deg,#FFFFFF 30%,#F59E0B 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
        <%= @student.first_name %> <%= @student.last_name %>
      </h2>
      <p style="font-size:13px;color:var(--text-secondary);margin:0 0 6px 0;">
        Enrolled at <strong style="color:var(--text-primary);"><%= @student.university&.name || "Higher Education Institution" %></strong>
        <% if @student.respond_to?(:major) && @student.major.present? %>
          &middot; Major: <strong style="color:var(--text-primary);"><%= @student.major %></strong>
        <% end %>
      </p>
      <p style="font-size:15px;color:var(--text-secondary);margin:0;line-height:1.6;">
        has successfully completed an official internship as
        <strong style="color:var(--text-primary);"><%= @offer.title %></strong>
        at <strong style="color:var(--text-primary);"><%= @company.name %></strong>
      </p>
    </div>

    <%# ─── Details + QR Code Side by Side ─── %>
    <div class="agreement-signatures-grid" style="margin-bottom:32px;grid-template-columns:1.7fr 1fr;">

      <%# Left: Metadata Fields %>
      <div>
        <%# Institution %>
        <div style="padding:14px 16px;background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--radius-md);margin-bottom:10px;">
          <p style="font-size:10px;font-weight:700;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;margin:0 0 4px 0;">Academic Institution</p>
          <p style="font-size:14px;font-weight:700;color:var(--text-primary);margin:0;"><%= @student.university&.name || "ISET Sfax" %></p>
        </div>

        <%# Internship Period %>
        <div style="padding:14px 16px;background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--radius-md);margin-bottom:10px;">
          <p style="font-size:10px;font-weight:700;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;margin:0 0 4px 0;">Internship Period</p>
          <p style="font-size:14px;font-weight:700;color:var(--text-primary);margin:0;">
            <%= @agreement.start_date.strftime("%b %d, %Y") %> – <%= @agreement.end_date.strftime("%b %d, %Y") %>
            <span style="font-size:12px;font-weight:600;color:#F59E0B;margin-left:6px;">(<%= duration_days %> days)</span>
          </p>
        </div>

        <%# Stage Type %>
        <div style="padding:14px 16px;background:var(--bg-primary);border:1px solid var(--border-color);border-radius:var(--radius-md);margin-bottom:10px;">
          <p style="font-size:10px;font-weight:700;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;margin:0 0 4px 0;">Stage Classification</p>
          <p style="font-size:14px;font-weight:800;color:#F59E0B;margin:0;"><%= @offer.stage_type.to_s.upcase %></p>
        </div>

        <%# Verification ID %>
        <div style="padding:14px 16px;background:var(--bg-primary);border:1px solid rgba(245,158,11,0.25);border-radius:var(--radius-md);">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
            <p style="font-size:10px;font-weight:700;color:var(--text-muted);letter-spacing:0.08em;text-transform:uppercase;margin:0;">Verification Token</p>
            <span style="font-size:9px;font-weight:700;color:#10B981;letter-spacing:0.05em;">✓ IMMUTABLE</span>
          </div>
          <p style="font-size:12px;font-weight:700;color:#F59E0B;font-family:monospace;letter-spacing:0.04em;margin:0;word-break:break-all;"><%= @agreement.verification_token %></p>
        </div>
      </div>

      <%# Right: QR Seal %>
      <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;background:var(--bg-primary);border:1px solid rgba(245,158,11,0.2);border-radius:var(--radius-md);">
        <div style="background:#FFFFFF;padding:10px;border-radius:10px;box-shadow:0 4px 16px rgba(0,0,0,0.3);margin-bottom:12px;line-height:0;">
          <%= qr.as_svg(
            offset: 0,
            color: "000000",
            shape_rendering: "crispEdges",
            module_size: 3,
            standalone: true
          ).html_safe %>
        </div>
        <p style="font-size:10px;font-weight:700;color:#F59E0B;letter-spacing:0.1em;text-transform:uppercase;text-align:center;margin:0 0 4px 0;">Scan to Verify</p>
        <p style="font-size:10px;color:var(--text-muted);text-align:center;margin:0;">StageUp Trust Ledger</p>
      </div>

    </div>

    <%# ─── 3-Party Digital Signatures ─── %>
    <div style="border-top:1px solid var(--border-color);padding-top:24px;">
      <p style="font-size:10px;font-weight:700;color:var(--text-muted);letter-spacing:0.12em;text-transform:uppercase;text-align:center;margin:0 0 16px 0;">Three-Party Digital Signatures & Legal Verification</p>

      <div class="agreement-signatures-grid">
        <%# Student %>
        <div class="agreement-sign-box">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span style="font-size:10px;font-weight:700;color:#10B981;text-transform:uppercase;letter-spacing:0.06em;">Student</span>
          </div>
          <p style="font-size:14px;font-weight:700;color:var(--text-primary);margin:0 0 4px 0;"><%= @student.first_name %> <%= @student.last_name %></p>
          <p style="font-size:11px;color:var(--text-muted);margin:0;">
            <%= @agreement.student_signed_at ? @agreement.student_signed_at.strftime("Signed %b %d, %Y at %H:%M UTC") : "Pending" %>
          </p>
        </div>

        <%# Employer %>
        <div class="agreement-sign-box">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span style="font-size:10px;font-weight:700;color:#10B981;text-transform:uppercase;letter-spacing:0.06em;">Employer</span>
          </div>
          <p style="font-size:14px;font-weight:700;color:var(--text-primary);margin:0 0 4px 0;"><%= @company.name %></p>
          <p style="font-size:11px;color:var(--text-muted);margin:0;">
            <%= @agreement.company_signed_at ? @agreement.company_signed_at.strftime("Signed %b %d, %Y at %H:%M UTC") : "Pending" %>
          </p>
        </div>

        <%# University %>
        <div class="agreement-sign-box">
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span style="font-size:10px;font-weight:700;color:#10B981;text-transform:uppercase;letter-spacing:0.06em;">University</span>
          </div>
          <p style="font-size:14px;font-weight:700;color:var(--text-primary);margin:0 0 4px 0;"><%= @student.university&.name || "ISET Sfax" %></p>
          <p style="font-size:11px;color:var(--text-muted);margin:0;">
            <%= @agreement.university_signed_at ? @agreement.university_signed_at.strftime("Signed %b %d, %Y at %H:%M UTC") : "Pending" %>
          </p>
        </div>
      </div>
    </div>

  </div><%# end .agreement-card %>
</div><%# end .agreement-container %>
