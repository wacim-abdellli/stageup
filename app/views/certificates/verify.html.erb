<% content_for :title, "#{t('certificates.verify.badge', default: 'Certificate of Completion')} - #{@student.first_name} #{@student.last_name}" %>
<% content_for :description, "Verify the official internship certificate of #{@student.first_name} #{@student.last_name} at #{@company.name}. Issued by StageUp Trust Ledger." %>
<% duration_days = (@agreement.end_date - @agreement.start_date).to_i %>
<% qr_url = verify_certificate_url(token: @agreement.verification_token) %>
<% qr = RQRCode::QRCode.new(qr_url) %>
<% university_name = @student.university&.name || "ISET Sfax" %>
<% student_major = (@student.respond_to?(:major) && @student.major.present?) ? @student.major : "Software Engineering" %>
<% start_str = @agreement.start_date.strftime("%B %d, %Y") %>
<% end_str   = @agreement.end_date.strftime("%B %d, %Y") %>

<% content_for :page_styles do %>
  <style>
    /* ═══════════════════════════════════════════════════════
       OFFICIAL CERTIFICATE DIPLOMA — SCREEN & PRINT ENGINE
       ═══════════════════════════════════════════════════════ */
    .cert-page-wrap {
      max-width: 1040px;
      margin: 0 auto;
      padding: 32px 20px 80px;
      min-height: 100vh;
    }
    .cert-action-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 24px;
    }
    .cert-diploma-frame {
      width: 100%;
      background: #FDFCF8 !important;
      color: #1A1A2E !important;
      border-radius: 4px;
      position: relative;
      display: flex;
      flex-direction: column;
      border: 3px solid #C9A84C !important;
      outline: 6px solid #F5ECD5 !important;
      outline-offset: -9px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(201, 168, 76, 0.5);
      box-sizing: border-box;
    }
    .cert-diploma-frame::after {
      content: '';
      position: absolute;
      inset: 12px;
      border: 1px solid rgba(201, 168, 76, 0.45);
      pointer-events: none;
      border-radius: 2px;
    }
    .cert-diploma-stripe {
      background: linear-gradient(90deg, #8B5E0A 0%, #C9A84C 30%, #F5D78E 50%, #C9A84C 70%, #8B5E0A 100%) !important;
      height: 8px;
      flex-shrink: 0;
      width: 100%;
    }
    .cert-diploma-body {
      flex: 1;
      padding: 36px 48px 32px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      color: #1A1A2E !important;
      position: relative;
      z-index: 1;
    }
    .cert-diploma-issuer {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
    }
    .cert-diploma-logo {
      font-family: 'Outfit', sans-serif !important;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #C9A84C !important;
    }
    .cert-diploma-sep {
      color: #C9A84C !important;
      font-size: 16px;
    }
    .cert-diploma-ledger {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #8B7355 !important;
    }
    .cert-diploma-ornament {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      max-width: 440px;
      margin-bottom: 14px;
    }
    .cert-diploma-orn-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, #C9A84C) !important;
      display: block;
    }
    .cert-diploma-ornament .cert-diploma-orn-line:last-child {
      background: linear-gradient(90deg, #C9A84C, transparent) !important;
    }
    .cert-diploma-orn-diamond {
      width: 7px;
      height: 7px;
      background: #C9A84C !important;
      transform: rotate(45deg);
      display: inline-block;
      flex-shrink: 0;
    }
    .cert-diploma-ornament-sm {
      margin: 16px 0 20px;
      max-width: 320px;
    }
    .cert-diploma-title {
      font-family: 'Outfit', sans-serif !important;
      font-size: clamp(26px, 3.5vw, 38px);
      font-weight: 800;
      letter-spacing: 0.04em;
      color: #8B5E0A !important;
      margin: 0 0 8px;
      line-height: 1.1;
      text-transform: uppercase;
      text-shadow: none !important;
    }
    .cert-diploma-decree {
      font-size: 12.5px;
      color: #8B7355 !important;
      font-style: italic;
      margin: 0 0 14px;
      letter-spacing: 0.04em;
      font-weight: 500;
    }
    .cert-diploma-name-wrap {
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cert-diploma-student-name {
      font-family: 'Outfit', sans-serif !important;
      font-size: clamp(24px, 3.8vw, 36px);
      font-weight: 800;
      color: #1A1A2E !important;
      margin: 0 0 6px;
      letter-spacing: -0.01em;
      line-height: 1.15;
    }
    .cert-diploma-name-underline {
      height: 1.5px;
      background: linear-gradient(90deg, transparent, #C9A84C 25%, #C9A84C 75%, transparent) !important;
      width: 260px;
      margin: 0 auto;
    }
    .cert-diploma-achievement {
      font-size: 14px;
      color: #2D2825 !important;
      margin: 0 0 6px;
      line-height: 1.6;
      max-width: 600px;
    }
    .cert-diploma-stage-type {
      color: #8B5E0A !important;
      font-weight: 800;
      letter-spacing: 0.04em;
    }
    .cert-diploma-company {
      color: #1A1A2E !important;
      font-weight: 700;
    }
    .cert-diploma-subject {
      font-size: 13px;
      color: #6B6054 !important;
      margin: 0 0 18px;
      font-style: italic;
      max-width: 540px;
    }
    .cert-diploma-subject em {
      font-style: normal;
      color: #2D2825 !important;
    }
    .cert-diploma-meta-row {
      display: flex;
      align-items: stretch;
      border: 1px solid rgba(201, 168, 76, 0.45) !important;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 4px;
      width: 100%;
      max-width: 580px;
      background: linear-gradient(180deg, #FDF8EE 0%, #FDFCF8 100%) !important;
    }
    .cert-diploma-meta-cell {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding: 8px 14px;
      align-items: center;
    }
    .cert-diploma-meta-divider {
      width: 1px;
      background: rgba(201, 168, 76, 0.35) !important;
    }
    .cert-diploma-meta-label {
      font-size: 8px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #8B7355 !important;
    }
    .cert-diploma-meta-val {
      font-size: 12px;
      font-weight: 700;
      color: #1A1A2E !important;
    }
    .cert-diploma-sigs {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      width: 100%;
      max-width: 680px;
      margin: 8px 0 24px;
    }
    .cert-diploma-sig {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      text-align: center;
    }
    .cert-diploma-sig-line {
      width: 100%;
      max-width: 140px;
      height: 1px;
      background: rgba(201, 168, 76, 0.6) !important;
      margin-bottom: 6px;
    }
    .cert-diploma-sig-name {
      font-size: 12.5px;
      font-weight: 700;
      color: #1A1A2E !important;
      margin: 0;
      line-height: 1.25;
      white-space: nowrap;
    }
    .cert-diploma-sig-role {
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #8B5E0A !important;
      margin: 0;
    }
    .cert-diploma-sig-date {
      font-size: 9px;
      color: #6B6054 !important;
      margin: 0;
    }
    .cert-diploma-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      border-top: 1px solid rgba(201, 168, 76, 0.35) !important;
      padding-top: 18px;
      margin-top: auto;
      gap: 16px;
    }
    .cert-diploma-qr-col {
      width: 68px;
      height: 68px;
      flex-shrink: 0;
      background: #FFFFFF !important;
      border: 1px solid rgba(201, 168, 76, 0.4);
      border-radius: 4px;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cert-diploma-qr-col svg {
      width: 60px !important;
      height: 60px !important;
      display: block;
    }
    .cert-diploma-token-col {
      flex: 1;
      text-align: left;
    }
    .cert-diploma-token-label {
      font-size: 8.5px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #8B5E0A !important;
      margin: 0 0 3px;
    }
    .cert-diploma-token-val {
      font-family: ui-monospace, monospace !important;
      font-size: 11px;
      font-weight: 600;
      color: #5B4A0A !important;
      margin: 0 0 2px;
      word-break: break-all;
    }
    .cert-diploma-token-url {
      font-size: 8.5px;
      color: #8B7355 !important;
      margin: 0;
      word-break: break-all;
    }
    .cert-diploma-seal-col {
      flex-shrink: 0;
    }
    .cert-diploma-seal svg {
      display: block;
    }

    @media print {
      @page {
        size: A4 landscape;
        margin: 6mm;
      }
      *, *::before, *::after {
        text-shadow: none !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
      }
      html, body {
        background: #FDFCF8 !important;
        color: #1A1A2E !important;
        margin: 0 !important;
        padding: 0 !important;
        font-size: 9pt !important;
        width: 100% !important;
        height: 100% !important;
      }
      .navbar,
      .navbar-mobile-menu,
      .cert-action-bar,
      .hide-on-print {
        display: none !important;
      }
      .cert-page-wrap {
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        min-height: auto !important;
        width: 100% !important;
        height: 100% !important;
      }
      .cert-diploma-frame {
        width: 100% !important;
        height: 100% !important;
        min-height: 185mm !important;
        box-shadow: none !important;
        border: 3px solid #C9A84C !important;
        outline: 5px solid #F5ECD5 !important;
        outline-offset: -8px !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .cert-diploma-frame::after {
        inset: 10px !important;
        border: 1px solid rgba(201, 168, 76, 0.4) !important;
      }
      .cert-diploma-stripe {
        height: 7px !important;
      }
      .cert-diploma-body {
        padding: 7mm 12mm 5mm !important;
      }
      .cert-diploma-title {
        font-size: 22pt !important;
        margin-bottom: 2mm !important;
      }
      .cert-diploma-student-name {
        font-size: 24pt !important;
        margin-bottom: 2mm !important;
      }
      .cert-diploma-achievement {
        font-size: 10.5pt !important;
        margin-bottom: 1.5mm !important;
      }
      .cert-diploma-subject {
        font-size: 9.5pt !important;
        margin-bottom: 3.5mm !important;
      }
      .cert-diploma-meta-row {
        padding: 2mm 6mm !important;
        margin-bottom: 2mm !important;
        max-width: 440pt !important;
      }
      .cert-diploma-sigs {
        margin: 4mm 0 3mm !important;
        max-width: 480pt !important;
      }
      .cert-diploma-footer {
        padding-top: 2.5mm !important;
        margin-top: auto !important;
      }
      .cert-diploma-qr-col {
        width: 48pt !important;
        height: 48pt !important;
      }
      .cert-diploma-qr-col svg {
        width: 48pt !important;
        height: 48pt !important;
      }
      .cert-diploma-seal svg {
        width: 58pt !important;
        height: 58pt !important;
      }
    }
  </style>
<% end %>

<div class="cert-page-wrap">
  <%# Top Action Bar %>
  <div class="cert-action-bar hide-on-print">
    <%= link_to root_path, class: "btn btn-secondary" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      <%= t('certificates.verify.home', default: 'Home') %>
    <% end %>
    <button id="cert-print-btn" class="btn btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
      <%= t('certificates.verify.print', default: 'Print / Export PDF') %>
    </button>
  </div>

  <%# The Main Certificate Diploma Card %>
  <div class="cert-diploma-frame">
    <%# Top gold gradient stripe %>
    <div class="cert-diploma-stripe cert-diploma-stripe-top"></div>

    <div class="cert-diploma-body">
      <%# Issuer Header %>
      <div class="cert-diploma-issuer">
        <span class="cert-diploma-logo">StageUp</span>
        <span class="cert-diploma-sep">&middot;</span>
        <span class="cert-diploma-ledger"><%= t('certificates.verify.trust_ledger', default: 'Trust Ledger') %></span>
      </div>

      <%# Ornamental line with Gold Star %>
      <div class="cert-diploma-ornament">
        <span class="cert-diploma-orn-line"></span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#C9A84C" stroke="none"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        <span class="cert-diploma-orn-line"></span>
      </div>

      <%# Title & Decree %>
      <h1 class="cert-diploma-title"><%= t('certificates.verify.badge', default: 'Certificate of Completion') %></h1>
      <p class="cert-diploma-decree">This is to certify that</p>

      <%# Student Name %>
      <div class="cert-diploma-name-wrap">
        <h2 class="cert-diploma-student-name"><%= @student.first_name %> <%= @student.last_name %></h2>
        <div class="cert-diploma-name-underline"></div>
      </div>

      <%# Achievement Description %>
      <p class="cert-diploma-achievement">
        has successfully completed a
        <strong class="cert-diploma-stage-type"><%= @offer.stage_type.to_s.upcase %></strong>
        internship programme at
        <strong class="cert-diploma-company"><%= @company.name %></strong>
      </p>
      <p class="cert-diploma-subject">under the subject: &ldquo;<em><%= @offer.title %></em>&rdquo;</p>

      <%# Metadata Row %>
      <div class="cert-diploma-meta-row">
        <div class="cert-diploma-meta-cell">
          <span class="cert-diploma-meta-label"><%= t('certificates.verify.institution', default: 'Institution') %></span>
          <span class="cert-diploma-meta-val"><%= university_name %></span>
        </div>
        <div class="cert-diploma-meta-divider"></div>
        <div class="cert-diploma-meta-cell">
          <span class="cert-diploma-meta-label"><%= t('certificates.verify.duration', default: 'Duration') %></span>
          <span class="cert-diploma-meta-val"><%= duration_days %> <%= t('certificates.verify.days', default: 'days') %></span>
        </div>
        <div class="cert-diploma-meta-divider"></div>
        <div class="cert-diploma-meta-cell">
          <span class="cert-diploma-meta-label"><%= t('certificates.verify.period', default: 'Period') %></span>
          <span class="cert-diploma-meta-val"><%= start_str %> &ndash; <%= end_str %></span>
        </div>
      </div>

      <%# Second Ornament %>
      <div class="cert-diploma-ornament cert-diploma-ornament-sm">
        <span class="cert-diploma-orn-line"></span>
        <span class="cert-diploma-orn-diamond"></span>
        <span class="cert-diploma-orn-line"></span>
      </div>

      <%# Signatures Row %>
      <div class="cert-diploma-sigs">
        <div class="cert-diploma-sig">
          <div class="cert-diploma-sig-line"></div>
          <p class="cert-diploma-sig-name"><%= @student.first_name %> <%= @student.last_name %></p>
          <p class="cert-diploma-sig-role"><%= t('certificates.verify.cap_graduate', default: 'Graduate Intern') %></p>
          <p class="cert-diploma-sig-date"><%= @agreement.student_signed_at ? @agreement.student_signed_at.strftime("%b %d, %Y") : "—" %></p>
        </div>
        <div class="cert-diploma-sig">
          <div class="cert-diploma-sig-line"></div>
          <p class="cert-diploma-sig-name"><%= @company.name %></p>
          <p class="cert-diploma-sig-role"><%= t('certificates.verify.host_org', default: 'Host Organisation') %></p>
          <p class="cert-diploma-sig-date"><%= @agreement.company_signed_at ? @agreement.company_signed_at.strftime("%b %d, %Y") : "—" %></p>
        </div>
        <div class="cert-diploma-sig">
          <div class="cert-diploma-sig-line"></div>
          <p class="cert-diploma-sig-name"><%= university_name %></p>
          <p class="cert-diploma-sig-role"><%= t('certificates.verify.cap_university', default: 'Academic Institution') %></p>
          <p class="cert-diploma-sig-date"><%= @agreement.university_signed_at ? @agreement.university_signed_at.strftime("%b %d, %Y") : "—" %></p>
        </div>
      </div>

      <%# Verification Footer %>
      <div class="cert-diploma-footer">
        <div class="cert-diploma-qr-col">
          <%= qr.as_svg(offset: 0, color: "1A1A2E", shape_rendering: "crispEdges", viewbox: true, use_path: true, standalone: true).html_safe %>
        </div>
        <div class="cert-diploma-token-col">
          <p class="cert-diploma-token-label"><%= t('certificates.verify.verification_token', default: 'Verification Token') %> (StageUp <%= t('certificates.verify.trust_ledger', default: 'Trust Ledger') %>)</p>
          <p class="cert-diploma-token-val"><%= @agreement.verification_token %></p>
          <p class="cert-diploma-token-url"><%= qr_url %></p>
        </div>
        <div class="cert-diploma-seal-col">
          <div class="cert-diploma-seal">
            <svg viewBox="0 0 80 80" width="76" height="76">
              <circle cx="40" cy="40" r="38" fill="none" stroke="#C9A84C" stroke-width="1.5"/>
              <circle cx="40" cy="40" r="33" fill="none" stroke="#C9A84C" stroke-width="0.5"/>
              <path d="M40 10 L43 25 L58 20 L50 33 L65 38 L50 43 L58 56 L43 51 L40 66 L37 51 L22 56 L30 43 L15 38 L30 33 L22 20 L37 25 Z" fill="none" stroke="#C9A84C" stroke-width="1" opacity="0.6"/>
              <text x="40" y="36" text-anchor="middle" font-size="6" font-weight="800" letter-spacing="1" fill="#C9A84C" font-family="Outfit, sans-serif">STAGE</text>
              <text x="40" y="44" text-anchor="middle" font-size="6" font-weight="800" letter-spacing="1" fill="#C9A84C" font-family="Outfit, sans-serif">UP</text>
              <text x="40" y="52" text-anchor="middle" font-size="4" letter-spacing="0.5" fill="#C9A84C" font-family="Outfit, sans-serif">VERIFIED</text>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <%# Bottom gold gradient stripe %>
    <div class="cert-diploma-stripe cert-diploma-stripe-bottom"></div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  (function() {
    function initCertPrint() {
      var printBtn = document.getElementById('cert-print-btn');
      if (printBtn && !printBtn.dataset.printInitialized) {
        printBtn.dataset.printInitialized = 'true';
        printBtn.addEventListener('click', function(e) {
          e.preventDefault();
          window.print();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCertPrint);
    } else {
      initCertPrint();
    }
    document.addEventListener('turbo:load', initCertPrint);
  })();
</script>
