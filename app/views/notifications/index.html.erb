<% content_for :title, "#{t("notifications.title")} – StageUp" %>
<div class="notif-page-wrap">
  <div class="notif-page-header">
    <div>
      <h1 class="notif-page-title"><%= t("notifications.title") %></h1>
      <% if @unread_count > 0 %>
        <p class="notif-page-subtitle"><%= t("notifications.unread_count", count: @unread_count) %></p>
      <% end %>
    </div>
    <% if @unread_count > 0 %>
      <%= button_to t("notifications.mark_all_read"), read_all_notifications_path, method: :post, class: "btn btn-accent btn-compact-sm" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="notif-list-card">
      <% @notifications.group_by { |n| n.created_at.to_date }.each do |date, notifs| %>
        <div class="notif-date-group-label">
          <%= date == Date.today ? t("notifications.today") : date == Date.yesterday ? t("notifications.yesterday") : date.strftime("%B %d, %Y") %>
        </div>
        <% notifs.each do |notification| %>
          <div class="notif-list-item <%= 'unread' unless notification.read %>">
            <div class="notif-item-icon <%= action_icon_color(notification.action) %>">
              <i data-lucide="<%= notification_icon(notification.action) %>" class="icon-18"></i>
            </div>
            <div class="notif-item-content">
              <p class="notif-item-message"><%= notification.message %></p>
              <span class="notif-item-time"><%= "#{time_ago_in_words(notification.created_at)} #{t("common.ago")}".strip %></span>
            </div>
            <% unless notification.read %>
              <%= button_to t("notifications.mark_read"), notification_path(notification), method: :patch, class: "btn btn-secondary btn-compact-sm notif-mark-btn" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="notif-empty-card">
      <div class="notif-empty-glow">
        <i data-lucide="bell" class="icon-32 stroke-secondary"></i>
      </div>
      <h3 class="notif-empty-title"><%= t("notifications.empty_title") %></h3>
      <p class="notif-empty-desc"><%= t("notifications.empty_desc") %></p>
    </div>
  <% end %>

  <% if @total_pages > 1 %>
    <div class="pagination-nav">
      <% if @current_page > 1 %>
        <%= link_to t("common.previous"), notifications_path(page: @current_page - 1), class: "pagination-link" %>
      <% else %>
        <span class="pagination-link pagination-link-disabled"><%= t("common.previous") %></span>
      <% end %>

      <span class="pagination-info"><%= t("notifications.page_info", current: @current_page, total: @total_pages) %></span>

      <% if @current_page < @total_pages %>
        <%= link_to t("common.next"), notifications_path(page: @current_page + 1), class: "pagination-link" %>
      <% else %>
        <span class="pagination-link pagination-link-disabled"><%= t("common.next") %></span>
      <% end %>
    </div>
  <% end %>
</div>
