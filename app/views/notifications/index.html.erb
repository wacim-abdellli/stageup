<div class="notif-page-wrap">
  <div class="notif-page-header">
    <div>
      <h1 class="notif-page-title">Notifications</h1>
      <% if @unread_count > 0 %>
        <p class="notif-page-subtitle"><%= @unread_count %> unread</p>
      <% end %>
    </div>
    <% if @unread_count > 0 %>
      <%= button_to "Mark All Read", read_all_notifications_path, method: :post, class: "btn btn-accent btn-compact-sm" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="notif-list-card">
      <% @notifications.each do |notification| %>
        <div class="notif-list-item <%= 'unread' unless notification.read %>">
          <div class="notif-item-icon <%= action_icon_color(notification.action) %>">
            <i data-lucide="<%= notification_icon(notification.action) %>" class="icon-18"></i>
          </div>
          <div class="notif-item-content">
            <p class="notif-item-message"><%= notification.message %></p>
            <span class="notif-item-time"><%= time_ago_in_words(notification.created_at) %> ago</span>
          </div>
          <% unless notification.read %>
            <%= button_to "Mark Read", notification_path(notification), method: :patch, class: "btn btn-secondary btn-compact-sm notif-mark-btn" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="notif-empty-card">
      <div class="notif-empty-glow">
        <i data-lucide="bell" class="icon-32 stroke-secondary"></i>
      </div>
      <h3 class="notif-empty-title">All Caught Up</h3>
      <p class="notif-empty-desc">
        You have no new notifications. Updates about applications, agreements, and internship milestones will appear here.
      </p>
    </div>
  <% end %>
</div>
