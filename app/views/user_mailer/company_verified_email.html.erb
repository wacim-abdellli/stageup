<div style="max-width:560px;margin:40px auto;background:#ffffff;border-radius:12px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
  <div style="background:#4F46E5;padding:30px;text-align:center;">
    <h1 style="color:#ffffff;margin:0;font-size:22px;font-weight:700;">Company Verified ✓</h1>
  </div>
  <div style="padding:30px;">
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;">Hello,</p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;">Your company account <strong><%= @profile.name %></strong> has been verified by the StageUp administration team.</p>
    <p style="margin:0 0 16px;"><span style="display:inline-block;background:#34D399;color:#0a0a0a;padding:6px 14px;border-radius:6px;font-size:13px;font-weight:600;">Verified</span></p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;">You can now post internship offers, receive student applications, and manage your recruitment pipeline.</p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;">If you have any questions, contact the StageUp support team.</p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0;">Best regards,<br>The StageUp Team</p>
  </div>
  <div style="padding:20px 30px;border-top:1px solid #eee;font-size:12px;color:#999;text-align:center;">&copy; <%= Time.current.year %> StageUp. All rights reserved.</div>
</div>
