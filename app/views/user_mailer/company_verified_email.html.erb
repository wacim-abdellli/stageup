<div style="max-width:560px;margin:40px auto;background:#ffffff;border-radius:12px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
  <div style="background:#C2410C;padding:30px;text-align:center;">
    <h1 style="color:#ffffff;margin:0;font-size:22px;font-weight:700;"><%= t('user_mailer.company_verified.heading') %></h1>
  </div>
  <div style="padding:30px;">
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;"><%= t('user_mailer.company_verified.greeting') %></p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;"><%= t('user_mailer.company_verified.body_verified_html', company_name: @profile.name) %></p>
    <p style="margin:0 0 16px;"><span style="display:inline-block;background:#34D399;color:#0a0a0a;padding:6px 14px;border-radius:6px;font-size:13px;font-weight:600;"><%= t('user_mailer.company_verified.verified_badge') %></span></p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;"><%= t('user_mailer.company_verified.capabilities') %></p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 16px;"><%= t('user_mailer.company_verified.support') %></p>
    <p style="font-size:15px;line-height:1.6;color:#333;margin:0;"><%= t('user_mailer.company_verified.regards') %><br><%= t('user_mailer.company_verified.team') %></p>
  </div>
  <div style="padding:20px 30px;border-top:1px solid #eee;font-size:12px;color:#999;text-align:center;">&copy; <%= Time.current.year %> StageUp. <%= t('user_mailer.company_verified.copyright') %></div>
</div>
