<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title"><%= t("passwords.new.title") %></h2>
      <p class="auth-subtitle"><%= t("passwords.new.subtitle") %></p>
    </div>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <% errors = resource.errors.full_messages %>
      <% if errors.any? %>
        <div class="flash-message flash-alert flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 stroke-danger flex-shrink-0"></i>
            <strong><%= t("passwords.new.errors_title") %></strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: t("passwords.new.email_placeholder"), required: true %>
      </div>

      <div class="form-group mt-30">
        <%= f.submit t("passwords.new.submit"), class: "btn btn-accent", data: { turbo_submits_with: t("passwords.new.submit") } %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= link_to t("passwords.new.sign_in"), new_user_session_path %>
      <%= link_to t("passwords.new.sign_up"), select_role_path %>
    </div>
  </div>
</div>
