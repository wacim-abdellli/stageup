<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Forgot your password?</h2>
      <p class="auth-subtitle">We will send you password reset instructions</p>
    </div>

    <% if flash[:alert] %>
      <div class="flash-message flash-alert">
        <span>⚠️</span> <%= flash[:alert] %>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="flash-message flash-notice">
        <span>✅</span> <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <% errors = resource.errors.full_messages %>
      <% if errors.any? %>
        <div class="flash-message flash-alert" style="flex-direction: column; align-items: flex-start; gap: 4px;">
          <ul style="margin-left: 20px; font-size: 13px;">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "email@example.com", required: true %>
      </div>

      <div class="form-group" style="margin-top: 30px;">
        <%= f.submit "Send reset instructions", class: "btn btn-accent", style: "width: 100%; cursor: pointer;" %>
      </div>
    <% end %>

    <div style="display: flex; flex-direction: column; gap: 8px; text-align: center; font-size: 14px; color: var(--text-secondary); border-top: 1px solid var(--border-color); padding-top: 20px; margin-top: 20px;">
      <%= link_to "Log in", new_user_session_path, style: "font-weight: 500;" %>
      <%= link_to "Sign up", select_role_path, style: "font-weight: 500;" %>
    </div>
  </div>
</div>
