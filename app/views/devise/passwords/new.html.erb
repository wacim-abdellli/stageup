<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Forgot your password?</h2>
      <p class="auth-subtitle">We will send you password reset instructions</p>
    </div>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <% errors = resource.errors.full_messages %>
      <% if errors.any? %>
        <div class="flash-message flash-alert flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 stroke-danger flex-shrink-0"></i>
            <strong>Please resolve the following errors:</strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "email@example.com", required: true %>
      </div>

      <div class="form-group mt-30">
        <%= f.submit "Send reset instructions", class: "btn btn-accent" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= link_to "Log in", new_user_session_path %>
      <%= link_to "Sign up", select_role_path %>
    </div>
  </div>
</div>
