<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Change your password</h2>
      <p class="auth-subtitle">Enter your new credentials below</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <% errors = resource.errors.full_messages %>
      <% if errors.any? %>
        <div class="flash-message flash-alert" style="flex-direction: column; align-items: flex-start; gap: 6px;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <i data-lucide="alert-circle" style="width: 16px; height: 16px; stroke: #F87171; flex-shrink: 0;"></i>
            <strong>Please resolve the following errors:</strong>
          </div>
          <ul style="margin-left: 24px; font-size: 13px; margin-top: 0; margin-bottom: 0;">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :password, "New password", class: "form-label" %>
        <% if @minimum_password_length %>
          <span style="font-size: 12px; color: var(--text-secondary);"> (minimum <%= @minimum_password_length %> characters)</span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div class="form-group" style="margin-top: 30px;">
        <%= f.submit "Change my password", class: "btn btn-accent", style: "width: 100%; cursor: pointer;" %>
      </div>
    <% end %>

    <div style="display: flex; flex-direction: column; gap: 8px; text-align: center; font-size: 14px; color: var(--text-secondary); border-top: 1px solid var(--border-color); padding-top: 20px; margin-top: 20px;">
      <%= link_to "Log in", new_user_session_path, style: "font-weight: 500;" %>
      <%= link_to "Sign up", select_role_path, style: "font-weight: 500;" %>
    </div>
  </div>
</div>
