<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title"><%= t("passwords.edit.title") %></h2>
      <p class="auth-subtitle"><%= t("passwords.edit.subtitle") %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <% errors = resource.errors.full_messages %>
      <% if errors.any? %>
        <div class="flash-col">
          <div class="flash-col-header">
            <i data-lucide="alert-circle" class="icon-16 stroke-danger flex-shrink-0"></i>
            <strong><%= t("passwords.edit.errors_title") %></strong>
          </div>
          <ul class="error-list">
            <% errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :password, t("passwords.edit.new_password"), class: "form-label" %>
        <% if @minimum_password_length %>
          <span class="fs-12 text-secondary"> <%= t("passwords.edit.minimum_characters", count: @minimum_password_length) %></span>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, t("passwords.edit.confirm_new_password"), class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div class="form-group mt-30">
        <%= f.submit t("passwords.edit.submit"), class: "btn btn-accent" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= link_to t("passwords.edit.sign_in"), new_user_session_path %>
      <%= link_to t("passwords.edit.sign_up"), select_role_path %>
    </div>
  </div>
</div>
