<% content_for :title, t("registrations.edit.title") %>
<div class="form-page">
  <div class="form-page-header">
    <h1 class="form-page-title"><%= t("registrations.edit.heading") %></h1>
    <p class="form-page-subtitle"><%= t("registrations.edit.subtitle") %></p>
  </div>
  <div class="form-page-body">

    <% if resource.errors.any? %>
      <div class="flash-message flash-alert mb-20">
        <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
        <span><%= resource.errors.full_messages.first %> (<%= resource.errors.count %> <%= t("common.errors") %>)</span>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

      <div class="form-section">
        <div class="form-section-title">
          <i data-lucide="user"></i>
          <%= t("registrations.edit.account_details") %>
        </div>
        <div class="form-group">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: t("registrations.edit.email_placeholder") %>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">
          <i data-lucide="key"></i>
          <%= t("registrations.edit.change_password") %> <span class="text-muted fw-500 text-normal-case">(<%= t("registrations.edit.leave_blank") %>)</span>
        </div>
        <div class="form-row">
          <div class="form-group">
            <%= f.label :password, class: "form-label" %>
            <div class="pw-wrap">
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "••••••••" %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="<%= t("registrations.edit.toggle_password_aria") %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-group">
            <%= f.label :password_confirmation, class: "form-label" %>
            <div class="pw-wrap">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "••••••••" %>
              <button type="button" class="pw-toggle"
                onclick="var i=this.previousElementSibling;i.type=i.type==='password'?'text':'password';"
                aria-label="<%= t("registrations.edit.toggle_password_aria") %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">
          <i data-lucide="shield-check"></i>
          <%= t("registrations.edit.confirm_changes") %>
        </div>
        <div class="form-group">
          <%= f.label :current_password, class: "form-label" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control", placeholder: t("registrations.edit.current_password_placeholder"), required: true %>
          <small class="hint-text"><%= t("registrations.edit.current_password_hint") %></small>
        </div>
      </div>

      <div class="form-footer">
        <%= link_to t("common.back"), :back, class: "btn btn-secondary btn-cancel" %>
        <%= f.submit t("registrations.edit.submit"), class: "btn btn-primary btn-submit", data: { turbo_submits_with: t("registrations.edit.submit") } %>
      </div>
    <% end %>

    <div class="danger-zone">
      <div class="danger-zone-text">
        <div class="danger-zone-label"><%= t("registrations.edit.danger_zone_label") %></div>
        <div class="danger-zone-desc"><%= t("registrations.edit.danger_zone_desc") %></div>
      </div>
      <%= button_to t("registrations.edit.delete_account"), registration_path(resource_name),
            data: { confirm: t("registrations.edit.delete_confirm") },
            method: :delete,
            class: "btn btn-secondary btn-danger-outline" %>
    </div>

  </div>
</div>

