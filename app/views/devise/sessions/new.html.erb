<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <%= render "layouts/navbar_brand" %>
      <h2 class="auth-title">Log in</h2>
      <p class="auth-subtitle">Welcome back to StageUp</p>
    </div>

    <% if flash[:alert] %>
      <div class="flash-message flash-alert flash-row">
        <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="flash-message flash-notice flash-row">
        <i data-lucide="check-circle" class="icon-16 flex-shrink-0 stroke-success"></i>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "email@example.com", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex-row gap-8 align-center">
          <%= f.check_box :remember_me, style: "width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent);" %>
          <%= f.label :remember_me, style: "margin: 0; cursor: pointer;" %>
        </div>
      <% end %>

      <div class="mt-30">
        <%= f.submit "Log in", class: "btn btn-accent", style: "cursor: pointer;" %>
      </div>
    <% end %>

    <div class="auth-links">
      <%= link_to "Sign up", select_role_path %>
      <%= link_to "Forgot your password?", new_password_path(resource_name), style: "font-size: 13px;" %>
    </div>
  </div>
</div>
