<% content_for :title, "Submit Proof of Work – StageUp" %>
<div class="form-page form-page-narrow">

  <div class="form-page-header">
    <h1 class="form-page-title">Submit Proof of Work</h1>
    <p class="form-page-subtitle">Paste your solution URL and any explanation notes below.</p>
  </div>

  <div class="form-page-body">

    <div class="review-context-card">
      <div class="review-context-row">
        <i data-lucide="briefcase"></i>
        <div>
          <span class="review-context-label">Offer</span>
          <strong class="review-context-value"><%= @submission.offer.title %></strong>
        </div>
      </div>
      <div class="review-context-row">
        <i data-lucide="git-commit"></i>
        <div>
          <span class="review-context-label">Mission</span>
          <strong class="review-context-value"><%= @submission.mission.title %></strong>
        </div>
      </div>
    </div>

    <% if @submission.errors.any? %>
      <div class="flash-message flash-alert mb-20">
        <i data-lucide="alert-circle" class="icon-16 flex-shrink-0 stroke-danger"></i>
        <span><%= @submission.errors.full_messages.first %></span>
      </div>
    <% end %>

    <%= form_with model: @submission, local: true do |f| %>

      <div class="form-group">
        <label class="form-label" for="github_link">Solution URL (GitHub, Figma, Google Drive)</label>
        <%= f.url_field :github_link, id: "github_link", class: "form-control",
            placeholder: "https://github.com/myusername/myrepo",
            required: true, oninput: "valURL(this)" %>
        <div class="inline-warning-box">
          <i data-lucide="alert-triangle"></i>
          Make sure your link is <strong>publicly accessible</strong>. Private repos will fail auto-check.
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="submission_notes">Notes / Explanation</label>
        <%= f.text_area :submission_notes, id: "submission_notes", class: "form-control", rows: 4,
            placeholder: "Describe your solution, installation instructions, or technical choices..." %>
      </div>

      <div class="form-footer">
        <%= link_to "Cancel", offer_path(@submission.offer), class: "btn btn-secondary btn-cancel" %>
        <%= f.submit "Submit Proof of Work", class: "btn btn-primary btn-submit" %>
      </div>

    <% end %>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  function valURL(el) {
    var ok = /^https?:\/\/.+/.test(el.value.trim());
    el.classList.toggle('form-control-error', el.value && !ok);
  }
<% end %>

