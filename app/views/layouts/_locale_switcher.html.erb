<div class="nav-locale-switcher" aria-label="Language Selector">
  <span class="nav-locale-globe" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="2" x2="22" y1="12" y2="12"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
  </span>
  <div class="nav-locale-group">
    <% [[:fr, "FR"], [:en, "EN"], [:ar, "AR"]].each do |loc, label| %>
      <% is_active = (I18n.locale == loc) %>
      <%= link_to label,
          url_for(request.query_parameters.merge(locale: loc)),
          class: "nav-locale-item #{'active' if is_active}",
          title: "Switch to #{label}" %>
    <% end %>
  </div>
</div>
