<div class="lang-dropdown-wrapper">
  <button type="button" class="lang-icon-btn" id="lang-btn" aria-label="Select Language" aria-expanded="false" title="Language: <%= I18n.locale.to_s.upcase %>">
    <svg class="lang-globe-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <line x1="2" x2="22" y1="12" y2="12"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <span class="lang-badge-text"><%= I18n.locale.to_s.upcase %></span>
  </button>

  <div class="lang-floating-menu" id="lang-menu" role="menu">
    <% [
      [:fr, "Français", "FR"],
      [:en, "English", "EN"],
      [:ar, "العربية", "AR"]
    ].each do |loc, full_name, short_code| %>
      <% is_active = (I18n.locale == loc) %>
      <%= link_to url_for(request.query_parameters.merge(locale: loc)),
          class: "lang-menu-option #{'active' if is_active}",
          role: "menuitem" do %>
        <div class="lang-option-left">
          <span class="lang-option-name"><%= full_name %></span>
          <span class="lang-option-code"><%= short_code %></span>
        </div>
        <% if is_active %>
          <svg class="lang-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
