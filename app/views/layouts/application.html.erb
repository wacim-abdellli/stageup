<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale == :ar ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for(:title) || t('layouts.default_title') %></title>
    <meta name="description" content="<%= t('layouts.meta_description') %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if current_user %>
      <meta name="current-user-id" content="<%= current_user.id %>">
    <% end %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json?v=4">

    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico?v=4" sizes="any">
    <link rel="icon" href="/icon.png?v=4" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4">

    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        if (localStorage.getItem('stageup-theme') === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <%# Stylesheets: standard Rails asset pipeline + fallback Rails endpoint %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="<%= stageup_stylesheet_path %>" data-turbo-track="reload">
    <%= render "layouts/nav_critical_styles" %>
    <script src="https://unpkg.com/lucide@latest" nonce="<%= content_security_policy_nonce %>"></script>
    <script nonce="<%= content_security_policy_nonce %>">
      (function() {

        /* ── Helpers ── */
        function $(id) { return document.getElementById(id); }

        window.togglePassword = function(btn) {
          if (!btn) return;
          var wrap = btn.closest('.pw-wrap') || btn.parentElement;
          var input = wrap ? wrap.querySelector('input') : btn.previousElementSibling;
          if (!input) return;

          var isPassword = input.type === 'password';
          input.type = isPassword ? 'text' : 'password';

          var eyeSvg = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
          var eyeOffSvg = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

          btn.innerHTML = isPassword ? eyeOffSvg : eyeSvg;
        };

        /* ── Event Delegation for all Nav/UI toggles ── */
        document.addEventListener('click', function(e) {
          // Password Visibility Toggle
          var pwBtn = e.target.closest('.pw-toggle');
          if (pwBtn) {
            e.preventDefault();
            e.stopPropagation();
            window.togglePassword(pwBtn);
            return;
          }
          // 0. Theme Switcher Toggle
          var themeBtn = e.target.closest('#theme-toggle-btn');
          if (themeBtn) {
            e.stopPropagation();
            var isLight = document.documentElement.getAttribute('data-theme') === 'light';
            var nextTheme = isLight ? 'dark' : 'light';
            if (nextTheme === 'light') {
              document.documentElement.setAttribute('data-theme', 'light');
            } else {
              document.documentElement.removeAttribute('data-theme');
            }
            localStorage.setItem('stageup-theme', nextTheme);
            return;
          }
          // 1. Mobile Menu Hamburger Toggle
          var toggleBtn = e.target.closest('#nav-toggle');
          if (toggleBtn) {
            e.stopPropagation();
            var menu = $('nav-mobile-menu');
            if (menu) {
              var open = menu.classList.toggle('open');
              toggleBtn.setAttribute('aria-expanded', open);
              menu.setAttribute('aria-hidden', !open);
            }
            return;
          }

          // 2. Language Dropdown Toggle
          var langBtn = e.target.closest('#lang-btn');
          if (langBtn) {
            e.stopPropagation();
            var menu = $('lang-menu');
            if (menu) {
              var open = menu.classList.toggle('open');
              langBtn.setAttribute('aria-expanded', open);
              // Close other open panels
              var panel = $('notif-panel');
              var nb = $('notif-btn');
              if (panel) panel.classList.remove('open');
              if (nb) nb.setAttribute('aria-expanded', 'false');
              var dd = $('nav-user-dropdown');
              var ab = $('nav-avatar-toggle');
              if (dd) dd.classList.remove('open');
              if (ab) ab.setAttribute('aria-expanded', 'false');
            }
            return;
          }

          // 3. Notification Bell Panel Toggle
          var notifBtn = e.target.closest('#notif-btn');
          if (notifBtn) {
            e.stopPropagation();
            var panel = $('notif-panel');
            if (panel) {
              var open = panel.classList.toggle('open');
              notifBtn.setAttribute('aria-expanded', open);
              // Close user dropdown and lang menu if open
              var dd = $('nav-user-dropdown');
              var ab = $('nav-avatar-toggle');
              if (dd) dd.classList.remove('open');
              if (ab) ab.setAttribute('aria-expanded', 'false');
              var lm = $('lang-menu');
              var lb = $('lang-btn');
              if (lm) lm.classList.remove('open');
              if (lb) lb.setAttribute('aria-expanded', 'false');
            }
            return;
          }

          // 4. User Avatar Dropdown Toggle
          var avatarBtn = e.target.closest('#nav-avatar-toggle');
          if (avatarBtn) {
            e.stopPropagation();
            var dd = $('nav-user-dropdown');
            if (dd) {
              var open = dd.classList.toggle('open');
              avatarBtn.setAttribute('aria-expanded', open);
              // Close notification panel and lang menu if open
              var panel = $('notif-panel');
              var nb = $('notif-btn');
              if (panel) panel.classList.remove('open');
              if (nb) nb.setAttribute('aria-expanded', 'false');
              var lm = $('lang-menu');
              var lb = $('lang-btn');
              if (lm) lm.classList.remove('open');
              if (lb) lb.setAttribute('aria-expanded', 'false');
            }
            return;
          }

          // 5. Click Outside to Close Panels
          var insideLang = e.target.closest('#lang-menu') || e.target.closest('#lang-btn');
          var insideDropdown = e.target.closest('#nav-user-dropdown') || e.target.closest('#nav-user-menu');
          var insideNotif = e.target.closest('#notif-panel') || e.target.closest('#notif-btn');
          var insideMobile = e.target.closest('#nav-mobile-menu') || e.target.closest('#nav-toggle');

          if (!insideLang) {
            var lm = $('lang-menu');
            var lb = $('lang-btn');
            if (lm && lm.classList.contains('open')) {
              lm.classList.remove('open');
              if (lb) lb.setAttribute('aria-expanded', 'false');
            }
          }
          if (!insideDropdown) {
            var dd = $('nav-user-dropdown');
            var ab = $('nav-avatar-toggle');
            if (dd && dd.classList.contains('open')) {
              dd.classList.remove('open');
              if (ab) ab.setAttribute('aria-expanded', 'false');
            }
          }
          if (!insideNotif) {
            var panel = $('notif-panel');
            var nb = $('notif-btn');
            if (panel && panel.classList.contains('open')) {
              panel.classList.remove('open');
              if (nb) nb.setAttribute('aria-expanded', 'false');
            }
          }
          if (!insideMobile) {
            var mm = $('nav-mobile-menu');
            var hb = $('nav-toggle');
            if (mm && mm.classList.contains('open')) {
              mm.classList.remove('open');
              mm.setAttribute('aria-hidden', 'true');
              if (hb) hb.setAttribute('aria-expanded', 'false');
            }
          }
        });

        /* ── Flash auto-dismiss ── */
        function initFlashMessages() {
          document.querySelectorAll('.flash-message').forEach(function(flash) {
            if (flash.dataset.initialized) return;
            flash.dataset.initialized = 'true';
            var timer = setTimeout(function() { dismissFlash(flash); }, 3500);
            var btn = flash.querySelector('.flash-close');
            if (btn) btn.addEventListener('click', function(e) {
              e.stopPropagation();
              clearTimeout(timer);
              dismissFlash(flash);
            });
          });
        }

        function dismissFlash(el) {
          el.classList.add('fade-out');
          var removed = false;
          function removeEl() {
            if (!removed) {
              removed = true;
              if (el.parentNode) el.parentNode.removeChild(el);
            }
          }
          el.addEventListener('transitionend', removeEl);
          setTimeout(removeEl, 400);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initFlashMessages);
        } else {
          initFlashMessages();
        }

        /* ── Boot on every Turbo page load ── */
        document.addEventListener('turbo:load', function() {
          if (typeof lucide !== 'undefined') {
            try {
              lucide.createIcons();
            } catch (e) {
              console.error("Lucide icons failed:", e);
            }
          }
          try { initFlashMessages(); } catch (e) { console.error(e); }
        });

      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link"><%= t('common.skip_link') %></a>
    <% unless devise_controller? && !user_signed_in? %>
      <%= render "layouts/navbar" %>
    <% end %>
    <main id="main-content">
      <% if flash[:notice] || flash[:alert] %>
        <div class="flash-portal" aria-live="polite" role="status">
          <% if flash[:notice].present? && !flash[:notice].to_s.include?("translation_missing") %>
            <div class="flash-message flash-notice">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span><%= flash[:notice] %></span>
              <button type="button" class="flash-close" aria-label="<%= t('common.dismiss_alert', default: 'Dismiss alert') %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
              </button>
            </div>
          <% end %>
          <% if flash[:alert].present? && !flash[:alert].to_s.include?("translation_missing") %>
            <div class="flash-message flash-alert">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <span><%= flash[:alert] %></span>
              <button type="button" class="flash-close" aria-label="<%= t('common.dismiss_alert', default: 'Dismiss alert') %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
              </button>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
