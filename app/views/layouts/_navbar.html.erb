<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="navbar-inner">

    <%# ─── Logo ─────────────────────────── %>
    <div class="navbar-left">
      <%= link_to root_path, class: "logo-link", aria: { label: t('nav.home') } do %>
        <%= render "layouts/navbar_brand" %>
      <% end %>
    </div>

    <%# ─── Desktop Segmented Pill Navigation ─────────── %>
    <div class="navbar-center">
      <div class="nav-pill-container" id="nav-links">
        <%= link_to offers_path,
              class: "nav-link #{'nav-link-active' if request.path.start_with?(offers_path)}",
              aria: { current: (request.path.start_with?(offers_path) ? "page" : nil) } do %>
          <svg class="nav-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
          </svg>
          <span><%= t('nav.browse_offers') %></span>
        <% end %>

        <%= link_to dashboard_path,
              class: "nav-link #{'nav-link-active' if current_page?(dashboard_path)}",
              aria: { current: (current_page?(dashboard_path) ? "page" : nil) } do %>
          <svg class="nav-link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="14" rx="1"/>
          </svg>
          <span><%= t('nav.dashboard') %></span>
        <% end %>
      </div>
    </div>

    <%# ─── Right Cluster ─────────────────── %>
    <div class="navbar-right" id="nav-menu">

      <%# Company CTA %>
      <% if current_user.profileable_type == "CompanyProfile" %>
        <%= link_to new_offer_path, class: "nav-cta-btn" do %>
          <svg class="nav-cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="M12 5v14"/>
          </svg>
          <span><%= t('nav.post_offer') %></span>
        <% end %>
      <% end %>

      <%# Theme Mode Switcher (Dark/Light) %>
      <button class="theme-toggle-btn" id="theme-toggle-btn" title="Toggle Light/Dark Theme" aria-label="Toggle theme">
        <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>

      <%# Locale Switcher (FR/EN/AR) %>
      <%= render "layouts/locale_switcher" %>

      <%# Notification bell %>
      <%= render "layouts/notification_bell" %>

      <%# User Avatar + Dropdown %>
      <div class="nav-user-menu" id="nav-user-menu">
        <button class="nav-avatar-btn" id="nav-avatar-toggle"
                aria-label="User menu"
                aria-expanded="false"
                aria-haspopup="true">
          <span class="nav-avatar-circle">
            <%= current_user.email[0].upcase %>
          </span>
          <span class="nav-avatar-name">
            <% prof = current_user.profileable %>
            <%= (prof.respond_to?(:first_name) && prof.first_name.present?) ? prof.first_name : ((prof.respond_to?(:name) && prof.name.present?) ? prof.name : current_user.email.split('@').first) %>
          </span>
          <svg class="nav-avatar-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <div class="nav-user-dropdown" id="nav-user-dropdown" role="menu">
          <% role_label = case current_user.profileable_type
                          when "StudentProfile" then t('nav.student')
                          when "CompanyProfile" then t('nav.company')
                          when "UniversityProfile" then t('nav.university')
                          else t('nav.user')
                          end %>

          <div class="nav-dropdown-profile">
            <div class="nav-dropdown-avatar">
              <%= current_user.email[0].upcase %>
            </div>
            <div class="nav-dropdown-info">
              <span class="nav-dropdown-email" title="<%= current_user.email %>"><%= current_user.email %></span>
              <span class="nav-dropdown-role-badge"><%= role_label %></span>
            </div>
          </div>

          <div class="nav-dropdown-divider"></div>

          <% if current_user.admin? %>
            <%= link_to admin_dashboard_path, class: "nav-dropdown-item nav-admin-link", role: "menuitem" do %>
              <svg class="nav-dropdown-icon text-indigo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span><%= t('admin.dashboard.title', default: 'Admin Panel') %></span>
            <% end %>
          <% end %>

          <%= link_to dashboard_path, class: "nav-dropdown-item", role: "menuitem" do %>
            <svg class="nav-dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="9" x="3" y="3" rx="1"/>
              <rect width="7" height="5" x="14" y="3" rx="1"/>
              <rect width="7" height="9" x="14" y="12" rx="1"/>
              <rect width="7" height="5" x="3" y="14" rx="1"/>
            </svg>
            <span><%= t('nav.my_dashboard') %></span>
          <% end %>

          <%= link_to offers_path, class: "nav-dropdown-item", role: "menuitem" do %>
            <svg class="nav-dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
            </svg>
            <span><%= t('nav.browse_offers') %></span>
          <% end %>

          <div class="nav-dropdown-divider"></div>

          <%= button_to destroy_user_session_path,
                method: :delete,
                class: "nav-dropdown-item nav-dropdown-signout",
                role: "menuitem",
                form: { "data-turbo": false } do %>
            <svg class="nav-dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
            <span><%= t('nav.sign_out') %></span>
          <% end %>
        </div>
      </div>

      <%# Hamburger (mobile) %>
      <button class="navbar-hamburger" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>

    </div>
  </div>

  <%# ─── Mobile Slide-Down Menu ─────────── %>
  <div class="navbar-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
    <%= link_to offers_path, class: "mobile-nav-link #{'mobile-nav-link-active' if request.path.start_with?(offers_path)}" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
      <span><%= t('nav.browse_offers') %></span>
    <% end %>

    <%= link_to dashboard_path, class: "mobile-nav-link #{'mobile-nav-link-active' if current_page?(dashboard_path)}" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="14" rx="1"/></svg>
      <span><%= t('nav.my_dashboard') %></span>
    <% end %>

    <% if current_user.profileable_type == "CompanyProfile" %>
      <%= link_to new_offer_path, class: "mobile-nav-link mobile-nav-cta" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        <span><%= t('nav.post_offer') %></span>
      <% end %>
    <% end %>

    <div class="mobile-nav-divider"></div>

    <div class="mobile-nav-user-info">
      <span class="mobile-nav-email"><%= current_user.email %></span>
    </div>

    <%= button_to destroy_user_session_path,
          method: :delete,
          class: "mobile-nav-signout",
          form: { "data-turbo": false } do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
      <span><%= t('nav.sign_out') %></span>
    <% end %>
  </div>
</nav>
