<nav class="navbar" role="navigation" aria-label="Main navigation">
  <div class="navbar-inner">

    <%# ─── Logo ─────────────────────────── %>
    <div class="navbar-left">
      <%= link_to root_path, class: "logo-link", aria: { label: "StageUp Home" } do %>
        <%= render "layouts/navbar_brand" %>
      <% end %>
    </div>

    <%# ─── Desktop centre links ─────────── %>
    <div class="navbar-links" id="nav-links">
      <%= link_to offers_path,
            class: "nav-link #{'nav-link-active' if request.path.start_with?(offers_path)}",
            aria: { current: (request.path.start_with?(offers_path) ? "page" : nil) } do %>
        <i data-lucide="compass" class="nav-link-icon"></i>
        Browse Offers
      <% end %>
      <%= link_to dashboard_path,
            class: "nav-link #{'nav-link-active' if current_page?(dashboard_path)}",
            aria: { current: (current_page?(dashboard_path) ? "page" : nil) } do %>
        <i data-lucide="layout-dashboard" class="nav-link-icon"></i>
        Dashboard
      <% end %>
    </div>

    <%# ─── Right cluster ─────────────────── %>
    <div class="navbar-right" id="nav-menu">

      <%# Company CTA %>
      <% if current_user.profileable_type == "CompanyProfile" %>
        <%= link_to new_offer_path, class: "nav-cta-btn" do %>
          <i data-lucide="plus" class="nav-cta-icon"></i>
          Post an Offer
        <% end %>
      <% end %>

      <%# Notification bell %>
      <%= render "layouts/notification_bell" %>

      <%# User avatar + dropdown %>
      <div class="nav-user-menu" id="nav-user-menu">
        <button class="nav-avatar-btn" id="nav-avatar-toggle"
                aria-label="User menu"
                aria-expanded="false"
                aria-haspopup="true">
          <span class="nav-avatar-ring">
            <span class="nav-avatar-initial"><%= current_user.email[0].upcase %></span>
          </span>
          <i data-lucide="chevron-down" class="nav-avatar-chevron"></i>
        </button>

        <div class="nav-user-dropdown" id="nav-user-dropdown" role="menu">
          <div class="nav-dropdown-header">
            <span class="nav-dropdown-email"><%= current_user.email %></span>
            <span class="nav-dropdown-role">
              <% role_label = case current_user.profileable_type
                              when "StudentProfile" then "Student"
                              when "CompanyProfile" then "Company"
                              when "UniversityProfile" then "University"
                              else "User"
                              end %>
              <%= role_label %>
            </span>
          </div>
          <div class="nav-dropdown-divider"></div>
          <%= link_to dashboard_path, class: "nav-dropdown-item", role: "menuitem" do %>
            <i data-lucide="layout-dashboard" class="nav-dropdown-icon"></i>
            My Dashboard
          <% end %>
          <%= link_to offers_path, class: "nav-dropdown-item", role: "menuitem" do %>
            <i data-lucide="compass" class="nav-dropdown-icon"></i>
            Browse Offers
          <% end %>
          <div class="nav-dropdown-divider"></div>
          <%= button_to destroy_user_session_path,
                method: :delete,
                class: "nav-dropdown-item nav-dropdown-signout",
                role: "menuitem",
                form: { "data-turbo": false } do %>
            <i data-lucide="log-out" class="nav-dropdown-icon"></i>
            Sign Out
          <% end %>
        </div>
      </div>

      <%# Hamburger (mobile) %>
      <button class="navbar-hamburger" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>

    </div>
  </div>

  <%# ─── Mobile slide-down menu ─────────── %>
  <div class="navbar-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
    <%= link_to "Browse Offers", offers_path,
          class: "mobile-nav-link #{'mobile-nav-link-active' if request.path.start_with?(offers_path)}" %>
    <%= link_to "My Dashboard", dashboard_path,
          class: "mobile-nav-link #{'mobile-nav-link-active' if current_page?(dashboard_path)}" %>
    <% if current_user.profileable_type == "CompanyProfile" %>
      <%= link_to "Post an Offer", new_offer_path, class: "mobile-nav-link mobile-nav-cta" %>
    <% end %>
    <div class="mobile-nav-divider"></div>
    <span class="mobile-nav-user-email"><%= current_user.email %></span>
    <%= button_to destroy_user_session_path,
          method: :delete,
          class: "mobile-nav-signout",
          form: { "data-turbo": false } do %>
      <i data-lucide="log-out" class="nav-dropdown-icon"></i>
      Sign Out
    <% end %>
  </div>
</nav>
