<div class="logo-lockup">
  <%# StageUp Logo: Dark squircle — diagonal ladder + orange verified badge %>
  <svg width="38" height="38" viewBox="0 0 100 100" class="flex-shrink-0" role="img" aria-label="StageUp Logo" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="su-sq-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1C1412"/>
        <stop offset="100%" stop-color="#0A0A0A"/>
      </linearGradient>
      <linearGradient id="su-badge-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FB923C"/>
        <stop offset="100%" stop-color="#EA580C"/>
      </linearGradient>
    </defs>

    <%# Squircle container with soft warm dark bg %>
    <rect width="100" height="100" rx="26" fill="url(#su-sq-grad)"/>
    <rect width="98" height="98" x="1" y="1" rx="25" fill="none" stroke="rgba(249,115,22,0.15)" stroke-width="1.5"/>

    <%# Diagonal ladder: two rails + three rungs %>
    <%# Left rail %>
    <line x1="24" y1="78" x2="38" y2="18" stroke="white" stroke-width="8" stroke-linecap="round"/>
    <%# Right rail %>
    <line x1="62" y1="78" x2="76" y2="18" stroke="white" stroke-width="8" stroke-linecap="round"/>
    <%# Rung 1 - bottom %>
    <line x1="27" y1="68" x2="65" y2="68" stroke="white" stroke-width="7" stroke-linecap="round"/>
    <%# Rung 2 - middle %>
    <line x1="32" y1="48" x2="70" y2="48" stroke="white" stroke-width="7" stroke-linecap="round"/>
    <%# Rung 3 - top %>
    <line x1="38" y1="28" x2="76" y2="28" stroke="white" stroke-width="7" stroke-linecap="round"/>

    <%# Verified badge — orange circle with white checkmark, top-right corner %>
    <circle cx="76" cy="26" r="16" fill="url(#su-badge-grad)"/>
    <circle cx="76" cy="26" r="16" fill="none" stroke="#0A0A0A" stroke-width="2.5"/>
    <polyline points="68,26 73,32 84,19" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>

  <span class="logo-lockup-text">Stage<span class="logo-up-accent">Up</span></span>
</div>
