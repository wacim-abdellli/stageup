<div class="admin-subnav-bar">
  <div class="admin-subnav-items">
    <%= link_to admin_dashboard_path, class: "admin-subnav-item #{'active' if current_page?(admin_dashboard_path)}" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
      <span><%= t('admin.subnav.overview', default: 'Overview') %></span>
    <% end %>

    <%= link_to admin_users_path, class: "admin-subnav-item #{'active' if controller_name == 'users'}" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span><%= t('admin.subnav.users', default: 'Users') %></span>
    <% end %>

    <%= link_to admin_offers_path, class: "admin-subnav-item #{'active' if controller_name == 'offers'}" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      <span><%= t('admin.subnav.offers', default: 'Offers') %></span>
    <% end %>

    <%= link_to admin_university_profiles_path, class: "admin-subnav-item #{'active' if controller_name == 'university_profiles'}" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v8h4"/><path d="M18 9h2a2 2 0 0 1 2 2v11h-4"/></svg>
      <span><%= t('admin.subnav.coordinators', default: 'Coordinators') %></span>
    <% end %>

    <%= link_to admin_company_profiles_path, class: "admin-subnav-item #{'active' if controller_name == 'company_profiles'}" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      <span><%= t('admin.subnav.companies', default: 'Companies') %></span>
    <% end %>

    <%= link_to admin_agreements_path, class: "admin-subnav-item #{'active' if controller_name == 'agreements'}" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
      <span><%= t('admin.subnav.agreements', default: 'Agreements') %></span>
    <% end %>
  </div>
</div>
