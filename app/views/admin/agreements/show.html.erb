<% content_for :title, "Agreement ##{@agreement.id} – StageUp Admin" %>

<div class="dashboard-container">
  <div class="dashboard-header">
    <div class="dashboard-header-left">
      <h1 class="fs-22 fw-700">Internship Agreement #<%= @agreement.id %></h1>
      <p class="header-meta">Verification Token: <code class="font-mono"><%= @agreement.verification_token %></code></p>
    </div>
    <div class="flex-row gap-10 align-center">
      <%= link_to t('common.back', default: 'Back'), admin_agreements_path, class: "btn btn-secondary btn-header" %>
    </div>
  </div>

  <%= render "admin/subnav" %>

  <div class="profile-card">
    <div class="flex-row justify-between align-center border-bottom pb-16 mb-20">
      <div>
        <h2 class="fs-18 fw-700 m-0"><%= @agreement.submission.offer.title %></h2>
        <span class="text-muted fs-13"><%= @agreement.submission.offer.company_profile.name %> &middot; <%= @agreement.submission.student_profile.full_name %></span>
      </div>
      <span class="badge badge-<%= @agreement.status %>"><%= @agreement.status.humanize %></span>
    </div>

    <div class="grid-2-cols gap-24">
      <div>
        <h3 class="fs-14 fw-700 text-muted uppercase mb-12">Agreement Metadata</h3>
        <ul class="meta-details-list">
          <li><strong>Start Date:</strong> <%= @agreement.start_date.strftime("%B %d, %Y") %></li>
          <li><strong>End Date:</strong> <%= @agreement.end_date.strftime("%B %d, %Y") %></li>
          <li><strong>Status:</strong> <%= @agreement.status.humanize %></li>
          <li><strong>Verification URL:</strong> <%= link_to verify_certificate_url(token: @agreement.verification_token), verify_certificate_url(token: @agreement.verification_token), target: "_blank", class: "btn-link-sm" if @agreement.verification_token.present? %></li>
        </ul>
      </div>

      <div>
        <h3 class="fs-14 fw-700 text-muted uppercase mb-12">Signatures Log</h3>
        <ul class="meta-details-list">
          <li><strong>Student Signature:</strong> <%= @agreement.student_signed_at ? @agreement.student_signed_at.strftime("%B %d, %Y %H:%M") : "Pending" %></li>
          <li><strong>Company Signature:</strong> <%= @agreement.company_signed_at ? @agreement.company_signed_at.strftime("%B %d, %Y %H:%M") : "Pending" %></li>
          <li><strong>University Signature:</strong> <%= @agreement.university_signed_at ? @agreement.university_signed_at.strftime("%B %d, %Y %H:%M") : "Pending" %></li>
        </ul>
      </div>
    </div>
  </div>
</div>
